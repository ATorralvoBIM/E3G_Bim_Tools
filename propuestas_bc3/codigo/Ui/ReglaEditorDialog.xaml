<Window x:Class="E3G.Saneamiento.Presupuesto.Ui.ReglaEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar regla"
        Height="540" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#ECF0F3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="NeuTextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E8ECF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="NeuComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FFFFFF" CornerRadius="14" Padding="22,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Editar regla"
                           FontSize="16" FontWeight="SemiBold" Foreground="#1F2A37"/>
                <TextBlock x:Name="LblSubtitulo"
                           Text="Sanejament — Fecals"
                           FontSize="11" Foreground="#94A3B8"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNombre"
                         Style="{StaticResource NeuTextBox}"
                         Margin="0,0,0,14"/>

                <TextBlock Text="Sub-filtre" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbSubFiltro"
                          Style="{StaticResource NeuComboBox}"
                          SelectionChanged="CmbSubFiltro_SelectionChanged"
                          Margin="0,0,0,14">
                    <ComboBoxItem Content="Tots els elements" Tag="ninguno"/>
                    <ComboBoxItem Content="Rang de diàmetre"  Tag="rangoDiametro" IsSelected="True"/>
                    <ComboBoxItem Content="Valor de paràmetre" Tag="parametro"/>
                </ComboBox>

                <Grid x:Name="PnlRangoDiametro" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Diàmetre mín. (mm)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Diàmetre màx. (mm)" Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="0" x:Name="TxtDiamMin"
                               Style="{StaticResource NeuTextBox}" FontFamily="Consolas"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" x:Name="TxtDiamMax"
                               Style="{StaticResource NeuTextBox}" FontFamily="Consolas"/>
                </Grid>

                <Grid x:Name="PnlParametro" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Paràmetre" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Operador"  Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Valor"     Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="0" x:Name="TxtParamNombre" Style="{StaticResource NeuTextBox}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="2" x:Name="CmbOperador"    Style="{StaticResource NeuComboBox}">
                        <ComboBoxItem Content="="     IsSelected="True"/>
                        <ComboBoxItem Content="≠"/>
                        <ComboBoxItem Content="conté"/>
                        <ComboBoxItem Content="no conté"/>
                    </ComboBox>
                    <TextBox   Grid.Row="1" Grid.Column="4" x:Name="TxtParamValor"  Style="{StaticResource NeuTextBox}"/>
                </Grid>

                <TextBlock Text="Criteri de mesurament" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbCriterio"
                          Style="{StaticResource NeuComboBox}"
                          Margin="0,0,0,14">
                    <ComboBoxItem Content="Longitud total (m)" Tag="longitudTotal" IsSelected="True"/>
                    <ComboBoxItem Content="Comptar elements (ud)" Tag="contar"/>
                </ComboBox>

                <TextBlock Text="Partida del catàleg" Style="{StaticResource FieldLabel}"/>
                <Border Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1"
                        CornerRadius="8" Padding="10,8">
                    <StackPanel>
                        <Grid x:Name="PnlPartidaSeleccionada">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="LblPartidaCodigo"
                                       Text="—"
                                       FontFamily="Consolas" FontWeight="Bold" FontSize="11"
                                       Foreground="#4A7A96" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="LblPartidaDesc"
                                       Text="(cap partida seleccionada)"
                                       FontSize="11" Foreground="#475569"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2" x:Name="LblPartidaCatalogoBorder"
                                    Background="#F1F5F9" CornerRadius="8" Padding="6,2"
                                    Margin="6,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding ElementName=LblPartidaCatalogo, Path=Visibility}">
                                <TextBlock x:Name="LblPartidaCatalogo"
                                           Text="" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Visibility="Collapsed"/>
                            </Border>
                            <TextBlock Grid.Column="3" x:Name="LblPartidaPrecio"
                                       Text="" FontWeight="SemiBold" FontSize="11"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,6,0,6"/>
                        <TextBox x:Name="TxtBuscarPartida"
                                 Padding="0" BorderThickness="0" Background="Transparent"
                                 FontSize="11"
                                 TextChanged="TxtBuscarPartida_TextChanged"/>
                        <ListBox x:Name="LstResultadosPartidas"
                                 MaxHeight="220" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LstResultadosPartidas_SelectionChanged"
                                 Visibility="Collapsed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Partida.Codigo}"
                                                   FontFamily="Consolas" FontWeight="Bold"
                                                   FontSize="11" Foreground="#4A7A96"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Partida.Descripcion}"
                                                   FontSize="11" Foreground="#475569"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="2"
                                                CornerRadius="8" Padding="5,1" Margin="6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsPrimario}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Catalogo.Etiqueta}"
                                                       FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#475569"/>
                                        </Border>
                                        <TextBlock Grid.Column="3"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:0.00} €/{1}">
                                                    <Binding Path="Partida.Precio"/>
                                                    <Binding Path="Partida.Unidad"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#E8ECF0" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel·lar"
                            Width="100" Height="32" Margin="0,0,8,0"
                            Click="BtnCancelar_Click"/>
                    <Button Content="Desar regla"
                            Width="120" Height="32"
                            Background="#4A7A96" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="BtnDesar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

</Window>
