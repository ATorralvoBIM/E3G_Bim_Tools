<Window x:Class="e3gbimtools.Calc.Views.SchematicPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls;assembly=e3gbimtools.DiTools.UI"
        Title="e3gbimtools — Esquema MEP"
        Height="780" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI" FontSize="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding"  Value="12,4"/>
            <Setter Property="Margin"   Value="4,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height"   Value="28"/>
        </Style>
        <!-- Encabezado de sección del panel izquierdo -->
        <Style x:Key="SecHdr" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <!-- Texto de ayuda pequeño -->
        <Style x:Key="HelpTxt" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="Foreground"    Value="#777"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
            <Setter Property="Margin"        Value="0,1,0,4"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Esquema MEP"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar zoom -->
            <RowDefinition Height="*"/>      <!-- Cuerpo -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar inferior -->
        </Grid.RowDefinitions>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• Toolbar superior â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Border Grid.Row="0" Background="{DynamicResource E3g.Brush.SurfaceSubtle}"
                BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="SldZoom"
                        Minimum="0.2" Maximum="4.0" Value="1.0"
                        Width="160" VerticalAlignment="Center"
                        ValueChanged="OnZoomChanged"/>
                <TextBlock x:Name="LblZoom" Text="100%"
                           Width="48" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <Button Content="Ajustar"  Click="OnFitClick"        MinWidth="70"/>
                <Button Content="1:1"      Click="OnActualSizeClick" MinWidth="50"/>
                <Separator Width="1" Background="#CCC" Margin="12,2"/>
                <TextBlock x:Name="LblStatus" VerticalAlignment="Center" Foreground="#555"/>
            </StackPanel>
        </Border>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• Cuerpo: panel izq | splitter | canvas â•â•â•â• -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"   MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- â”€â”€ Panel de configuración â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,0,1,0"
                    Background="{DynamicResource E3g.Brush.SurfaceSubtle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera fija -->
                    <Border Grid.Row="0" Background="{DynamicResource E3g.Brush.BorderSubtle}" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Configuración del esquema"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Ajusta layout y visibilidad antes de generar."
                                       FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Contenido con scroll -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,6,12,12">
                        <StackPanel>

                            <!-- â”€â”€ Escala de la vista Revit â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                            <TextBlock Text="Escala de la vista Revit"
                                       Style="{StaticResource SecHdr}"/>
                            <ComboBox x:Name="CboScale"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnScaleChanged">
                                <ComboBoxItem Content="1:50"  Tag="50"  IsSelected="True"/>
                                <ComboBoxItem Content="1:100" Tag="100"/>
                                <ComboBoxItem Content="1:200" Tag="200"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource HelpTxt}"
                                       Text="Afecta la escala de la vista de Revit al generar. El preview no cambia."/>

                            <!-- â”€â”€ Layout (mm de papel) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                            <TextBlock Text="Layout (mm de papel)"
                                       Style="{StaticResource SecHdr}"/>
                            <TextBlock Style="{StaticResource HelpTxt}"
                                       Text="Medidas sobre el papel ploteado. La escala de la vista las convierte a coordenadas Revit."/>

                            <!-- Separación entre líneas -->
                            <TextBlock Text="Separación entre líneas" FontSize="11"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldRowH"
                                        Minimum="4" Maximum="20" Value="8"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="0.5" LargeChange="2"
                                        ValueChanged="OnLayoutChanged"/>
                                <TextBlock x:Name="LblRowH" Grid.Column="1"
                                           Text="8.0 mm" FontSize="11" TextAlignment="Right"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>

                            <!-- Indentación entre columnas -->
                            <TextBlock Text="Indentación entre columnas" FontSize="11"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldColW"
                                        Minimum="15" Maximum="60" Value="25"
                                        TickFrequency="5" IsSnapToTickEnabled="False"
                                        SmallChange="1" LargeChange="5"
                                        ValueChanged="OnLayoutChanged"/>
                                <TextBlock x:Name="LblColW" Grid.Column="1"
                                           Text="25.0 mm" FontSize="11" TextAlignment="Right"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>

                            <!-- Altura de texto -->
                            <TextBlock Text="Altura de texto" FontSize="11"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SldTextH"
                                        Minimum="1.5" Maximum="5.0" Value="2.5"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        SmallChange="0.1" LargeChange="0.5"
                                        ValueChanged="OnLayoutChanged"/>
                                <TextBlock x:Name="LblTextH" Grid.Column="1"
                                           Text="2.5 mm" FontSize="11" TextAlignment="Right"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>

                            <!-- â”€â”€ Filtros de visibilidad â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                            <TextBlock Text="Visibilidad" Style="{StaticResource SecHdr}"/>
                            <TextBlock Style="{StaticResource HelpTxt}"
                                       Text="Controla qué elementos se incluyen en el esquema generado."/>

                            <CheckBox x:Name="ChkPipeLabels"
                                      Content="Etiquetas de tuberías (DN, Q, v)"
                                      IsChecked="True" Margin="0,3"
                                      Checked="OnVisibilityChanged"
                                      Unchecked="OnVisibilityChanged"/>
                            <CheckBox x:Name="ChkFitLabels"
                                      Content="Etiquetas de accesorios (TEE @N…)"
                                      IsChecked="True" Margin="0,3"
                                      Checked="OnVisibilityChanged"
                                      Unchecked="OnVisibilityChanged"/>
                            <CheckBox x:Name="ChkLegend"
                                      Content="Leyenda en la esquina"
                                      IsChecked="True" Margin="0,3"
                                      Checked="OnVisibilityChanged"
                                      Unchecked="OnVisibilityChanged"/>
                            <CheckBox x:Name="ChkCritPath"
                                      Content="Resaltar camino crítico"
                                      IsChecked="False" Margin="0,3"
                                      Checked="OnVisibilityChanged"
                                      Unchecked="OnVisibilityChanged"/>

                            <!-- â”€â”€ Acciones â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                            <Button Content="↺  Restablecer valores"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="OnResetConfigClick"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Separador redimensionable -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource E3g.Brush.BorderSubtle}"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- â”€â”€ Canvas con zoom/pan â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <ScrollViewer Grid.Column="2" x:Name="Scroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource E3g.Brush.SurfaceSubtle}"
                          PreviewMouseWheel="OnPreviewMouseWheel"
                          PreviewMouseDown="OnPreviewMouseDown"
                          PreviewMouseUp="OnPreviewMouseUp"
                          PreviewMouseMove="OnScrollMouseMove">
                <Canvas x:Name="PreviewCanvas" Width="900" Height="700"
                        Background="White">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                    </Canvas.LayoutTransform>
                </Canvas>
            </ScrollViewer>
        </Grid>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• Toolbar inferior â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Border Grid.Row="2" Background="{DynamicResource E3g.Brush.SurfaceSubtle}"
                BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="8,6">
                <Button x:Name="BtnGenerate"
                        Content="â–¶  Generar en Revit"
                        Click="OnGenerateClick"
                        MinWidth="160" FontWeight="SemiBold"
                        Background="{DynamicResource E3g.Brush.Accent}" Foreground="White"
                        BorderBrush="{DynamicResource E3g.Brush.Accent}"/>
                <Button x:Name="BtnExportDwg"
                        Content="ðŸ“¥  Generar + Exportar DWG"
                        Click="OnExportDwgClick"
                        MinWidth="200"/>
                <Button Content="Cerrar" Click="OnCloseClick" MinWidth="70"/>
            </StackPanel>
        </Border>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
