<UserControl
    x:Class="E3G.BimTools.DiTools.UI.Controls.E3gTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Fila 0: barra de titulo (44px).  Fila 1: linea de acento de marca (1px). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="1" />
        </Grid.RowDefinitions>

        <!-- ===================== BARRA DE TITULO ===================== -->
        <Border x:Name="BarBorder"
                Grid.Row="0"
                CornerRadius="9,9,0,0"
                Background="{DynamicResource E3g.Brush.TitleBar}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1.5" Opacity="0.06" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo MEP + titulo + estado de conexion -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="30" Height="28" CornerRadius="8"
                            Background="{DynamicResource E3g.Brush.Primary}"
                            VerticalAlignment="Center">
                        <TextBlock Text="MEP" Foreground="White"
                                   FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="11,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource E3g.Brush.Text}"
                               Text="{Binding Title, ElementName=Root}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource E3g.Brush.TextSoft}"
                               Text="{Binding Subtitle, ElementName=Root}" />

                    <!-- Estado de conexion -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ShowStatus, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Border Width="1" Height="18" Background="{DynamicResource E3g.Brush.Border}" Margin="14,0" />
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource E3g.Brush.Primary}" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"
                                   Text="{Binding StatusText, ElementName=Root}" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Separador + botones min / restaurar / cerrar ===== -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">

                    <Border Width="1" Height="20" Background="{DynamicResource E3g.Brush.Border}" Margin="4,0,8,0" />

                    <Button x:Name="MinButton"
                            Style="{DynamicResource E3g.Style.CaptionButton}"
                            ToolTip="Minimizar"
                            Click="OnMinimizeClick"
                            Visibility="{Binding ShowMinimize, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{DynamicResource E3g.Style.LucideGlyph}" Data="M5,12 H19" />
                        </Viewbox>
                    </Button>

                    <Button x:Name="MaxButton"
                            Style="{DynamicResource E3g.Style.CaptionButton}"
                            ToolTip="Maximizar"
                            Click="OnMaximizeRestoreClick"
                            Visibility="{Binding ShowMaximize, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <!-- Maximizar (cuadro simple) -->
                            <Viewbox x:Name="MaximizeGlyph" Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{DynamicResource E3g.Style.LucideGlyph}"
                                          Data="M6,3 H18 A3,3 0 0 1 21,6 V18 A3,3 0 0 1 18,21 H6 A3,3 0 0 1 3,18 V6 A3,3 0 0 1 6,3 Z" />
                                </Canvas>
                            </Viewbox>
                            <!-- Restaurar (dos cuadros, glifo copy) -->
                            <Viewbox x:Name="RestoreGlyph" Width="15" Height="15" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{DynamicResource E3g.Style.LucideGlyph}"
                                          Data="M8,8 H18 A2,2 0 0 1 20,10 V20 A2,2 0 0 1 18,22 H8 A2,2 0 0 1 6,20 V10 A2,2 0 0 1 8,8 Z" />
                                    <Path Style="{DynamicResource E3g.Style.LucideGlyph}"
                                          Data="M4,16 A2,2 0 0 1 2,14 V4 A2,2 0 0 1 4,2 H14 A2,2 0 0 1 16,4" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <Button x:Name="CloseButton"
                            Style="{DynamicResource E3g.Style.CaptionButton.Close}"
                            ToolTip="Cerrar"
                            Click="OnCloseClick">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Style="{DynamicResource E3g.Style.LucideGlyph}" Data="M18,6 L6,18" />
                                <Path Style="{DynamicResource E3g.Style.LucideGlyph}" Data="M6,6 L18,18" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Linea de acento de marca 1px (sutil, se desvanece en los bordes) -->
        <Border Grid.Row="1" Height="1" Background="{DynamicResource E3g.Brush.BrandAccentLine}" />
    </Grid>
</UserControl>
