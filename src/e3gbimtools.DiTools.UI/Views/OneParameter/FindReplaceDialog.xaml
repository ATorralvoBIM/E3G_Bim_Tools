<Window
    x:Class="E3G.BimTools.DiTools.UI.Views.OneParameter.FindReplaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
    Title="e3gbimtools — Buscar y reemplazar"
    Width="420" Height="240"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Buscar y reemplazar"
                                  ShowStatus="False"
                                  ShowMinimize="False"
                                  ShowMaximize="False" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Buscar -->
        <DockPanel Grid.Row="0">
            <TextBlock Text="Buscar:"  Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="FindBox"  Height="26"/>
        </DockPanel>

        <!-- Reemplazar -->
        <DockPanel Grid.Row="2">
            <TextBlock Text="Reemplazar:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="ReplaceBox" Height="26"/>
        </DockPanel>

        <!-- Opciones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <CheckBox x:Name="MatchCaseCheck" Content="Distinguir mayusculas/minusculas"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancel"/>
            <Button Content="Reemplazar todo" Width="120"
                    Background="{DynamicResource E3g.Brush.Accent}" Foreground="White"
                    BorderBrush="{DynamicResource E3g.Brush.Primary}" FontWeight="SemiBold"
                    IsDefault="True" Click="OnReplace"/>
        </StackPanel>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
