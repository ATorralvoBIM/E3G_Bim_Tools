<Window
    x:Class="E3G.BimTools.DiTools.UI.Views.OneParameter.OneParameterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
    Title="e3gbimtools — OneParameter"
    Width="1200" Height="760"
    MinWidth="950" MinHeight="540"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fondo amarillo-claro para filas modificadas -->
        <Style x:Key="ModifiedRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.WarningBg}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fila preview: verde si cambia -->
        <Style x:Key="PreviewRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WillChange}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.SuccessBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Boton primario -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="{DynamicResource E3g.Brush.Accent}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource E3g.Brush.Primary}"/>
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="Margin"       Value="3,0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.Primary}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.TextSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.TextSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boton secundario -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource E3g.Brush.SurfaceSubtle}"/>
            <Setter Property="Foreground"  Value="{DynamicResource E3g.Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.BorderSubtle}"/>
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="Margin"      Value="3,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.BorderSubtle}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boton aplicar (verde) -->
        <Style x:Key="ApplyBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background"  Value="{DynamicResource E3g.Brush.Secondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.SuccessText}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.SuccessText}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.TextSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.TextSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="OneParameter"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header corporativo -->
            <RowDefinition Height="Auto"/> <!-- Barra de busqueda -->
            <RowDefinition Height="*"/>    <!-- TabControl principal -->
            <RowDefinition Height="Auto"/> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             HEADER CORPORATIVO
             ============================================================ -->
        <Border Grid.Row="0" Background="{DynamicResource E3g.Brush.Accent}" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OneParameter" Foreground="{DynamicResource E3g.Brush.TextOnPrimary}"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" — Buscar, ver, editar y transformar parametros en el modelo"
                           Foreground="{DynamicResource E3g.Brush.OnBrandMuted}" FontSize="12" VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================================================
             BARRA DE BUSQUEDA (compartida por todas las pestanas)
             ============================================================ -->
        <Border Grid.Row="1" Background="{DynamicResource E3g.Brush.SurfaceSubtle}" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Parametro -->
                <TextBlock Text="Parametro:" VerticalAlignment="Center"
                           Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="ParamNameCombo"
                          IsEditable="True" Width="270" Margin="0,0,10,0"
                          ToolTip="Escribe o selecciona el nombre del parametro a buscar"
                          KeyDown="OnParamComboKeyDown"/>

                <!-- Scope -->
                <TextBlock Text="Scope:" VerticalAlignment="Center"
                           Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="ScopeCombo" Width="160" Margin="0,0,10,0"
                          ToolTip="Conjunto de elementos sobre el que se busca y opera">
                    <ComboBoxItem Content="Todo el modelo"       Tag="AllModel"         IsSelected="True"/>
                    <ComboBoxItem Content="Vista actual"          Tag="CurrentView"/>
                    <ComboBoxItem Content="Seleccion actual"      Tag="CurrentSelection"/>
                </ComboBox>

                <!-- Categorias -->
                <TextBlock Text="Categorias:" VerticalAlignment="Center"
                           Margin="0,0,5,0" FontWeight="SemiBold"/>
                <Grid Margin="0,0,10,0">
                    <ToggleButton x:Name="CatFilterToggle"
                                  Width="190" Height="24"
                                  Content="{Binding ElementName=CatFilterToggle, Path=Tag,
                                            FallbackValue='Todas las categorias'}"
                                  Tag="Todas las categorias"/>
                    <Popup x:Name="CatPopup"
                           PlacementTarget="{Binding ElementName=CatFilterToggle}"
                           Placement="Bottom"
                           IsOpen="{Binding ElementName=CatFilterToggle, Path=IsChecked, Mode=TwoWay}"
                           StaysOpen="False"
                           Width="260" MaxHeight="320">
                        <Border Background="White" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                                BorderThickness="1" Padding="4">
                            <StackPanel>
                                <Grid Margin="2,2,2,4">
                                    <TextBox x:Name="CatSearchBox" TextChanged="OnCatSearch"/>
                                    <TextBlock Text="Buscar categoria..."
                                               IsHitTestVisible="False" Foreground="{DynamicResource E3g.Brush.TextSoft}"
                                               Margin="4,2,0,0" VerticalAlignment="Center"
                                               FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CatSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Content="Marcar todas / Desmarcar todas"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="2,0,2,4" Click="OnToggleAllCategories"/>
                                <ListBox x:Name="CatListBox" MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Checked="OnCatCheckedChanged"
                                                      Unchecked="OnCatCheckedChanged"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <CheckBox x:Name="IncludeTypesCheck"
                          Content="Incluir tipos" VerticalAlignment="Center"
                          Margin="0,0,10,0"/>

                <Button Content="Buscar" Style="{StaticResource PrimaryBtn}"
                        Width="80" Click="OnSearch"
                        ToolTip="Buscar todos los elementos que tienen este parametro (Intro)"/>
                <Button Content="Limpiar" Style="{StaticResource SecondaryBtn}"
                        Width="70" Click="OnClearSearch"/>
            </WrapPanel>
        </Border>

        <!-- ============================================================
             TAB CONTROL PRINCIPAL
             ============================================================ -->
        <TabControl Grid.Row="2" x:Name="MainTabControl">

            <!-- TAB 1: Ver / Editar (inline) -->
            <TabItem Header="Ver / Editar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de acciones -->
                    <Border Grid.Row="0" Background="{DynamicResource E3g.Brush.Background}" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="SelectRevitBtn"
                                        Content="Seleccionar en Revit"
                                        Style="{StaticResource SecondaryBtn}"
                                        IsEnabled="False" Click="OnSelectInRevit"/>
                                <Button x:Name="BulkEditBtn"
                                        Content="Editar en lote..."
                                        Style="{StaticResource SecondaryBtn}"
                                        IsEnabled="False" Click="OnBulkEdit"/>
                                <Button x:Name="FindReplaceBtn"
                                        Content="Find &amp; Replace..."
                                        Style="{StaticResource SecondaryBtn}"
                                        IsEnabled="False" Click="OnFindReplace"/>
                                <Button x:Name="ExportCsvBtn"
                                        Content="Exportar CSV"
                                        Style="{StaticResource SecondaryBtn}"
                                        IsEnabled="False" Click="OnExportCsv"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                        HorizontalAlignment="Right">
                                <TextBlock x:Name="ModifiedText"
                                           Foreground="{DynamicResource E3g.Brush.WarningText}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Visibility="Collapsed"/>
                                <Button x:Name="ApplyEditsBtn"
                                        Content="Aplicar cambios (0)"
                                        Style="{StaticResource ApplyBtn}"
                                        IsEnabled="False" Click="OnApplyEdits"/>
                                <Button Content="Descartar cambios"
                                        Style="{StaticResource SecondaryBtn}"
                                        Click="OnDiscardEdits"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- DataGrid de resultados -->
                    <DataGrid Grid.Row="1"
                              x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource ModifiedRowStyle}"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="{DynamicResource E3g.Brush.SurfaceSubtle}"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              HeadersVisibility="Column"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              CellEditEnding="OnCellEditEnding"
                              SelectionChanged="OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"        Binding="{Binding ElementId}"  Width="80"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}"    Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Familia"   Binding="{Binding Family}"      Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tipo"      Binding="{Binding TypeName}"    Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre"    Binding="{Binding ElementName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nivel"     Binding="{Binding Level}"       Width="90"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Valor"
                                                Binding="{Binding EditedValue, UpdateSourceTrigger=LostFocus}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Transformaciones (Prefix / Suffix / Regex / Concat) -->
            <TabItem Header="Transformaciones (Prefix / Suffix / Regex)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel izquierdo: configuracion -->
                    <Border Grid.Column="0" Background="{DynamicResource E3g.Brush.SurfaceSubtle}" Padding="14,12"
                            BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="Operacion" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="OperationCombo"
                                      SelectionChanged="OnOperationChanged"
                                      Margin="0,0,0,12">
                                <ComboBoxItem Content="Establecer valor"           Tag="SetValue"     IsSelected="True"/>
                                <ComboBoxItem Content="Prefix (anteponer texto)"   Tag="Prefix"/>
                                <ComboBoxItem Content="Suffix (posponer texto)"    Tag="Suffix"/>
                                <ComboBoxItem Content="Concat (prefix+val+suffix)" Tag="Concat"/>
                                <ComboBoxItem Content="Regex replace"              Tag="RegexReplace"/>
                            </ComboBox>

                            <!-- Campos SetValue / Prefix / Suffix / Concat -->
                            <StackPanel x:Name="SimplePanel">
                                <TextBlock x:Name="PrefixLabel" Text="Valor nuevo:"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="PrefixBox" Height="26" Margin="0,0,0,10"
                                         ToolTip="SetValue: valor completo. Prefix/Concat: texto a anteponer."/>

                                <TextBlock x:Name="SuffixLabel" Text="Sufijo:"
                                           FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="Collapsed"/>
                                <TextBox x:Name="SuffixBox" Height="26" Margin="0,0,0,10"
                                         Visibility="Collapsed"
                                         ToolTip="Texto a posponer (Suffix / Concat)."/>
                            </StackPanel>

                            <!-- Campos RegexReplace -->
                            <StackPanel x:Name="RegexPanel" Visibility="Collapsed">
                                <TextBlock Text="Patron (regex):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="PatternBox" Height="26" Margin="0,0,0,8"
                                         FontFamily="Consolas"
                                         ToolTip="Expresion regular. Ej: ^(\w+)"/>
                                <TextBlock Text="Sustitucion:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="ReplacementBox" Height="26" Margin="0,0,0,8"
                                         FontFamily="Consolas"
                                         ToolTip="Usa $1, $2... para grupos capturados."/>
                                <CheckBox x:Name="RegexMatchCaseCheck"
                                          Content="Distinguir mayusculas/minusculas"
                                          Margin="0,0,0,10"/>
                            </StackPanel>

                            <Separator Margin="0,6,0,10"/>

                            <TextBlock Text="Aplicar sobre:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <RadioButton x:Name="TransformAllRadio"
                                         Content="Todos los resultados cargados"
                                         IsChecked="True" Margin="0,0,0,4"
                                         GroupName="TransformScope"/>
                            <RadioButton x:Name="TransformSelectedRadio"
                                         Content="Solo los seleccionados en la tabla"
                                         Margin="0,0,0,14"
                                         GroupName="TransformScope"/>

                            <Button Content="Preview (Before / After)"
                                    Style="{StaticResource SecondaryBtn}"
                                    Width="220" HorizontalAlignment="Left"
                                    Margin="0,0,0,8" Click="OnTransformPreview"
                                    ToolTip="Calcula el resultado sin escribir nada en Revit"/>

                            <Button x:Name="ApplyTransformBtn"
                                    Content="Aplicar transformacion"
                                    Style="{StaticResource ApplyBtn}"
                                    Width="220" HorizontalAlignment="Left"
                                    IsEnabled="False" Click="OnApplyTransform"
                                    ToolTip="Escribe los valores en Revit (una transaccion, Ctrl-Z deshace)"/>

                            <TextBlock x:Name="TransformStatusText"
                                       TextWrapping="Wrap" Foreground="{DynamicResource E3g.Brush.TextMuted}"
                                       FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch" Background="{DynamicResource E3g.Brush.BorderSubtle}"/>

                    <!-- Panel derecho: preview Before/After -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource E3g.Brush.Background}" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1" Padding="10,6">
                            <TextBlock Text="Preview — Before / After  (verde = cambia)"
                                       FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="PreviewGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  RowStyle="{StaticResource PreviewRowStyle}"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="{DynamicResource E3g.Brush.SurfaceSubtle}"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre"    Binding="{Binding ElementName}" Width="140"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}"    Width="110"/>
                                <DataGridTextColumn Header="Nivel"     Binding="{Binding Level}"       Width="80"/>
                                <DataGridTextColumn Header="Antes"     Binding="{Binding Before}"      Width="*"/>
                                <DataGridTextColumn Header="Despues"   Binding="{Binding After}"       Width="*"/>
                                <DataGridCheckBoxColumn Header="Cambia" Binding="{Binding WillChange}" Width="65"/>
                                <DataGridTextColumn Header="Error"     Binding="{Binding Error}"       Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================================================
             STATUS BAR
             ============================================================ -->
        <Border Grid.Row="3" Background="{DynamicResource E3g.Brush.SurfaceSubtle}" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="StatusText"
                       Text="Escribe el nombre de un parametro y pulsa Buscar."
                       Foreground="{DynamicResource E3g.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
        </Border>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
