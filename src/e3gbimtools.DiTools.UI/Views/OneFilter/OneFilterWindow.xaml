<Window x:Class="E3G.BimTools.DiTools.UI.Views.OneFilter.OneFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        xmlns:local="clr-namespace:E3G.BimTools.DiTools.UI.Views.OneFilter"
        Title="e3gbimtools — OneFilter"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="OneFilter"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: barra plantillas -->
            <RowDefinition Height="*" />      <!-- 1: contenido principal -->
            <RowDefinition Height="Auto" />   <!-- 2: barra resultados -->
            <RowDefinition Height="2*" />     <!-- 3: grilla resultados -->
            <RowDefinition Height="Auto" />   <!-- 4: status + cerrar -->
        </Grid.RowDefinitions>

        <!-- 0. Barra de plantillas -->
        <Border Grid.Row="0" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource E3g.Brush.Border}" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Plantilla:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox  Grid.Column="1" x:Name="TemplatesCombo" />
                <Button    Grid.Column="2" Content="Cargar"   Margin="6,0,0,0" Padding="8,2" Click="OnLoadTemplateClick" />
                <Button    Grid.Column="3" Content="Guardar como…" Margin="6,0,0,0" Padding="8,2" Click="OnSaveTemplateClick" />
                <Button    Grid.Column="4" Content="Eliminar" Margin="6,0,0,0" Padding="8,2" Click="OnDeleteTemplateClick" />
            </Grid>
        </Border>

        <!-- 1. Contenido principal: categorias + editor de filtros -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: categorias -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource E3g.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Categorías" Style="{StaticResource SectionLabel}" />
                    <TextBox   Grid.Row="1"
                               x:Name="CategorySearchBox"
                               Margin="0,0,0,6"
                               ToolTip="Filtrar categorías por nombre"
                               TextChanged="OnCategorySearchChanged" />
                    <ListBox   Grid.Row="2"
                               x:Name="CategoriesList"
                               SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="OnCategoryToggled"
                                          Unchecked="OnCategoryToggled" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource E3g.Brush.SurfaceSubtle}" />

            <!-- Columna derecha: editor de grupos y condiciones -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource E3g.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Filtros" Style="{StaticResource SectionLabel}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <local:FilterGroupEditor x:Name="RootGroupEditor" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Barra de acciones sobre resultados -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource E3g.Brush.Border}" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="Ejecutar filtro"   Padding="14,4" FontWeight="SemiBold" Click="OnRunFilterClick" />
                <Separator Margin="10,0" />
                <Button Content="Seleccionar"       Padding="10,4" Margin="0,0,6,0" Click="OnSelectInModelClick" />
                <Button Content="Aislar en vista"   Padding="10,4" Margin="0,0,6,0" Click="OnIsolateClick" />
                <Button Content="Ocultar en vista"  Padding="10,4" Margin="0,0,6,0" Click="OnHideClick" />
                <Button Content="Override color…"   Padding="10,4" Margin="0,0,6,0" Click="OnOverrideColorClick" />
                <Button Content="Quitar overrides"  Padding="10,4" Margin="0,0,6,0" Click="OnClearOverridesClick" />
                <Separator Margin="10,0" />
                <Button Content="Editar parámetro en lote…" Padding="10,4" Margin="0,0,6,0" Click="OnBatchEditClick" />
                <Button Content="Exportar a Excel…"          Padding="10,4" Click="OnExportExcelClick" />
                <TextBlock x:Name="ResultsCountText"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontStyle="Italic"
                           Foreground="{DynamicResource E3g.Brush.TextMuted}" />
            </StackPanel>
        </Border>

        <!-- 3. Grilla de resultados -->
        <DataGrid Grid.Row="3"
                  x:Name="ResultsGrid"
                  Margin="0,8,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding ElementId}" Width="100" />
                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}"  Width="*" />
                <DataGridTextColumn Header="Familia"   Binding="{Binding Family}"    Width="*" />
                <DataGridTextColumn Header="Tipo"      Binding="{Binding Type}"      Width="*" />
                <DataGridTextColumn Header="Nombre"    Binding="{Binding Name}"      Width="*" />
                <DataGridTextColumn Header="Nivel"     Binding="{Binding LevelName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. Status + cerrar -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource E3g.Brush.TextMuted}"
                       FontStyle="Italic"
                       Text="Selecciona una o más categorías y añade condiciones, luego pulsa Ejecutar." />
            <Button Grid.Column="1"
                    Content="Cerrar"
                    Padding="20,6"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>

