<Window x:Class="E3G.BimTools.DiTools.UI.Views.OneFilter.BatchEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        Title="e3gbimtools — Editar en lote"
        Width="480" Height="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Editar en lote"
                                  ShowStatus="False"
                                  ShowMinimize="False"
                                  ShowMaximize="False" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nombre del parámetro:" Margin="0,0,0,4" />
        <TextBox   Grid.Row="1" x:Name="ParameterBox" />

        <TextBlock Grid.Row="2" Text="Nuevo valor:" Margin="0,10,0,4" />
        <TextBox   Grid.Row="3" x:Name="ValueBox" />

        <CheckBox  Grid.Row="4" x:Name="ApplyToTypeCheck" Margin="0,12,0,0"
                   Content="Aplicar al TIPO (afecta a TODAS las instancias del tipo, no solo a las filtradas)" />

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,0"
                   FontStyle="Italic"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}"
                   TextWrapping="Wrap"
                   Text="El parámetro debe ser editable y existir en los elementos. Los parámetros de solo lectura o no encontrados se cuentan como omitidos." />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aplicar" Padding="16,4" IsDefault="True" Click="OnOk" />
            <Button Content="Cancelar" Margin="8,0,0,0" Padding="16,4" IsCancel="True" />
        </StackPanel>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>

