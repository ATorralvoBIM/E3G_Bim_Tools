<UserControl x:Class="E3G.BimTools.DiTools.UI.Views.DialuxImport.DialuxImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:E3G.BimTools.DiTools.UI.Views.DialuxImport"
             x:Name="Root"
             Background="{DynamicResource E3g.Brush.Background}">

    <!-- DIALux → Revit pensado primero para el panel acoplable estrecho: secciones
         plegables con resumen en la cabecera, tarjetas en lugar de tablas anchas y
         acciones fijas abajo.  Con anchura suficiente (ventana o panel ensanchado)
         las secciones se reparten en dos columnas (DialuxImportView.AplicarDisposicion). -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Rotulo">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
        </Style>

        <!-- Seccion plegable: tarjeta con titulo, resumen (Tag) y chevron. -->
        <Style x:Key="Seccion" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource E3g.Brush.Card}"
                                BorderBrush="{DynamicResource E3g.Brush.Border}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <ToggleButton Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="10,8">
                                                <DockPanel>
                                                    <Path x:Name="Chevron" DockPanel.Dock="Right" Width="10" Height="6"
                                                          Stretch="Uniform" Data="M0,0 L5,5 L10,0" Margin="8,0,0,0"
                                                          Stroke="{DynamicResource E3g.Brush.TextMuted}" StrokeThickness="1.6"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Right" MaxWidth="160" Margin="8,0,0,0"
                                                               FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource E3g.Brush.TextMuted}"
                                                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource E3g.Brush.Text}"
                                                               Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Data" Value="M0,5 L5,0 L10,5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Cuerpo" Margin="10,0,10,10" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Cuerpo" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de lista: separador fino; seleccionada = tinte de marca. -->
        <Style x:Key="Fila" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fondo" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource E3g.Brush.BrandTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Lista" TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.BorderSubtle}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Fila}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Bloque del DWG: simbolo, nombre, tipo de Revit y altura/giro. -->
        <DataTemplate x:Key="TarjetaBloque">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="44" Height="32" Margin="0,0,8,0" VerticalAlignment="Top" BorderThickness="1"
                        BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" Background="White">
                    <local:BlockThumb Segments="{Binding Symbol}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BlockName, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Attributes, Mode=OneWay}" />
                    <TextBlock FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource E3g.Brush.TextMuted}">
                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" uds. · " /><Run Text="{Binding Layers, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <!-- Tipo y altura a todo el ancho: en el panel estrecho no caben al lado de la miniatura. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                    <ComboBox Margin="0,5,0,0" FontSize="11" IsTextSearchEnabled="True"
                              ItemsSource="{Binding DataContext.TypeOptions, ElementName=Root}"
                              SelectedItem="{Binding SelectedType, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Label" ToolTip="Familia : tipo de Revit («— ignorar —» = no se coloca)" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Altura" Style="{StaticResource Rotulo}" />
                            <ComboBox FontSize="11" ItemsSource="{Binding DataContext.HeightSources, ElementName=Root}"
                                      SelectedValue="{Binding HeightSource, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Altura (mm)" Style="{StaticResource Rotulo}" />
                            <TextBox FontSize="11" Text="{Binding HeightMm, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Giro extra (°)" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis" />
                            <TextBox FontSize="11" Text="{Binding ExtraRotationDeg, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Fila de simulacion / auditoria. -->
        <DataTemplate x:Key="TarjetaPlan">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="Insignia" DockPanel.Dock="Left" CornerRadius="4" Padding="5,0" Margin="0,0,6,0"
                            VerticalAlignment="Center" Background="{DynamicResource E3g.Brush.BrandTint}">
                        <TextBlock x:Name="InsigniaTexto" Text="{Binding StatusLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource E3g.Brush.Primary}" />
                    </Border>
                    <TextBlock Text="{Binding Block, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding TargetType, Mode=OneWay}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Coordenadas, Mode=OneWay}" FontSize="10" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource E3g.Brush.TextMuted}" />
                <TextBlock x:Name="Detalle" Text="{Binding Detail, Mode=OneWay}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource E3g.Brush.TextMuted}" FontStyle="Italic" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter TargetName="Insignia" Property="Background" Value="{DynamicResource E3g.Brush.SuccessBg}" />
                    <Setter TargetName="InsigniaTexto" Property="Foreground" Value="{DynamicResource E3g.Brush.SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter TargetName="Insignia" Property="Background" Value="{DynamicResource E3g.Brush.WarningBg}" />
                    <Setter TargetName="InsigniaTexto" Property="Foreground" Value="{DynamicResource E3g.Brush.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="error">
                    <Setter TargetName="Insignia" Property="Background" Value="{DynamicResource E3g.Brush.ErrorBg}" />
                    <Setter TargetName="InsigniaTexto" Property="Foreground" Value="{DynamicResource E3g.Brush.ErrorText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Detail}" Value="">
                    <Setter TargetName="Detalle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Desplazamiento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">

                <StackPanel x:Name="Cabecera" Margin="2,0,0,10">
                    <TextBlock Text="DIALux → Revit" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource E3g.Brush.Text}" />
                    <TextBlock Text="Coloca las luminarias de un DWG exportado de DIALux" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}" />
                </StackPanel>

                <Grid x:Name="Columnas">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColIzquierda" Width="*" />
                        <ColumnDefinition x:Name="ColDerecha" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ═══ Columna izquierda: DWG, colocacion, capas ═══ -->
                    <StackPanel x:Name="PilaIzquierda">

                        <Expander x:Name="SeccionDwg" Header="DWG de DIALux" Tag="Sin archivo" IsExpanded="True"
                                  Style="{StaticResource Seccion}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Examinar…" Margin="6,0,0,0" Padding="12,4"
                                            Click="OnBrowseClick" Style="{DynamicResource E3g.Style.Button.Primary}" />
                                    <TextBox x:Name="FileBox" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </DockPanel>
                                <TextBlock x:Name="FileInfo" Style="{StaticResource Hint}"
                                           Text="Exporta desde DIALux el plano de luminarias en DWG/DXF: cada luminaria llega como un bloque." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Cargar config…" Padding="4,3" FontSize="11" Click="OnLoadConfigClick"
                                            ToolTip="Carga un .json con unidades, origen, nivel, capas y la asociación bloque → tipo." />
                                    <Button Grid.Column="2" Content="Guardar config…" Padding="4,3" FontSize="11" Click="OnSaveConfigClick"
                                            ToolTip="Guarda la configuración actual en un .json para reutilizarla en otros proyectos." />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SeccionColocacion" Header="Colocación" Style="{StaticResource Seccion}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Nivel" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LevelCombo" Margin="0,6,0,0" FontSize="11"
                                              DisplayMemberPath="Label" SelectionChanged="OnOptionChanged" />
                                    <TextBlock Grid.Row="1" Text="Unidades DWG" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="UnitsCombo" Margin="0,6,0,0" FontSize="11"
                                              DisplayMemberPath="Label" SelectionChanged="OnOptionChanged" />
                                    <TextBlock Grid.Row="2" Text="Origen DWG" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OriginCombo" Margin="0,6,0,0" FontSize="11"
                                              DisplayMemberPath="Label" SelectionChanged="OnOptionChanged"
                                              ToolTip="Con qué punto de Revit coincide el 0,0 del DWG de DIALux." />
                                    <TextBlock Grid.Row="3" Text="Desfase X (mm)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="OffsetXBox" Margin="0,6,0,0" FontSize="11" Text="0" />
                                    <TextBlock Grid.Row="4" Text="Desfase Y (mm)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="OffsetYBox" Margin="0,6,0,0" FontSize="11" Text="0" />
                                    <TextBlock Grid.Row="5" Text="Giro DWG (°)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="RotationBox" Margin="0,6,0,0" FontSize="11" Text="0" />
                                    <TextBlock Grid.Row="6" Text="Tolerancia (mm)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="ToleranceBox" Margin="0,6,0,0" FontSize="11" Text="20"
                                             ToolTip="Una luminaria ya colocada a menos de esta distancia de su posición en el DWG se da por buena." />
                                </Grid>
                                <Button x:Name="AlignButton" Content="Alinear con la arquitectura" Margin="0,10,0,0" Padding="8,4" FontSize="11"
                                        IsEnabled="False" Click="OnAlignClick"
                                        ToolTip="Casa los pilares del DWG con los pilares de Revit (modelo y vínculos) del nivel elegido y rellena el desfase y el giro." />
                                <TextBlock x:Name="AlignInfo" Style="{StaticResource Hint}"
                                           Text="DIALux suele mover el plano a su propio origen: usa este botón para que las luminarias caigan sobre la arquitectura." />
                                <TextBlock x:Name="UnitsInfo" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SeccionCapas" Header="Capas del DWG" Style="{StaticResource Seccion}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Todas" Padding="10,2" FontSize="11" Click="OnAllLayersClick" />
                                    <Button Content="Ninguna" Padding="10,2" FontSize="11" Margin="6,0,0,0" Click="OnNoLayersClick" />
                                </StackPanel>
                                <ListBox x:Name="LayersList" MaxHeight="220" Margin="0,6,0,0" BorderThickness="1"
                                         BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="OnLayerToggled" Unchecked="OnLayerToggled">
                                                <TextBlock FontSize="11">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource E3g.Brush.TextMuted}" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource Hint}" Text="Solo se tienen en cuenta los bloques de las capas marcadas." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ═══ Columna derecha (debajo en estrecho): asociar, resultados, vista previa ═══ -->
                    <StackPanel x:Name="PilaDerecha" Grid.Row="1">

                        <Expander x:Name="SeccionAsociar" Header="Asociar bloques" IsExpanded="True" Style="{StaticResource Seccion}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Sugerir por nombre" Padding="4,3" FontSize="11" Click="OnSuggestClick"
                                            ToolTip="Asigna a los bloques sin tipo la familia/tipo cuyo nombre coincide con el del bloque o con sus atributos." />
                                    <Button Grid.Column="2" Content="Copiar a selección" Padding="4,3" FontSize="11" Click="OnAssignSelectedClick"
                                            ToolTip="Selecciona primero el bloque modelo y después, con Ctrl o Mayús, los demás: les copia su tipo, altura y giro." />
                                </Grid>
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="OnlyDialuxCheck" Margin="0,2,12,2" IsChecked="True" FontSize="11"
                                              Content="Solo luminarias DIALux" Checked="OnBlockFilterChanged" Unchecked="OnBlockFilterChanged"
                                              ToolTip="Muestra solo los bloques que DIALux exporta como luminarias (capa DLXLUM), sin la arquitectura del plano." />
                                    <CheckBox x:Name="OnlyTopLevelCheck" Margin="0,2,12,2" IsChecked="True" FontSize="11"
                                              Content="Ocultar anidados" Checked="OnBlockFilterChanged" Unchecked="OnBlockFilterChanged" />
                                    <CheckBox x:Name="AllCategoriesCheck" Margin="0,2,12,2" FontSize="11"
                                              Content="Todas las categorías" Checked="OnAllCategoriesChanged" Unchecked="OnAllCategoriesChanged"
                                              ToolTip="Por defecto solo luminarias, dispositivos de iluminación, aparatos eléctricos, modelos genéricos y equipos especializados." />
                                </WrapPanel>
                                <ListBox x:Name="MappingList" MaxHeight="440" Style="{StaticResource Lista}"
                                         ItemTemplate="{StaticResource TarjetaBloque}" />
                                <TextBlock x:Name="TypesInfo" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>

                        <!-- Simulacion y auditoria: que haria Crear y como esta el modelo respecto al DWG. -->
                        <Expander x:Name="SeccionResultados" Header="Resultados" Style="{StaticResource Seccion}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Mostrar" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="StatusFilterCombo" FontSize="11" DisplayMemberPath="Label"
                                              SelectionChanged="OnStatusFilterChanged" />
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <Button Content="Seleccionar en Revit" Padding="4,3" FontSize="11" Margin="0,0,3,0" Click="OnSelectInRevitClick"
                                            ToolTip="Selecciona en Revit las luminarias existentes de las filas marcadas (o de todas las visibles)." />
                                    <Button Content="Exportar CSV…" Padding="4,3" FontSize="11" Margin="3,0,0,0" Click="OnExportCsvClick" />
                                </UniformGrid>
                                <Button x:Name="DeleteExtraButton" Content="Borrar sobrantes" Padding="4,3" FontSize="11" Margin="0,6,0,0"
                                        Click="OnDeleteExtraClick" IsEnabled="False"
                                        ToolTip="Borra las luminarias importadas de este DWG que ya no están en él." />
                                <ListBox x:Name="PlanList" MaxHeight="440" Style="{StaticResource Lista}"
                                         ItemTemplate="{StaticResource TarjetaPlan}" />
                                <TextBlock x:Name="PlanWarnings" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SeccionPrevia" Header="Vista previa" Style="{StaticResource Seccion}">
                            <StackPanel>
                                <Border x:Name="PreviewHost" Height="260" BorderThickness="1" CornerRadius="4"
                                        BorderBrush="{DynamicResource E3g.Brush.Border}" Background="White">
                                    <local:DialuxPreview x:Name="Preview" />
                                </Border>
                                <TextBlock x:Name="PreviewLegend" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Estado y acciones: siempre a la vista. -->
        <Border Grid.Row="1" Padding="10,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource E3g.Brush.Border}" Background="{DynamicResource E3g.Brush.Card}">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource E3g.Brush.TextMuted}"
                           Text="Carga el DWG de DIALux para empezar." />
                <StackPanel x:Name="Acciones" Margin="0,8,0,0">
                    <UniformGrid Columns="2">
                        <Button x:Name="SimulateButton" Content="Simular" Padding="6,5" Margin="0,0,3,0" IsEnabled="False"
                                Click="OnSimulateClick" ToolTip="Calcula qué haría «Crear» sin tocar el modelo." />
                        <Button x:Name="AuditButton" Content="Auditar" Padding="6,5" Margin="3,0,0,0" IsEnabled="False"
                                Click="OnAuditClick"
                                ToolTip="Compara el DWG con las luminarias ya colocadas: nuevas, movidas, de tipo distinto y sobrantes." />
                    </UniformGrid>
                    <UniformGrid Columns="3" Margin="0,6,0,0">
                        <Button x:Name="SyncButton" Content="Sincronizar" Padding="4,5" Margin="0,0,3,0" IsEnabled="False"
                                Click="OnSyncClick"
                                ToolTip="Coloca las nuevas y recoloca / cambia el tipo de las movidas, sin borrar nada." />
                        <Button x:Name="RedoButton" Content="Rehacer" Padding="4,5" Margin="3,0" IsEnabled="False"
                                Click="OnRedoClick"
                                ToolTip="Borra todas las luminarias importadas de este DWG y las vuelve a colocar." />
                        <Button x:Name="CreateButton" Content="Crear" Padding="4,5" Margin="3,0,0,0" IsEnabled="False"
                                Click="OnCreateClick" Style="{DynamicResource E3g.Style.Button.Primary}"
                                ToolTip="Coloca las luminarias nuevas; no toca las que ya estén colocadas." />
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
