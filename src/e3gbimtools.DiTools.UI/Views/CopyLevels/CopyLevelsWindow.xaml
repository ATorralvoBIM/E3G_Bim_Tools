<Window x:Class="E3G.BimTools.DiTools.UI.Views.CopyLevels.CopyLevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        Title="e3gbimtools — Copiar niveles desde vínculo"
        Width="720" Height="560"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Copiar niveles"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: combo vínculos -->
            <RowDefinition Height="Auto" />   <!-- 1: barra acciones lista -->
            <RowDefinition Height="*" />      <!-- 2: DataGrid niveles -->
            <RowDefinition Height="Auto" />   <!-- 3: opciones (prefijo/sufijo/vistas) -->
            <RowDefinition Height="Auto" />   <!-- 4: info / status -->
            <RowDefinition Height="Auto" />   <!-- 5: botones aceptar / cerrar -->
        </Grid.RowDefinitions>

        <!-- 0. Selector de vínculo -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Vínculo de origen" Style="{StaticResource SectionLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="LinksCombo"
                          Grid.Column="0"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="OnLinkChanged" />
                <Button x:Name="RefreshLinksButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Content="↻ Refrescar"
                        Click="OnRefreshLinksClick" />
            </Grid>
            <TextBlock x:Name="LinksHint"
                       Margin="0,4,0,0"
                       FontStyle="Italic"
                       Foreground="{DynamicResource E3g.Brush.TextMuted}"
                       Text="Carga niveles del vínculo seleccionado." />
        </StackPanel>

        <!-- 1. Barra acciones del DataGrid -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,4">
            <TextBlock Text="Niveles disponibles"
                       Style="{StaticResource SectionLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <Button Content="Marcar todos"
                    Padding="8,2"
                    Click="OnSelectAllClick" />
            <Button Content="Desmarcar todos"
                    Margin="8,0,0,0"
                    Padding="8,2"
                    Click="OnDeselectAllClick" />
            <TextBlock x:Name="LevelsCountText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="{DynamicResource E3g.Brush.TextMuted}" />
        </StackPanel>

        <!-- 2. Lista de niveles -->
        <DataGrid x:Name="LevelsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Elevación (m)" Binding="{Binding ElevationDisplay}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusDisplay}" Width="180" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 3. Opciones -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" BorderThickness="1" BorderBrush="{DynamicResource E3g.Brush.Border}" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Opciones" Style="{StaticResource SectionLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Prefijo:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox  Grid.Column="1" x:Name="PrefixBox" />
                    <TextBlock Grid.Column="2" Text="Sufijo:"  VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox  Grid.Column="3" x:Name="SuffixBox" />
                </Grid>
                <CheckBox x:Name="CreatePlansCheck"
                          Margin="0,8,0,0"
                          Content="Crear una vista de planta arquitectónica por cada nivel copiado" />
            </StackPanel>
        </Border>

        <!-- 4. Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}"
                   FontStyle="Italic"
                   Text="Selecciona un vínculo para empezar." />

        <!-- 5. Botones -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyButton"
                    Content="Copiar niveles"
                    Padding="20,6"
                    IsDefault="True"
                    Click="OnCopyClick" />
            <Button Content="Cerrar"
                    Margin="8,0,0,0"
                    Padding="20,6"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>

