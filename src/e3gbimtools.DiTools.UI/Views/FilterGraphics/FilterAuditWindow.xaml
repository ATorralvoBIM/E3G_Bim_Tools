<Window x:Class="E3G.BimTools.DiTools.UI.Views.FilterGraphics.FilterAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="e3gbimtools — Auditoría de filtros"
        Width="1000" Height="640" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource E3g.Style.H2}" Text="Auditoría de filtros"/>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource E3g.Brush.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource E3g.Brush.TextMuted}"
                       Text="«Vistas» cuenta solo vistas que gestionan sus propios filtros; las controladas por plantilla cuentan en la plantilla. Pasa el ratón por una fila para ver dónde se usa."/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="22" HorizontalGridLinesBrush="{DynamicResource E3g.Brush.GridLine}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding UsedIn}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="2">
                            <Setter Property="Background" Value="{DynamicResource E3g.Brush.WarningBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="1">
                            <Setter Property="Background" Value="{DynamicResource E3g.Brush.SurfaceAlt}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="&#x2713;" Width="28">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" ToolTip="Marcar para eliminar (solo filtros sin usar)"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Filtro" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Categorías" Binding="{Binding Categories}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Vistas" Binding="{Binding Views}" Width="55" IsReadOnly="True"/>
                <DataGridTextColumn Header="Plantillas" Binding="{Binding Templates}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Con grafismo" Binding="{Binding WithGraphics}" Width="85" IsReadOnly="True"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="260" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Marcar sin usar" Click="OnCheckUnusedClick" Margin="0,0,8,0"
                        Style="{DynamicResource E3g.Style.Button.Secondary}"/>
                <Button Content="&#x1F5D1; Eliminar marcados sin usar" Click="OnDeleteClick" Margin="0,0,8,0"
                        Style="{DynamicResource E3g.Style.Button.Secondary}"/>
                <Button Content="&#x1F4C4; Exportar CSV" Click="OnExportCsvClick"
                        Style="{DynamicResource E3g.Style.Button.Secondary}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Cerrar" IsCancel="True"
                    Style="{DynamicResource E3g.Style.Button.Primary}"/>
        </DockPanel>
    </Grid>
</Window>
