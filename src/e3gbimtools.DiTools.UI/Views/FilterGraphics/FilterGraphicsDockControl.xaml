<UserControl x:Class="E3G.BimTools.DiTools.UI.Views.FilterGraphics.FilterGraphicsDockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource E3g.Brush.Background}"
             MinWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Margin="8">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Grafismo de filtros" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>

            <!-- Destino -->
            <Border Background="{DynamicResource E3g.Brush.SurfaceAlt}" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                <TextBlock Text="{Binding TargetLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{DynamicResource E3g.Brush.WarningBg}" CornerRadius="4" Padding="6,4" Margin="0,0,0,6"
                    Visibility="{Binding HasTargetWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding TargetWarning}" Foreground="{DynamicResource E3g.Brush.WarningText}"
                           FontSize="10" TextWrapping="Wrap"/>
            </Border>

            <!-- Presets (biblioteca + locales) -->
            <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,2"/>
            <DockPanel Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" Content="&#x2699;" Click="OnLibraryClick" Margin="4,0,0,0"
                        ToolTip="Elegir carpeta de biblioteca compartida (p. ej. en red)"/>
                <Button DockPanel.Dock="Right" Content="Aplicar…" Click="OnApplyPresetClick" Margin="4,0,0,0"
                        ToolTip="Abre la importación con el preset seleccionado"/>
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Display" ToolTip="{Binding SelectedPreset.Path}"/>
            </DockPanel>
            <TextBlock Text="{Binding LibraryLabel}" Foreground="{DynamicResource E3g.Brush.TextMuted}"
                       FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <!-- Acciones -->
            <WrapPanel Margin="0,0,0,4">
                <Button Content="&#x2B07; Exportar…" Click="OnExportClick" Margin="0,0,4,4"
                        ToolTip="Guarda grafismo y reglas de los filtros marcados (o todos si no hay ninguno marcado)."/>
                <Button Content="&#x2B06; Importar archivo…" Click="OnImportClick" Margin="0,0,4,4"
                        ToolTip="Elige un JSON y aplícalo a una o varias vistas/plantillas con vista previa."/>
                <Button Content="&#x1F50D; Auditoría" Click="OnAuditClick" Margin="0,0,4,4"
                        ToolTip="Filtros sin usar, sin grafismo o desactivados en todo el proyecto."/>
                <Button Content="&#x21BB;" Click="OnRefreshClick" Margin="0,0,4,4" ToolTip="Refrescar"/>
                <Button Content="&#x1F4C1;" Click="OnOpenFolderClick" Margin="0,0,0,4" ToolTip="Abrir carpeta de presets locales"/>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Marcar:" Foreground="{DynamicResource E3g.Brush.TextMuted}" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock FontSize="10" Margin="0,0,8,0"><Hyperlink Click="OnCheckAllClick">todos</Hyperlink></TextBlock>
                <TextBlock FontSize="10" Margin="0,0,8,0"><Hyperlink Click="OnCheckNoneClick">ninguno</Hyperlink></TextBlock>
                <TextBlock FontSize="10" Foreground="{DynamicResource E3g.Brush.TextMuted}"
                           Text="· clic en línea/patrón = color · clic derecho = más opciones"/>
            </WrapPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}" FontSize="10"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <!-- Tabla de filtros (resumen Proyección/Superficie del cuadro V/G) -->
        <DataGrid x:Name="FiltersGrid" ItemsSource="{Binding Filters}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" RowHeight="22"
                  HorizontalGridLinesBrush="{DynamicResource E3g.Brush.GridLine}"
                  ContextMenuOpening="OnGridContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu/>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="&#x2713;" Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" ToolTip="Marcar para exportar / copiar grafismo"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Act." Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" ToolTip="Activar filtro"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Vis." Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" ToolTip="Visibilidad"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Líneas" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" Cursor="Hand" Margin="3,0"
                                  ToolTip="{Binding LineTooltip}" MouseLeftButtonUp="OnLineCellClick">
                                <Line X1="0" Y1="0" X2="60" Y2="0" VerticalAlignment="Center"
                                      Stroke="{Binding LineBrush}" StrokeThickness="{Binding LineThickness}">
                                    <Line.Style>
                                        <Style TargetType="Line">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LineDashed}" Value="True">
                                                    <Setter Property="StrokeDashArray" Value="4 2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Line.Style>
                                </Line>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Patrón" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding PatternBrush}" Margin="3,2" Cursor="Hand"
                                    BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="1"
                                    ToolTip="{Binding PatternTooltip}" MouseLeftButtonUp="OnPatternCellClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Transp." Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TransparencyText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
