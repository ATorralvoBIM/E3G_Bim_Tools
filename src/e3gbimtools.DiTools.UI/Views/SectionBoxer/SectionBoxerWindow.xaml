<Window x:Class="E3G.BimTools.DiTools.UI.Views.SectionBoxer.SectionBoxerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        Title="e3gbimtools — SectionBoxer"
        Width="640" Height="540"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="SectionBoxer"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Origen -->
        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Origen" />
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,8">
            <RadioButton x:Name="SourceSelection" GroupName="Source" Content="Elementos seleccionados" IsChecked="True"
                         Checked="OnSourceChanged" />
            <RadioButton x:Name="SourceRoom"      GroupName="Source" Content="Habitación / espacio"
                         Checked="OnSourceChanged" />
            <RadioButton x:Name="SourceLevel"     GroupName="Source" Content="Nivel"
                         Checked="OnSourceChanged" />
            <RadioButton x:Name="SourceSavedFilter" GroupName="Source" Content="Filtro guardado (OneFilter)"
                         Checked="OnSourceChanged" IsEnabled="False"
                         ToolTip="Disponible cuando OneFilter exponga su repositorio publico" />
        </StackPanel>

        <!-- Picker dinamico segun origen -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource E3g.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel x:Name="SourcePicker" Orientation="Horizontal">
                <TextBlock x:Name="SourcePickerLabel" Text="Selección actual:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="SourcePickerValue" Text="(ninguna)" VerticalAlignment="Center" Foreground="{DynamicResource E3g.Brush.TextMuted}" />
                <Button    Content="Cambiar…" Margin="10,0,0,0" Padding="8,2" Click="OnPickSourceClick" />
            </StackPanel>
        </Border>

        <!-- Padding / alineacion -->
        <TextBlock Grid.Row="3" Style="{StaticResource SectionLabel}" Text="Parámetros" />
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Padding (m):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox   Grid.Column="1" x:Name="PaddingBox" Text="0.5" />
            <TextBlock Grid.Column="2" Text="Alineación:"  VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox  Grid.Column="3" x:Name="AlignmentCombo">
                <ComboBoxItem Content="Proyecto" IsSelected="True" />
                <ComboBoxItem Content="Vista" />
            </ComboBox>
        </Grid>

        <!-- Opciones -->
        <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,0,0,8">
            <CheckBox x:Name="IncludeLinksCheck" Content="Incluir modelos vinculados (linked models)" />
            <CheckBox x:Name="CreateDedicatedViewCheck" Content="Crear vista 3D dedicada con este section box"
                      Checked="OnCreateDedicatedChanged" Unchecked="OnCreateDedicatedChanged" />
            <StackPanel x:Name="DedicatedViewNamePanel" Orientation="Horizontal" Margin="20,4,0,0" IsEnabled="False">
                <TextBlock Text="Nombre vista:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox   x:Name="DedicatedViewNameBox" Width="300" />
            </StackPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="6" x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource E3g.Brush.TextMuted}" Margin="0,8,0,0" />

        <!-- Botones -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Reset vista activa"  Padding="12,4" Margin="0,0,6,0" Click="OnResetClick" />
            <Button Content="Aplicar"             Padding="14,4" Margin="0,0,6,0" FontWeight="SemiBold" Click="OnApplyClick" />
            <Button Content="Cerrar"              Padding="14,4" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>

