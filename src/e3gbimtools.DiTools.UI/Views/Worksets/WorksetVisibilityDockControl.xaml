<UserControl x:Class="E3G.BimTools.DiTools.UI.Views.Worksets.WorksetVisibilityDockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource E3g.Brush.Background}"
             MinWidth="220">
    <DockPanel LastChildFill="True" Margin="8">

        <!-- Cabecera: vista/plantilla destino + acciones -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Visibilidad de worksets"
                       FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
            <TextBlock Text="Sigue la vista activa. Si tiene plantilla de vista, actúa sobre la plantilla."
                       Foreground="{DynamicResource E3g.Brush.TextMuted}" FontSize="10"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource E3g.Brush.SurfaceAlt}" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                <TextBlock x:Name="TargetText" Text="{Binding TargetLabel}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <WrapPanel Margin="0,0,0,6">
                <Button Content="Mostrar todos" Click="OnShowAllClick" Margin="0,0,4,4"/>
                <Button Content="Ocultar todos" Click="OnHideAllClick" Margin="0,0,4,4"/>
                <Button Content="Refrescar"     Click="OnRefreshClick" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>

        <!-- Status al pie -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}" FontSize="10"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <!-- Lista de toggles por workset -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Worksets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                  Margin="2,3" Padding="6,0,0,0"
                                  ToolTip="Marcado = visible en la vista/plantilla destino">
                            <!-- TextBlock (no CheckBox.Content de texto) para que los '_'
                                 no se interpreten como tecla de acceso (mnemónico WPF). -->
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
