<UserControl x:Class="E3G.BimTools.DiTools.UI.Views.RefrigerantRouting.RefrigerantSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource E3g.Brush.Background}">

    <!-- Pestaña «Ajustes» de Climatizacion (2026-11-12): opciones del trazado de
         refrigerante desde DXF que no cambian de un plano a otro. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Titulo">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Text}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Rotulo">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
        </Style>
        <Style TargetType="Border" x:Key="Tarjeta">
            <Setter Property="Background" Value="{DynamicResource E3g.Brush.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">

            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Tuberías y sistemas" Style="{StaticResource Titulo}" />
                    <TextBlock Text="Tipo de tubería" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                    <ComboBox x:Name="PipeTypeCombo" FontSize="11" IsEditable="True" LostFocus="OnChanged" SelectionChanged="OnChanged" />
                    <TextBlock Text="Sistema de líquido" Style="{StaticResource Rotulo}" />
                    <ComboBox x:Name="LiquidCombo" FontSize="11" IsEditable="True" LostFocus="OnChanged" SelectionChanged="OnChanged" />
                    <TextBlock Text="Sistema de gas" Style="{StaticResource Rotulo}" />
                    <ComboBox x:Name="GasCombo" FontSize="11" IsEditable="True" LostFocus="OnChanged" SelectionChanged="OnChanged" />
                    <CheckBox x:Name="CreateSystemsCheck" Content="Crear los sistemas que falten" Checked="OnChanged" Unchecked="OnChanged" />
                    <CheckBox x:Name="AddSizesCheck" Content="Añadir al segmento los diámetros que falten (p. ej. 3/4&quot;)" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Los sistemas nuevos se copian de uno de refrigerante del proyecto: líquido en verde (191,255,127), gas en granate (153,76,76)." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Trazado" Style="{StaticResource Titulo}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Separación entre tubos (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                            <TextBox x:Name="SpacingBox" FontSize="11" LostFocus="OnChanged"
                                     ToolTip="Distancia entre ejes del líquido y el gas de un mismo tramo." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Alto de las cajas (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                            <TextBox x:Name="UnitHeightBox" FontSize="11" LostFocus="OnChanged"
                                     ToolTip="Solo para las familias de caja que se crean desde el bloque." />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="TrimCheck" Content="Acabar en la entrada del recinto de cada unidad interior" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Text="Entrar en el recinto (mm)" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="InsideBox" FontSize="11" LostFocus="OnChanged" />
                    <CheckBox x:Name="ReplaceCheck" Content="Sustituir lo modelado antes desde el mismo DXF" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Lo modelado lleva en Comentarios «E3G_REF archivo handle L/G»; al repetir se borra y se vuelve a crear." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Lectura del DXF" Style="{StaticResource Titulo}" />
                    <TextBlock Text="Capa de tuberías" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                    <TextBox x:Name="PipeLayerBox" FontSize="11" LostFocus="OnChanged" />
                    <TextBlock Text="Capa de recintos" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="RoomLayerBox" FontSize="11" LostFocus="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Perfil LG LATS. Los cambios de capa se aplican al volver a cargar el DXF." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="SavedText" Style="{StaticResource Hint}" Margin="2,0,0,0" Text="Los ajustes se guardan solos." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
