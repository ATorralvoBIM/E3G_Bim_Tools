<Window x:Class="E3G.BimTools.DiTools.UI.Views.DxfLegend.DxfLegendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        xmlns:local="clr-namespace:E3G.BimTools.DiTools.UI.Views.DxfLegend"
        Title="e3gbimtools — Leyenda desde DXF"
        Width="1080" Height="720"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Leyenda desde DXF"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: archivo -->
            <RowDefinition Height="*" />      <!-- 1: opciones + vista previa -->
            <RowDefinition Height="Auto" />   <!-- 2: estado -->
            <RowDefinition Height="Auto" />   <!-- 3: botones -->
        </Grid.RowDefinitions>

        <!-- 0. Archivo -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Archivo DXF / DWG" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FileBox" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,4" Content="Examinar…" Click="OnBrowseClick" />
            </Grid>
            <TextBlock x:Name="FileInfo" Style="{StaticResource Hint}"
                       Text="Elige la leyenda dibujada en AutoCAD (en espacio modelo, preparada para una ventana gráfica a escala)." />
        </StackPanel>

        <!-- 1. Opciones + vista previa -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Vista destino" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ViewCombo" DisplayMemberPath="DisplayName" SelectionChanged="OnViewChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Leyendas y vistas de dibujo del modelo. Por defecto, la vista activa." />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Escala 1:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" x:Name="ScaleBox" Text="100" TextChanged="OnOptionChanged" />
                        <TextBlock Grid.Column="2" Text="Unidades:" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox Grid.Column="3" x:Name="UnitsCombo" DisplayMemberPath="Label" SelectionChanged="OnOptionChanged" />
                    </Grid>
                    <TextBlock x:Name="PaperInfo" Style="{StaticResource Hint}" />

                    <TextBlock Text="Capas" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Marcar todas" Padding="8,2" Click="OnAllLayersClick" />
                        <Button Content="Desmarcar todas" Padding="8,2" Margin="8,0,0,0" Click="OnNoLayersClick" />
                    </StackPanel>
                    <ListBox x:Name="LayersList" Height="210" BorderThickness="1"
                             BorderBrush="{DynamicResource E3g.Brush.Border}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Checked="OnLayerToggled" Unchecked="OnLayerToggled" />
                                    <Border Width="12" Height="12" Margin="6,0,6,0" CornerRadius="2"
                                            Background="{Binding Swatch}" BorderBrush="#40000000" BorderThickness="1"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource E3g.Brush.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Se desmarcan solas las capas apagadas, las que no se imprimen y los marcos de ventana gráfica." />

                    <TextBlock Text="Opciones" Style="{StaticResource SectionLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Prefijo de estilos:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PrefixBox" Text="E3G_LEY" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ancho de texto:" VerticalAlignment="Center" Margin="0,6,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WidthFactorBox" Text="0,98" Margin="0,6,0,0"
                                 ToolTip="Factor de anchura de los tipos de texto. Calibri sale ~2 % más ancha en Revit que en AutoCAD; 0,98 iguala la longitud de las líneas." />
                    </Grid>
                    <CheckBox x:Name="ClearViewCheck" Margin="0,8,0,0"
                              Content="Vaciar la vista antes (líneas, regiones y textos)" />
                    <CheckBox x:Name="MoveToOriginCheck" Margin="0,6,0,0"
                              Content="Llevar la esquina superior izquierda al origen" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource E3g.Brush.Border}" Background="White">
                <Grid>
                    <local:LegendPreview x:Name="Preview" />
                    <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}" FontStyle="Italic"
                               Text="La vista previa aparecerá al cargar un archivo." />
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Estado -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}" FontStyle="Italic"
                   Text="Carga un archivo para empezar." />

        <!-- 3. Botones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="GenerateButton" Content="Generar leyenda" Padding="20,6" IsDefault="True"
                    IsEnabled="False" Click="OnGenerateClick" />
            <Button Content="Cerrar" Margin="8,0,0,0" Padding="20,6" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
