<Window x:Class="E3G.BimTools.DiTools.UI.Views.TableGen.TableGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        xmlns:local="clr-namespace:E3G.BimTools.DiTools.UI.Views.TableGen"
        Title="e3gbimtools — TableGen"
        Width="780" Height="620"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="TableGen"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Titulo -->
            <RowDefinition Height="*"/>      <!-- TabControl -->
            <RowDefinition Height="Auto"/>   <!-- Barra de estado global -->
        </Grid.RowDefinitions>

        <!-- â”€â”€ Titulo â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <TextBlock Grid.Row="0"
                   Text="TableGen — Tablas en Revit"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource E3g.Brush.Primary}"
                   Margin="0,0,0,10"/>

        <!-- â”€â”€ Tabs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <TabControl Grid.Row="1" x:Name="MainTabs"
                    SelectedIndex="{Binding SelectedTabIndex}">

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
                 TAB 1 — Excel → Vista  (P1, sin cambios funcionales)
            â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <TabItem Header="Excel → Vista">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Archivo -->
                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Archivo .xlsx:"
                                   VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                   IsReadOnly="True" VerticalAlignment="Center"/>
                        <Button    Grid.Column="2" Content="Examinar…"
                                   Command="{Binding BrowseFileCommand}"
                                   Margin="7,0,0,0" Padding="10,4"/>
                    </Grid>

                    <!-- Hoja + Rango -->
                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hoja:"
                                   VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding SheetNames}"
                                   SelectedItem="{Binding SelectedSheet}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Rango:"
                                   VerticalAlignment="Center" Margin="10,0,7,0"/>
                        <TextBox   Grid.Column="3"
                                   Text="{Binding RangeAddress, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"
                                   ToolTip="Ej: A1:J20  (vacío = rango usado)"/>
                    </Grid>

                    <!-- Nombre vista -->
                    <Grid Grid.Row="2" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nombre vista:"
                                   VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Opciones -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,7">
                        <CheckBox Content="Sobreescribir si ya existe"
                                  IsChecked="{Binding OverwriteExisting}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="PlaceAfterGenCheck"
                                  Content="Colocar en hoja después de generar"
                                  IsChecked="{Binding PlaceAfterGenerate}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Picker de hoja (visible solo si PlaceAfterGenerate) -->
                    <Grid Grid.Row="4" Margin="0,0,0,7"
                          Visibility="{Binding PlaceAfterGenerate, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hoja destino:"
                                   VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding DrawingSheets}"
                                   SelectedItem="{Binding SelectedSheet1}"
                                   DisplayMemberPath="DisplayName"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="X (mm):"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox   Grid.Column="3"
                                   Text="{Binding PlaceXOffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Y (mm):"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox   Grid.Column="5"
                                   Text="{Binding PlaceYOffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Botón preview -->
                    <Button Grid.Row="5"
                            Content="Cargar preview"
                            Command="{Binding LoadPreviewCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,5" Margin="0,0,0,8"
                            VerticalAlignment="Top"/>

                    <!-- DataGrid preview -->
                    <GroupBox Grid.Row="5" Header="Preview de celdas" Margin="120,0,0,8">
                        <DataGrid ItemsSource="{Binding PreviewRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  AlternatingRowBackground="{DynamicResource E3g.Brush.SurfaceSubtle}"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Celda"  Binding="{Binding RowCol}"  Width="70"/>
                                <DataGridTextColumn Header="Valor"  Binding="{Binding Value}"   Width="*"/>
                                <DataGridTextColumn Header="Fuente" Binding="{Binding Size}"    Width="60"/>
                                <DataGridTextColumn Header="Fondo"  Binding="{Binding BG}"      Width="80"/>
                                <DataGridTextColumn Header="Merge"  Binding="{Binding Merged}"  Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Barra + Generar -->
                    <Grid Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Tab1Status}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                        <ProgressBar Grid.Column="1" Width="80" Height="14" Margin="8,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
                        <Button Grid.Column="2" Content="Generar vista"
                                Command="{Binding GenerateCommand}"
                                Padding="14,6" FontWeight="SemiBold"
                                Background="{DynamicResource E3g.Brush.Primary}" Foreground="{DynamicResource E3g.Brush.TextOnPrimary}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
                 TAB 2 — Lote + Colocar en hoja
            â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <TabItem Header="Lote + Colocar en hoja">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Seccion Batch -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>  <!-- Separador -->
                        <RowDefinition Height="Auto"/>  <!-- Seccion Place -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>     <!-- Resultados batch -->
                        <RowDefinition Height="Auto"/>  <!-- Botones + estado -->
                    </Grid.RowDefinitions>

                    <!-- Sección Lote -->
                    <TextBlock Grid.Row="0"
                               Text="Generación en lote (una vista por hoja del Excel)"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource E3g.Brush.Primary}"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Archivo .xlsx:"
                                   VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding BatchFilePath, UpdateSourceTrigger=PropertyChanged}"
                                   IsReadOnly="True" VerticalAlignment="Center"/>
                        <Button    Grid.Column="2" Content="Examinar…"
                                   Command="{Binding BatchBrowseCommand}"
                                   Margin="7,0,0,0" Padding="10,4"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Patrón de nombre:"
                                   VerticalAlignment="Center"
                                   ToolTip="Use {sheet} y {file} como comodines"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding BatchNamingPattern, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"
                                   ToolTip="Ej: TableGen_{file}_{sheet}  (vacío = patrón por defecto)"/>
                    </Grid>

                    <CheckBox Grid.Row="3"
                              Content="Sobreescribir vistas existentes con el mismo nombre"
                              IsChecked="{Binding BatchOverwrite}"
                              Margin="0,0,0,10"/>

                    <!-- Separador -->
                    <Separator Grid.Row="4" Margin="0,0,0,10"/>

                    <!-- Sección Colocar en hoja -->
                    <TextBlock Grid.Row="5"
                               Text="Colocar vista existente en un Drawing Sheet"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource E3g.Brush.Primary}"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="6" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vista (Drafting):"
                                   VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding DraftingViews}"
                                   SelectedItem="{Binding SelectedDraftingView}"
                                   DisplayMemberPath="DisplayName"
                                   VerticalAlignment="Center"/>
                        <Button    Grid.Column="2" Content="↺ Recargar"
                                   Command="{Binding ReloadViewsCommand}"
                                   Margin="7,0,0,0" Padding="8,4"/>
                    </Grid>

                    <Grid Grid.Row="7" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="85"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hoja destino:"
                                   VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding DrawingSheets}"
                                   SelectedItem="{Binding SelectedSheet2}"
                                   DisplayMemberPath="DisplayName"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="X (mm):"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox   Grid.Column="3"
                                   Text="{Binding PlaceXMm, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Y (mm):"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox   Grid.Column="5"
                                   Text="{Binding PlaceYMm, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Lista de resultados del lote -->
                    <GroupBox Grid.Row="8" Header="Resultados del lote" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding BatchResults}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  AlternatingRowBackground="{DynamicResource E3g.Brush.SurfaceSubtle}"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hoja"   Binding="{Binding SheetName}" Width="*"/>
                                <DataGridTextColumn Header="Vista"  Binding="{Binding ViewName}"  Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}"    Width="100"/>
                                <DataGridTextColumn Header="ms"     Binding="{Binding ElapsedMs}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Barra inferior -->
                    <Grid Grid.Row="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Tab2Status}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                        <ProgressBar Grid.Column="1" Width="80" Height="14" Margin="8,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button Grid.Column="2" Content="Generar lote"
                                Command="{Binding GenerateBatchCommand}"
                                Padding="12,6" FontWeight="SemiBold"
                                Background="{DynamicResource E3g.Brush.Primary}" Foreground="{DynamicResource E3g.Brush.TextOnPrimary}" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Colocar en hoja"
                                Command="{Binding PlaceOnSheetCommand}"
                                Padding="12,6"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
                 TAB 3 — Schedule → Vista
            â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
            <TabItem Header="Schedule → Vista">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selector de schedule -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Schedule origen:"
                                   VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding Schedules}"
                                   SelectedItem="{Binding SelectedSchedule}"
                                   DisplayMemberPath="DisplayName"
                                   VerticalAlignment="Center"/>
                        <Button    Grid.Column="2" Content="↺ Recargar"
                                   Command="{Binding ReloadSchedulesCommand}"
                                   Margin="7,0,0,0" Padding="8,4"/>
                    </Grid>

                    <!-- Nombre de la vista destino -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nombre vista:"
                                   VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding ScheduleViewName, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"
                                   ToolTip="Vacío = TableGen_{NombreSchedule}"/>
                    </Grid>

                    <!-- Parámetros opcionales -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Escala columnas:"
                                   VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1"
                                   Text="{Binding SchedColMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"
                                   ToolTip="Factor de escala sobre el ancho real de columna (1.0 = tamaño real)"/>
                        <TextBlock Grid.Column="2" Text="Alto cab. (mm):"
                                   VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox   Grid.Column="3"
                                   Text="{Binding SchedHeaderHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Alto fila (mm):"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox   Grid.Column="5"
                                   Text="{Binding SchedBodyHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <CheckBox Grid.Row="3"
                              Content="Sobreescribir vista si ya existe"
                              IsChecked="{Binding ScheduleOverwrite}"
                              Margin="0,0,0,10"/>

                    <!-- Info del schedule seleccionado -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource E3g.Brush.SurfaceSubtle}"
                            BorderBrush="{DynamicResource E3g.Brush.Primary}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,10"
                            Visibility="{Binding HasScheduleSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ScheduleInfoText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                    </Border>

                    <!-- Resultado de la ultima exportacion -->
                    <GroupBox Grid.Row="5" Header="Último resultado"
                              Margin="0,0,0,8"
                              Visibility="{Binding HasScheduleResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ScheduleResultText}"
                                   Padding="8,6" TextWrapping="Wrap"/>
                    </GroupBox>

                    <!-- Spacer -->
                    <Rectangle Grid.Row="6"/>

                    <!-- Barra inferior -->
                    <Grid Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Tab3Status}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                        <ProgressBar Grid.Column="1" Width="80" Height="14" Margin="8,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsScheduleRunning, Converter={StaticResource BoolToVis}}"/>
                        <Button Grid.Column="2" Content="Generar desde schedule"
                                Command="{Binding ExportScheduleCommand}"
                                Padding="14,6" FontWeight="SemiBold"
                                Background="{DynamicResource E3g.Brush.Primary}" Foreground="{DynamicResource E3g.Brush.TextOnPrimary}"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- â”€â”€ Barra de estado global â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <TextBlock Grid.Row="2"
                   Text="{Binding GlobalStatus}"
                   FontSize="11"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasGlobalStatus, Converter={StaticResource BoolToVis}}"/>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
