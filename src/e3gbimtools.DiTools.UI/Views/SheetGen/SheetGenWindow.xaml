<Window x:Class="E3G.BimTools.DiTools.UI.Views.SheetGen.SheetGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        xmlns:conv="clr-namespace:E3G.BimTools.DiTools.UI.Converters"
        Title="e3gbimtools — SheetGen"
        Width="1000" Height="700"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin"  Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="SheetGen"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- =========================================================== -->
            <!-- PESTAÑA 1 — Crear / Importar                                 -->
            <!-- =========================================================== -->
            <TabItem Header="Crear / Importar">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="+ Fila"            Style="{StaticResource ActionButton}" Click="OnAddRowClick"/>
                        <Button Content="- Fila"            Style="{StaticResource ActionButton}" Click="OnRemoveRowClick"/>
                        <Separator Width="1" Margin="4,0" Background="{DynamicResource E3g.Brush.Border}"/>
                        <Button Content="Importar desde Excel…" Style="{StaticResource ActionButton}" Click="OnImportExcelClick"/>
                        <Button Content="Exportar a Excel…"     Style="{StaticResource ActionButton}" Click="OnExportExcelClick"/>
                        <Separator Width="1" Margin="4,0" Background="{DynamicResource E3g.Brush.Border}"/>
                        <TextBlock Text="Layout:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <ComboBox x:Name="LayoutCombo" Width="200"
                                  ItemsSource="{Binding LayoutsForCombo}"
                                  SelectedItem="{Binding SelectedLayoutForCreate}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, FallbackValue='Sin layout'}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Grid de edición -->
                    <DataGrid Grid.Row="1"
                              x:Name="NewSheetsGrid"
                              ItemsSource="{Binding NewSheets}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="24">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número"     Binding="{Binding SheetNumber, UpdateSourceTrigger=PropertyChanged}"           Width="120"/>
                            <DataGridTextColumn Header="Nombre"     Binding="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}"              Width="3*"/>
                            <DataGridComboBoxColumn Header="Title Block"
                                                    SelectedItemBinding="{Binding TitleBlockFamilyTypeName, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.TitleBlocks, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.TitleBlocks, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Disciplina" Binding="{Binding Discipline, UpdateSourceTrigger=PropertyChanged}"             Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Progress -->
                    <ProgressBar Grid.Row="2" x:Name="CreateProgressBar"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding CreateProgress}"
                                 Height="6" Margin="0,6,0,4"/>

                    <!-- Status -->
                    <TextBlock Grid.Row="3" Text="{Binding CreateStatus}"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}" FontStyle="Italic" Margin="0,0,0,8"/>

                    <!-- Botón crear -->
                    <Button Grid.Row="4" Content="Crear sheets" HorizontalAlignment="Left"
                            Padding="14,6" FontWeight="SemiBold"
                            Click="OnCreateSheetsClick"/>
                </Grid>
            </TabItem>

            <!-- =========================================================== -->
            <!-- PESTAÑA 2 — Layouts                                          -->
            <!-- =========================================================== -->
            <TabItem Header="Layouts">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de layouts -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Layouts guardados"/>
                        <ListBox Grid.Row="1" x:Name="LayoutList"
                                 ItemsSource="{Binding Layouts}"
                                 SelectedItem="{Binding SelectedLayout}"
                                 DisplayMemberPath="Name"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Nuevo"    Style="{StaticResource ActionButton}" Click="OnNewLayoutClick"/>
                            <Button Content="Eliminar" Style="{StaticResource ActionButton}" Click="OnDeleteLayoutClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Editor de layout -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="Editar layout"/>

                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:"       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LayoutNameBox" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Descripción:"  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="LayoutDescBox"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="+ Vista" Style="{StaticResource ActionButton}" Click="OnAddPlacementClick"/>
                            <Button Content="- Vista" Style="{StaticResource ActionButton}" Click="OnRemovePlacementClick"/>
                        </StackPanel>

                        <DataGrid Grid.Row="3" x:Name="PlacementsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="24">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vista"      Binding="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}"  Width="3*"/>
                                <DataGridTextColumn Header="X (mm)"     Binding="{Binding XOffsetMm, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Y (mm)"     Binding="{Binding YOffsetMm, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="Escala"     Binding="{Binding ScaleOverride, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="4" Content="Guardar layout" HorizontalAlignment="Left"
                                Padding="12,5" Margin="0,8,0,0" FontWeight="SemiBold"
                                Click="OnSaveLayoutClick"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- =========================================================== -->
            <!-- PESTAÑA 3 — Revisiones                                       -->
            <!-- =========================================================== -->
            <TabItem Header="Revisiones">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}"
                               Text="Selecciona las sheets y la revisión a asignar o quitar:"/>

                    <DataGrid Grid.Row="1" x:Name="RevSheetsGrid"
                              ItemsSource="{Binding AllSheets}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="22" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding SheetNumber}" Width="120"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding SheetName}"   Width="3*"/>
                            <DataGridTextColumn Header="Vistas" Binding="{Binding ViewCount}"   Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Revisión:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox  Grid.Column="1" ItemsSource="{Binding Revisions}"
                                   SelectedItem="{Binding SelectedRevision}"/>
                        <RadioButton Grid.Column="2" Content="Asignar" IsChecked="{Binding AddRevision}"
                                     Margin="16,0,8,0" VerticalAlignment="Center"/>
                        <RadioButton Grid.Column="3" Content="Quitar"
                                     IsChecked="{Binding AddRevision, Converter={StaticResource InvBool}}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Button Grid.Row="3" Content="Aplicar" HorizontalAlignment="Left"
                            Padding="14,6" FontWeight="SemiBold"
                            Click="OnApplyRevisionsClick"/>
                </Grid>
            </TabItem>

            <!-- =========================================================== -->
            <!-- PESTAÑA 4 — Auditoría / Renumerar                            -->
            <!-- =========================================================== -->
            <TabItem Header="Auditoría / Renumerar">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Auditoría -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Auditoría del juego de planos" Margin="0,6,12,4"/>
                        <Button Content="Auditar" Padding="10,4" VerticalAlignment="Center" Click="OnAuditClick"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Sheets huérfanas (sin vistas)" Margin="0,0,4,0">
                            <DataGrid x:Name="OrphanGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="22">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Número" Binding="{Binding SheetNumber}" Width="100"/>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding SheetName}"   Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Números duplicados" Margin="4,0,0,0">
                            <ListBox x:Name="DuplicatesList"/>
                        </GroupBox>
                    </Grid>

                    <!-- Separador -->
                    <Separator Grid.Row="2" Margin="0,10,0,6"/>

                    <!-- Renumeración -->
                    <TextBlock Grid.Row="3" Style="{StaticResource SectionLabel}" Text="Renumeración en bulk"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Opciones -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Prefijo:"   VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PrefixBox"  Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sufijo:"    VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SuffixBox"  Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Inicio:"    VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="StartBox" Text="1"  Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Dígitos:"   VerticalAlignment="Center"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="PadBox"   Text="2"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Previsualizar" Padding="10,4" Margin="0,0,6,0" Click="OnPreviewRenumClick"/>
                                <Button Content="Aplicar"       Padding="10,4" FontWeight="SemiBold" Click="OnApplyRenumClick"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Preview -->
                        <GroupBox Grid.Column="1" Header="Preview de renumeración">
                            <DataGrid x:Name="RenumPreviewGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="22">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Anterior" Width="*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="OldNumber"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Nuevo" Width="*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="NewNumber"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <!-- Selector de sheets a renumerar -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Sheets a renumerar: selecciona en la lista de arriba (pestaña Revisiones)."
                                   FontStyle="Italic" Foreground="{DynamicResource E3g.Brush.TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Recargar" Padding="10,4" Margin="0,0,8,0" Click="OnRefreshClick"/>
            <Button Content="Cerrar"   Padding="10,4" Click="OnCloseClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>

