<Window x:Class="E3G.BimTools.DiTools.UI.Views.SheetLink.SheetLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls"
        Title="e3gbimtools — SheetLink" Height="700" Width="1100"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Estilos base heredados del tema e3g -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Primary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- Filas del DataGrid de diff (Sprint 12): estado de diff + estado de aplicacion -->
        <!-- Los triggers de DiffStatus se aplican primero; los de ApplyStatus los sobreescriben al aplicar -->
        <Style x:Key="DiffRowStyle" TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding ChangesTooltip}"/>
            <Style.Triggers>
                <!-- DiffStatus (antes de aplicar) -->
                <DataTrigger Binding="{Binding StatusCode}" Value="Modified">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.WarningBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.ErrorBg}"/>
                </DataTrigger>
                <!-- ApplyStatus (despues de aplicar — sobreescribe DiffStatus) -->
                <DataTrigger Binding="{Binding ApplyStatusCode}" Value="Updated">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.SuccessBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ApplyStatusCode}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.ErrorBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ApplyStatusCode}" Value="Skipped">
                    <Setter Property="Background" Value="{DynamicResource E3g.Brush.SurfaceSubtle}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="SheetLink"
                                  ShowStatus="False"
                                  ShowMinimize="False" />

    <DockPanel>

        <!-- ============================================================ -->
        <!-- Barra superior con titulo                                     -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource E3g.Brush.Primary}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SheetLink"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource E3g.Brush.TextOnPrimary}"/>
                <TextBlock Text=" — Exportar e importar datos de planos"
                           FontSize="13"
                           Foreground="{DynamicResource E3g.Brush.OnBrandMuted}"
                           VerticalAlignment="Bottom"
                           Margin="6,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Barra de estado inferior                                      -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource E3g.Brush.Surface}"
                BorderBrush="{DynamicResource E3g.Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusBar"
                       Text="Listo."
                       FontSize="11"
                       Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
        </Border>

        <!-- ============================================================ -->
        <!-- TabControl principal                                          -->
        <!-- ============================================================ -->
        <TabControl Margin="8"
                    Background="{DynamicResource E3g.Brush.Background}">

            <!-- ======================================================== -->
            <!-- TAB 1: EXPORTAR                                           -->
            <!-- ======================================================== -->
            <TabItem Header="1. Exportar planos a Excel">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Instruccion -->
                    <TextBlock Grid.Row="0"
                               Text="Selecciona los planos a exportar y las columnas a incluir.  El archivo Excel generado se puede editar y luego reimportar en la pestaña 2."
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}"/>

                    <!-- Opciones de columnas -->
                    <GroupBox Grid.Row="1" Header="Columnas a exportar" Margin="0,0,0,10" Padding="8">
                        <WrapPanel>
                            <CheckBox x:Name="ChkRevisionFields"   Content="Campos de revision (fecha, numero, descripcion)"
                                      IsChecked="True" Margin="0,0,20,4"/>
                            <CheckBox x:Name="ChkSignatoryFields"  Content="Firmantes (Emitido por/para, Aprobado, Disenado, etc.)"
                                      IsChecked="True" Margin="0,0,20,4"/>
                            <CheckBox x:Name="ChkViewsPlaced"      Content="Vistas colocadas"
                                      IsChecked="True" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </GroupBox>

                    <!-- Lista de planos con seleccion -->
                    <GroupBox Grid.Row="2" Header="Planos del documento" Padding="6">
                        <DockPanel>
                            <!-- Toolbar lista -->
                            <ToolBar DockPanel.Dock="Top" Background="Transparent" Padding="0,0,0,4">
                                <Button x:Name="BtnSelectAll"   Content="✓ Marcar todos"
                                        Click="OnSelectAll"    Padding="8,3" Margin="0,0,4,0"/>
                                <Button x:Name="BtnDeselectAll" Content="✗ Desmarcar todos"
                                        Click="OnDeselectAll"  Padding="8,3" Margin="0,0,8,0"/>
                                <Separator/>
                                <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBox  x:Name="ExportFilter"
                                          Width="160"
                                          TextChanged="OnExportFilterChanged"
                                          VerticalAlignment="Center"
                                          Padding="4,2"/>
                            </ToolBar>

                            <DataGrid x:Name="ExportGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Extended"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn  Header=""          Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
                                    <DataGridTextColumn      Header="Numero"    Binding="{Binding Row.SheetNumber}"  Width="90"  IsReadOnly="True"/>
                                    <DataGridTextColumn      Header="Nombre"    Binding="{Binding Row.SheetName}"    Width="*"   IsReadOnly="True"/>
                                    <DataGridTextColumn      Header="Rotulo"    Binding="{Binding Row.TitleBlock}"   Width="140" IsReadOnly="True"/>
                                    <DataGridTextColumn      Header="Rev."      Binding="{Binding Row.RevisionNumber}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn      Header="Vistas"    Binding="{Binding Row.ViewsPlaced}"  Width="180" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- Boton exportar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="ExportCountLabel"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                        <Button x:Name="BtnExport"
                                Content="Exportar Excel..."
                                Click="OnExport"
                                Padding="16,6"
                                Background="{DynamicResource E3g.Brush.Primary}"
                                Foreground="{DynamicResource E3g.Brush.TextOnPrimary}"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 2: IMPORTAR (Sprint 12 — Diff Before/After)          -->
            <!-- ======================================================== -->
            <TabItem Header="2. Importar / Aplicar cambios">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- 0: instruccion -->
                        <RowDefinition Height="Auto"/><!-- 1: selector de archivo -->
                        <RowDefinition Height="Auto"/><!-- 2: panel de metadatos -->
                        <RowDefinition Height="Auto"/><!-- 3: barra de opciones diff -->
                        <RowDefinition Height="*"/>   <!-- 4: DataGrid de diff -->
                        <RowDefinition Height="Auto"/><!-- 5: resumen + boton aplicar -->
                    </Grid.RowDefinitions>

                    <!-- 0. Instruccion -->
                    <TextBlock Grid.Row="0"
                               Text="Selecciona el .xlsx exportado (editado en Excel), calcula el diff para ver exactamente que cambiara, y aplica solo las filas que desees."
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}"/>

                    <!-- 1. Selector de archivo + Calcular diff -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox  x:Name="ImportFilePath"
                                  Grid.Column="0"
                                  IsReadOnly="True"
                                  Padding="6,4"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                        <Button   Grid.Column="1"
                                  Content="Examinar..."
                                  Click="OnBrowseImport"
                                  Padding="10,4"
                                  Margin="6,0"/>
                        <Button   x:Name="BtnComputeDiff"
                                  Grid.Column="2"
                                  Content="Calcular diff →"
                                  Click="OnComputeDiff"
                                  Padding="12,4"
                                  IsEnabled="False"
                                  FontWeight="SemiBold"/>
                    </Grid>

                    <!-- 2. Panel de metadatos del .xlsx (oculto hasta validar) -->
                    <Border Grid.Row="2"
                            x:Name="MetaPanel"
                            Background="{DynamicResource E3g.Brush.Surface}"
                            BorderBrush="{DynamicResource E3g.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,6"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <WrapPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource E3g.Brush.TextMuted}">
                                <Run Text="Exportado:"/>
                                <Run x:Name="MetaExportDate" FontWeight="SemiBold"/>
                                <Run Text="  |  Documento:"/>
                                <Run x:Name="MetaDocumentTitle" FontWeight="SemiBold"/>
                                <Run Text="  |  Planos exportados:"/>
                                <Run x:Name="MetaSheetsCount" FontWeight="SemiBold"/>
                            </TextBlock>
                        </WrapPanel>
                    </Border>

                    <!-- 3. Barra de opciones del diff (oculta hasta calcular diff) -->
                    <Grid Grid.Row="3"
                          x:Name="DiffOptionsBar"
                          Margin="0,0,0,6"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkSoloModificados"
                                  Grid.Column="0"
                                  Content="Solo filas con cambios"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  Checked="OnFilterChanged"
                                  Unchecked="OnFilterChanged"/>
                        <Button Grid.Column="1"
                                Content="✓ Seleccionar modificados"
                                Click="OnSelectModified"
                                Padding="8,3"
                                Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Content="✗ Deseleccionar todos"
                                Click="OnDeselectAllDiff"
                                Padding="8,3"/>
                        <TextBlock x:Name="DiffCountLabel"
                                   Grid.Column="4"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                    </Grid>

                    <!-- 4. DataGrid de diff con Before/After coloreado -->
                    <GroupBox Grid.Row="4"
                              x:Name="DiffGroupBox"
                              Header="Diff — Modelo actual (Antes) vs Excel editado (Despues)"
                              Padding="6"
                              Visibility="Collapsed">
                        <DataGrid x:Name="DiffGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  RowStyle="{StaticResource DiffRowStyle}"
                                  SelectionMode="Single"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <!-- Checkbox de seleccion (solo habilitado para filas Modified) -->
                                <DataGridTemplateColumn Header="✓" Width="32" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Estado del diff -->
                                <DataGridTextColumn Header="Estado"
                                                    Binding="{Binding StatusLabel}"
                                                    Width="100"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Numero de plano — "antes → despues" si cambio -->
                                <DataGridTextColumn Header="Numero (Antes → Despues)"
                                                    Binding="{Binding NumberDisplay}"
                                                    Width="180"
                                                    IsReadOnly="True"/>

                                <!-- Nombre del plano — "antes → despues" si cambio -->
                                <DataGridTextColumn Header="Nombre (Antes → Despues)"
                                                    Binding="{Binding NameDisplay}"
                                                    Width="*"
                                                    IsReadOnly="True"/>

                                <!-- Numero de campos que cambian -->
                                <DataGridTextColumn Header="# Cambios"
                                                    Binding="{Binding ChangedCount}"
                                                    Width="75"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Estado tras aplicar (vacio antes de aplicar) -->
                                <DataGridTextColumn Header="Resultado"
                                                    Binding="{Binding ApplyStatusLabel}"
                                                    Width="90"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- 5. Resumen + boton Aplicar -->
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel de resumen (oculto hasta aplicar) -->
                        <Border x:Name="ImportSummaryPanel"
                                Grid.Column="0"
                                Background="{DynamicResource E3g.Brush.SurfaceSubtle}"
                                BorderBrush="{DynamicResource E3g.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6"
                                Margin="0,0,12,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ImportSummaryText"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="BtnApply"
                                Grid.Column="1"
                                Content="Aplicar cambios seleccionados al modelo"
                                Click="OnApply"
                                IsEnabled="False"
                                Padding="16,6"
                                Background="{DynamicResource E3g.Brush.Primary}"
                                Foreground="{DynamicResource E3g.Brush.TextOnPrimary}"
                                FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
            </DockPanel>
        </Border>
    </Border>
</Window>
