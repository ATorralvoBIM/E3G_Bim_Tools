                                    <HierarchicalDataTemplate DataType="{x:Type views:SubChapterTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ðŸ“ " />
                                            <TextBlock Text="{Binding Header}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type views:RuleTreeNode}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ðŸ“„ " />
                                            <TextBlock Text="{Binding Header}" />
