<Window
    x:Class="E3G.BimTools.RevitBC3.Views.RevitBC3MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls;assembly=e3gbimtools.DiTools.UI"
    xmlns:views="clr-namespace:E3G.BimTools.RevitBC3.Views"
    Title="e3gbimtools — Revit → BC3"
    Width="1320" Height="820"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    MinWidth="1000" MinHeight="600"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource E3g.Font.Family}"
    FontSize="{DynamicResource E3g.Font.Size.Body}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ============================================================
             Colores y brushes locales (tema blanco / mockup white) -
             se apoyan en los brushes E3G existentes pero anaden tonos
             secundarios neutros para no depender de un tema nuevo.
             ============================================================ -->
        <SolidColorBrush x:Key="Mockup.Bg.Body"        Color="{DynamicResource E3g.Color.Background}" />
        <SolidColorBrush x:Key="Mockup.Bg.Panel"       Color="{DynamicResource E3g.Color.SurfaceSubtle}" />
        <SolidColorBrush x:Key="Mockup.Bg.PanelAlt"    Color="{DynamicResource E3g.Color.SurfaceSubtle}" />
        <SolidColorBrush x:Key="Mockup.Bg.Header"      Color="{DynamicResource E3g.Color.SurfaceSubtle}" />
        <SolidColorBrush x:Key="Mockup.Bg.RowHover"    Color="{DynamicResource E3g.Color.SurfaceSubtle}" />
        <SolidColorBrush x:Key="Mockup.Bg.RowSelected" Color="{DynamicResource E3g.Color.Module.FilterBg}" />

        <SolidColorBrush x:Key="Mockup.Border"         Color="{DynamicResource E3g.Color.BorderSubtle}" />
        <SolidColorBrush x:Key="Mockup.Border.Strong"  Color="{DynamicResource E3g.Color.BorderSubtle}" />

        <SolidColorBrush x:Key="Mockup.Text"           Color="{DynamicResource E3g.Color.Text}" />
        <SolidColorBrush x:Key="Mockup.Text.Muted"     Color="{DynamicResource E3g.Color.TextMuted}" />
        <SolidColorBrush x:Key="Mockup.Text.Soft"      Color="{DynamicResource E3g.Color.TextSoft}" />

        <SolidColorBrush x:Key="Mockup.Accent.Blue"    Color="{DynamicResource E3g.Color.Accent}" />
        <SolidColorBrush x:Key="Mockup.Accent.BlueBg"  Color="{DynamicResource E3g.Color.Module.FilterBg}" />
        <SolidColorBrush x:Key="Mockup.Accent.Amber"   Color="{DynamicResource E3g.Color.WarningText}" />
        <SolidColorBrush x:Key="Mockup.Accent.AmberBg" Color="{DynamicResource E3g.Color.WarningBg}" />
        <SolidColorBrush x:Key="Mockup.Accent.Green"   Color="{DynamicResource E3g.Color.Primary}" />
        <SolidColorBrush x:Key="Mockup.Accent.GreenBg" Color="{DynamicResource E3g.Color.BrandTint}" />
        <SolidColorBrush x:Key="Mockup.Accent.Red"     Color="{DynamicResource E3g.Color.ErrorText}" />
        <SolidColorBrush x:Key="Mockup.Accent.RedBg"   Color="{DynamicResource E3g.Color.ErrorBg}" />

        <!-- ============================================================
             Tipografias
             ============================================================ -->
        <FontFamily x:Key="Mockup.Mono">Consolas</FontFamily>

        <!-- Iconos vectoriales: Segoe Fluent (Win11) con fallback a MDL2 (Win10).
             Se usan via glyphs en TextBlock dentro de los botones. -->
        <FontFamily x:Key="Mockup.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ============================================================
             Estilos de texto
             ============================================================ -->
        <Style x:Key="PanelHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Mockup.Text}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
            <Setter Property="Foreground" Value="{DynamicResource Mockup.Text.Soft}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="MonoCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- ============================================================
             Botones de la toolbar (estilo plano tipo mockup)
             ============================================================ -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Mockup.Text.Muted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mockup.Bg.PanelAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Mockup.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CTA relleno reutilizable: define el Background donde se use -->
        <Style x:Key="ToolbarButton.Filled" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primario azul (relleno) -->
        <Style x:Key="ToolbarButton.Primary" TargetType="Button" BasedOn="{StaticResource ToolbarButton.Filled}">
            <Setter Property="Background" Value="{DynamicResource Mockup.Accent.Blue}" />
        </Style>

        <!-- Calcular: accion principal del flujo (azul relleno) -->
        <Style x:Key="ToolbarButton.Amber" TargetType="Button" BasedOn="{StaticResource ToolbarButton.Filled}">
            <Setter Property="Background" Value="{DynamicResource Mockup.Accent.Blue}" />
        </Style>

        <!-- Exportar: CTA de salida (verde relleno) -->
        <Style x:Key="ToolbarButton.Green" TargetType="Button" BasedOn="{StaticResource ToolbarButton.Filled}">
            <Setter Property="Background" Value="{DynamicResource Mockup.Accent.Green}" />
        </Style>

        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,4,8,4" />
            <Setter Property="Background" Value="{DynamicResource Mockup.Border}" />
        </Style>

        <!-- ============================================================
             Badges
             ============================================================ -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============================================================
             Sub-tabs (Mapping / Huerfanos)
             ============================================================ -->
        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Mockup.Text.Muted}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Mockup.Accent.Blue}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mockup.Accent.Blue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Mockup.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             TreeView (estilo simple sin templating profundo)
             ============================================================ -->
        <Style TargetType="TreeViewItem" x:Key="MockupTreeViewItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- ============================================================
             DataGrid - estilo claro tipo mockup
             ============================================================ -->
        <Style x:Key="MockupDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Mockup.Bg.Body}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mockup.Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Mockup.Border}" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource E3g.Brush.SurfaceSubtle}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource Mockup.Bg.PanelAlt}" />
                        <Setter Property="Foreground" Value="{DynamicResource Mockup.Text.Soft}" />
                        <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Mockup.Border}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Mockup.Bg.RowSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Mockup.Text}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             TextBox estilo mockup
             ============================================================ -->
        <Style x:Key="MockupTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mockup.Border.Strong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="MockupComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <!-- ============================================================
             Mini-buttons del editor
             ============================================================ -->
        <Style x:Key="GhostMiniButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>

    </Window.Resources>

    <!-- Border exterior: esquinas redondeadas + sombra (chrome custom).
         El margen deja ver la sombra; E3gTitleBar lo ajusta al maximizar. -->
    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>

        <!-- Recorta el contenido a las esquinas redondeadas (sigue al ChromeRoot
             al maximizar via binding del CornerRadius). -->
        <Border x:Name="ChromeClip"
                CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>

        <DockPanel LastChildFill="True">

        <!-- ================= BARRA DE TITULO custom (Fluent Light) ================= -->
        <e3gc:E3gTitleBar x:Name="TitleBar"
                          DockPanel.Dock="Top"
                          Title="e3gbimtools"
                          Subtitle="&#8212;  Revit &#8594; BC3"
                          StatusText="Revit conectado" />

        <!-- Breadcrumb de modulo -->
        <Border DockPanel.Dock="Top" Padding="16,8" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Inicio" FontSize="12"
                           Foreground="{DynamicResource E3g.Brush.TextSoft}" VerticalAlignment="Center" />
                <TextBlock Text="&#8250;" FontSize="13" Margin="8,0"
                           Foreground="{DynamicResource E3g.Brush.TextSoft}" VerticalAlignment="Center" />
                <Border CornerRadius="6" Padding="9,3"
                        Background="{DynamicResource E3g.Brush.Primary}" VerticalAlignment="Center">
                    <TextBlock Text="Mediciones BC3" FontSize="11" FontWeight="SemiBold"
                               Foreground="White" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ================= TOOLBAR superior ================= -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Mockup.Bg.Header}"
                BorderBrush="{DynamicResource Mockup.Border}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Acciones izquierda -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="ImportButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="OnImportClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Importar BC3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="OnClearClick"
                            IsEnabled="False"
                            ToolTip="Descarga el BC3 actual de la sesion (las reglas se mantienen).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Limpiar BC3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="SaveRulesButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="OnSaveRulesClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Guardar mapeo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LoadRulesButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="OnLoadRulesClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Cargar mapeo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveRulesLegacyButton"
                            Content="Legacy"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Exportar el mapeo en formato V1 (sin Chapters/SubChapters como entidades). Util para compatibilidad temporal con versiones anteriores del modulo."
                            Click="OnSaveRulesLegacyClick" />
                    <Border Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="CalculateButton"
                            Style="{StaticResource ToolbarButton.Amber}"
                            Click="OnCalculateClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Mockup.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Calcular mediciones" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Centro: badge del archivo BC3 cargado -->
                <Border Grid.Column="1"
                        x:Name="HeaderBC3Badge"
                        Style="{StaticResource Badge}"
                        Background="{DynamicResource E3g.Brush.Primary}"
                        BorderBrush="{DynamicResource E3g.Brush.Primary}"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="HeaderBC3Text"
                               FontSize="11"
                               FontFamily="{StaticResource Mockup.Mono}"
                               Foreground="White"
                               Text="" />
                </Border>

                <!-- Acciones derecha -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PrepareIfcButton"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Escribe los parámetros E3G_BC3_Code/Quantity en los elementos Revit para que aparezcan en el IFC al exportar. Ejecutar ANTES de exportar a IFC desde Revit."
                            Click="OnPrepareIfcClick"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Preparar IFC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="ExportButton"
                            Style="{StaticResource ToolbarButton.Green}"
                            Click="OnExportClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Mockup.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Exportar BC3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ValidateExportButton"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Valida el último BC3 y .bimlink.json exportados: GUIDs IFC, códigos de partida, suma de cantidades y cobertura."
                            Click="OnValidateExportClick"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Validar exportación" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenExportFolderButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="OnOpenExportFolderClick"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource Mockup.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Abrir carpeta" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= STATUS BAR inferior ================= -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Mockup.Bg.Header}"
                BorderBrush="{DynamicResource Mockup.Border}"
                BorderThickness="0,1,0,0"
                Height="26">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Ellipse x:Name="RevitStatusDot" Width="8" Height="8" Fill="{DynamicResource Mockup.Accent.Green}" VerticalAlignment="Center" />
                <TextBlock x:Name="RevitStatusText"
                           Margin="6,0,16,0"
                           FontSize="11"
                           FontFamily="{StaticResource Mockup.Mono}"
                           Foreground="{DynamicResource Mockup.Text.Muted}"
                           VerticalAlignment="Center"
                           Text="Revit API conectado" />
                <Border Width="1" Background="{DynamicResource Mockup.Border}" Margin="0,4" />
                <TextBlock x:Name="StatusBC3Text"
                           Margin="16,0"
                           FontSize="11"
                           FontFamily="{StaticResource Mockup.Mono}"
                           Foreground="{DynamicResource Mockup.Text.Muted}"
                           VerticalAlignment="Center"
                           Text="Sin BC3 cargado" />
                <Border Width="1" Background="{DynamicResource Mockup.Border}" Margin="0,4" />
                <TextBlock x:Name="StatusRulesText"
                           Margin="16,0"
                           FontSize="11"
                           FontFamily="{StaticResource Mockup.Mono}"
                           Foreground="{DynamicResource Mockup.Text.Muted}"
                           VerticalAlignment="Center"
                           Text="Sin reglas" />
                <Border Width="1" Background="{DynamicResource Mockup.Border}" Margin="0,4" />
                <TextBlock x:Name="StatusOrphansText"
                           Margin="16,0"
                           FontSize="11"
                           FontFamily="{StaticResource Mockup.Mono}"
                           Foreground="{DynamicResource Mockup.Accent.Amber}"
                           VerticalAlignment="Center"
                           Text="" />
                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           FontFamily="{StaticResource Mockup.Mono}"
                           Foreground="{DynamicResource Mockup.Text.Soft}"
                           Margin="16,0">
                    <Run>e3gbimtools Â· Revit → BC3</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================= FRANJA INFERIOR: Previsualizacion ================= -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Mockup.Bg.Panel}"
                BorderBrush="{DynamicResource Mockup.Border}"
                BorderThickness="0,2,0,0"
                Height="240">
            <DockPanel>

                <!-- Header de la franja con KPIs -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Mockup.Bg.Header}"
                        BorderBrush="{DynamicResource Mockup.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PanelHeaderLabel}"
                                       Text="Previsualización de mediciones"
                                       VerticalAlignment="Center" />

                            <Border Width="1" Background="{DynamicResource Mockup.Border}" Margin="14,2" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="KpiPartidasValue"
                                           FontFamily="{StaticResource Mockup.Mono}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mockup.Accent.Blue}"
                                           Text="0" />
