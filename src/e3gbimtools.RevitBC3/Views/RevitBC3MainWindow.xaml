                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       x:Name="RulesSummaryText"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource Mockup.Text.Muted}"
                                       VerticalAlignment="Center"
                                       Text="Sin reglas. Pulsa 'ï¼‹ Nueva regla' para empezar." />
                            <TextBlock Grid.Column="1"
                                       x:Name="MappingBC3InfoText"
                                       FontSize="11"
                                       Foreground="{DynamicResource Mockup.Text.Muted}"
                                       VerticalAlignment="Center"
                                       Text="" />
                        </Grid>
                    </Border>

                    <!-- Contenido: o reglas o huerfanos -->
