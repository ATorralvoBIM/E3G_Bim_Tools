                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mockup.Accent.Blue}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="MEDIR" Binding="{Binding MeasurementSummary}" Width="1*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mockup.Accent.Green}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="FACTOR" Binding="{Binding UnitFactor}" Width="60" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mockup.Text.Muted}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding ValidationStatus}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mockup.Text.Muted}" />
                                            <Style.Triggers>
                                                <!-- Sprint A: resaltar el aviso de duplicado de partida. -->
                                                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.WarningText}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="ToolTip" Value="{Binding ConflictTooltip}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>

                            <!-- Sprint A — pintar las filas con conflicto de partida duplicada
                                 con un fondo ambar suave y un tooltip que explica la colision. -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource E3g.Brush.WarningBg}" />
                                            <Setter Property="ToolTip" Value="{Binding ConflictTooltip}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- Tabla de huerfanos (oculta hasta seleccionar el sub-tab) -->
                        <DataGrid x:Name="OrphansGrid"
                                  Style="{StaticResource MockupDataGrid}"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CATEGORÃA" Binding="{Binding CategoryDisplayName}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource Mockup.Mono}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mockup.Accent.Amber}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TIPO / FAMILIA" Binding="{Binding TypeOrFamilyName}" Width="3*" />
                                <DataGridTextColumn Header="CUENTA" Binding="{Binding Count}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- =============== Splitter centro/derecha =============== -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- =============== PANEL DERECHO: editor de regla (colapsable) =============== -->
            <Border Grid.Column="4"
                    Background="{DynamicResource Mockup.Bg.Panel}"
                    BorderBrush="{DynamicResource Mockup.Border}"
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <DockPanel>

                    <!-- Header -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource Mockup.Bg.Header}"
                            BorderBrush="{DynamicResource Mockup.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="EditorTitle"
                                           Text="Editar regla"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mockup.Text}" />
                                <TextBlock x:Name="EditorSubtitle"
                                           Text=""
                                           FontFamily="{StaticResource Mockup.Mono}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Mockup.Text.Soft}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    x:Name="EditorActiveBadge"
                                    Style="{StaticResource Badge}"
                                    Background="{DynamicResource E3g.Brush.Primary}"
                                    BorderBrush="{DynamicResource E3g.Brush.Primary}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0">
                                <TextBlock Text="Activa"
                                           FontFamily="{StaticResource Mockup.Mono}"
                                           FontSize="10"
                                           Foreground="White" />
                            </Border>
                            <Button Grid.Column="2"
                                    x:Name="CloseEditorButton"
                                    Content="âœ•"
                                    Style="{StaticResource GhostMiniButton}"
                                    Click="OnCloseEditorClick"
                                    ToolTip="Cerrar panel de edicion" />
                        </Grid>
                    </Border>

                    <!-- Footer con botones -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource Mockup.Bg.Header}"
                            BorderBrush="{DynamicResource Mockup.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Cancelar"
                                    Style="{StaticResource ToolbarButton}"
                                    Margin="0,0,6,0"
                                    Click="OnCloseEditorClick" />
                            <Button Grid.Column="1"
                                    x:Name="SaveRuleEditorButton"
                                    Content="Guardar regla"
                                    Style="{StaticResource ToolbarButton.Primary}"
                                    Click="OnSaveRuleEditorClick" />
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel>

                            <!-- Categoria Revit -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CATEGORÃA REVIT" />
                            <ComboBox x:Name="EditorCategoryCombo"
                                      Style="{StaticResource MockupComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnEditorCategoryChanged" />
                            <Border Height="10" />

                            <!-- Nombre + capitulo -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NOMBRE (OPCIONAL)" />
                            <TextBox x:Name="EditorNameBox" Style="{StaticResource MockupTextBox}" />
                            <Border Height="10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CAP. CÓDIGO" />
                                    <TextBox x:Name="EditorChapterCodeBox" Style="{StaticResource MockupTextBox}" Width="60" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CAP. NOMBRE" />
                                    <ComboBox x:Name="EditorChapterNameCombo"
                                              Style="{StaticResource MockupComboBox}"
                                              IsEditable="True" />
                                </StackPanel>
                            </Grid>
                            <Border Height="8" />

                            <!-- Subcapitulo (issue #4) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SUBCAP. CÓDIGO" />
                                    <TextBox x:Name="EditorSubChapterCodeBox"
                                             Style="{StaticResource MockupTextBox}"
                                             Width="60"
                                             ToolTip="Opcional. Si se deja vacio, la partida cuelga directamente del capitulo." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SUBCAP. NOMBRE" />
                                    <ComboBox x:Name="EditorSubChapterNameCombo"
                                              Style="{StaticResource MockupComboBox}"
                                              IsEditable="True"
                                              ToolTip="Opcional. Permite anidar Capitulo > Subcapitulo > Partida." />
                                </StackPanel>
                            </Grid>
                            <Border Height="12" />

                            <!-- Partida BC3 -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PARTIDA BC3" />
                            <ComboBox x:Name="EditorBC3CodeCombo"
                                      Style="{StaticResource MockupComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Code"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      SelectionChanged="OnEditorBC3CodeChanged" />
                            <Border Height="12" />

                            <!-- Filtros multi-parametro -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="FILTROS MULTI-PARÃMETRO (AND)" />
                            <ItemsControl x:Name="EditorFiltersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      Style="{StaticResource MockupComboBox}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=EditorParameterOptions}"
                                                      Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      StaysOpenOnEdit="True" />
                                            <ComboBox Grid.Column="2"
                                                      Style="{StaticResource MockupComboBox}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OperatorOptions}"
                                                      SelectedItem="{Binding Operator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="4"
                                                      Style="{StaticResource MockupComboBox}"
                                                      ItemsSource="{Binding AvailableValues}"
                                                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      StaysOpenOnEdit="True" />
                                            <Button Grid.Column="6"
                                                    Content="âœ•"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource Mockup.Text.Soft}"
                                                    Cursor="Hand"
                                                    Click="OnEditorRemoveFilterClick"
                                                    Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Añadir filtro"
                                    Margin="0,4,0,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Mockup.Border.Strong}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource Mockup.Text.Muted}"
                                    Padding="6,5"
                                    Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    Click="OnEditorAddFilterClick" />
                            <Border Height="12" />

                            <!-- Parametro de medicion -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PARÃMETRO DE MEDICIÓN" />
                            <ComboBox x:Name="EditorMeasurementCombo"
                                      Style="{StaticResource MockupComboBox}" />
                            <Border Height="10" />

                            <!-- Factor + prioridad + activa -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="FACTOR" />
                                    <TextBox x:Name="EditorFactorBox" Style="{StaticResource MockupTextBox}" Text="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PRIORIDAD" />
                                    <TextBox x:Name="EditorPriorityBox" Style="{StaticResource MockupTextBox}" Text="100" />
                                </StackPanel>
                            </Grid>
                            <Border Height="10" />

                            <CheckBox x:Name="EditorEnabledCheck" Content="Regla activa" IsChecked="True" FontSize="12" />
                            <Border Height="10" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="NOTAS" />
                            <TextBox x:Name="EditorNotesBox"
                                     Style="{StaticResource MockupTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="50"
                                     VerticalScrollBarVisibility="Auto" />

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

        </Grid>

    </DockPanel>
        </Border>
    </Border>
</Window>
