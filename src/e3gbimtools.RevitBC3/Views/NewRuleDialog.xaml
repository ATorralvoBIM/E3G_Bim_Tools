<Window
    x:Class="E3G.BimTools.RevitBC3.Views.NewRuleDialog"
    x:Name="DialogRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls;assembly=e3gbimtools.DiTools.UI"
    Title="e3gbimtools — Nueva regla"
    Width="760" Height="680"
    MinWidth="640" MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Nueva regla"
                                  ShowStatus="False"
                                  ShowMinimize="False" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{DynamicResource E3g.Style.H2}" Text="Nueva regla de mapeo" />

        <!-- Nombre descriptivo (Sprint A2 mejora) -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Nombre regla:" />
            <TextBox Grid.Column="1" x:Name="NameBox" />
        </Grid>

        <!-- Capitulo (codigo + nombre) -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Capitulo BC3:" />
            <TextBox Grid.Column="1" x:Name="ChapterCodeBox" ToolTip="Codigo (ej: 01)" />
            <ComboBox Grid.Column="3"
                      x:Name="ChapterNameCombo"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      ToolTip="Nombre del capitulo (ej: Acometida)" />
        </Grid>

        <!-- Categoria Revit -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Categoria Revit:" />
            <ComboBox Grid.Column="1"
                      x:Name="CategoryCombo"
                      SelectionChanged="OnCategoryChanged"
                      DisplayMemberPath="DisplayName" />
        </Grid>

        <!-- Filtros -->
        <GroupBox Grid.Row="4" Header="Filtros (todos deben cumplirse — AND)" Margin="0,12,0,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          x:Name="FiltersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="{DynamicResource E3g.Brush.Border}"
                          BorderThickness="1">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Parametro" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ParameterName}" Margin="6,2" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ElementName=DialogRoot, Path=ParameterOptions}"
                                              Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Operador" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Operator}" Margin="6,2" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ElementName=DialogRoot, Path=OperatorOptions}"
                                              SelectedItem="{Binding Operator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Valor" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" Margin="6,2" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableValues}"
                                              Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Anadir filtro"
                            Style="{DynamicResource E3g.Style.Button.Secondary}"
                            Click="OnAddFilter" />
                    <Button Content="Quitar filtro seleccionado"
                            Style="{DynamicResource E3g.Style.Button.Secondary}"
                            Margin="8,0,0,0"
                            Click="OnRemoveFilter" />
                    <TextBlock Style="{DynamicResource E3g.Style.Muted}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontStyle="Italic"
                               Text="Doble-click sobre una celda para editar.  El valor sugiere lo que existe en el modelo." />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Codigo BC3 + prioridad -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Partida BC3:" />
            <ComboBox Grid.Column="1"
                      x:Name="BC3CodeCombo"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Code"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Prio:" />
            <TextBox Grid.Column="4" x:Name="PriorityBox" Text="100" Margin="6,0,0,0" />
        </Grid>

        <!-- Medicion + factor -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Medir por:" />
            <ComboBox Grid.Column="1" x:Name="MeasurementCombo" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Factor:" />
            <TextBox Grid.Column="4" x:Name="FactorBox" Text="1" Margin="6,0,0,0" />
        </Grid>

        <!-- Notas + botones -->
        <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Text="Notas:" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NotesBox"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="48" VerticalScrollBarVisibility="Auto" />

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar"
                        Style="{DynamicResource E3g.Style.Button.Secondary}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button Content="Guardar regla"
                        Style="{DynamicResource E3g.Style.Button.Primary}"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
