<Window
    x:Class="E3G.BimTools.RevitBC3.Views.ChapterEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:e3gc="clr-namespace:E3G.BimTools.DiTools.UI.Controls;assembly=e3gbimtools.DiTools.UI"
    Title="e3gbimtools — Capítulo"
    Width="420" Height="260"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Lato, Segoe UI"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ChromeRoot"
            CornerRadius="10"
            Background="{DynamicResource E3g.Brush.Background}"
            BorderBrush="{DynamicResource E3g.Brush.Border}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>
        <Border x:Name="ChromeClip" CornerRadius="{Binding CornerRadius, ElementName=ChromeRoot}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Background="White"
                                CornerRadius="{Binding CornerRadius, ElementName=ChromeClip}"
                                Width="{Binding ActualWidth, ElementName=ChromeClip}"
                                Height="{Binding ActualHeight, ElementName=ChromeClip}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <DockPanel LastChildFill="True">
                <e3gc:E3gTitleBar x:Name="TitleBar"
                                  DockPanel.Dock="Top"
                                  Title="e3gbimtools"
                                  Subtitle="Capítulo"
                                  ShowStatus="False"
                                  ShowMinimize="False"
                                  ShowMaximize="False" />
    <DockPanel LastChildFill="True" Margin="16,14">
        <TextBlock x:Name="TitleText"
                   DockPanel.Dock="Top"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource E3g.Brush.Text}"
                   Margin="0,0,0,12"
                   Text="Nuevo capitulo" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancelar"
                    Width="90" Height="28"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="OkButton"
                    Content="Aceptar"
                    Width="90" Height="28"
                    IsDefault="True"
                    Background="{DynamicResource E3g.Brush.Accent}"
                    Foreground="White"
                    BorderBrush="{DynamicResource E3g.Brush.Accent}"
                    Click="OnOkClick" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="CODIGO" FontSize="10" Foreground="{DynamicResource E3g.Brush.TextMuted}" FontFamily="Consolas" Margin="0,0,0,3" />
            <TextBox x:Name="CodeBox"
                     FontSize="12"
                     Padding="8,5"
                     BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                     Margin="0,0,0,10" />

            <TextBlock Text="NOMBRE" FontSize="10" Foreground="{DynamicResource E3g.Brush.TextMuted}" FontFamily="Consolas" Margin="0,0,0,3" />
            <TextBox x:Name="NameBox"
                     FontSize="12"
                     Padding="8,5"
                     BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" />
        </StackPanel>
    </DockPanel>
            </DockPanel>
        </Border>
    </Border>
</Window>
