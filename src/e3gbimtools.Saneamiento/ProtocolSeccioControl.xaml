<UserControl x:Class="E3G.Saneamiento.ProtocolSeccioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Estilo E3G: los estilos BtnLink vienen de AjustesWindow (DynamicResource). -->
    <Border Background="{DynamicResource E3g.Brush.SurfaceSubtle}" CornerRadius="8" Padding="12,10" Margin="0,0,0,4"
            BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTitol" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource E3g.Brush.TextMuted}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+ Añadir regla"
                        Style="{DynamicResource BtnLink}" Click="BtnAfegir_Click"/>
            </Grid>

            <ItemsControl x:Name="LstRegles">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource E3g.Brush.Card}" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"
                                               FontSize="11" Foreground="{DynamicResource E3g.Brush.Text}"/>
                                    <TextBlock Text="{Binding Resum}" FontSize="10"
                                               Foreground="{DynamicResource E3g.Brush.TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Editar" Style="{DynamicResource BtnLink}"
                                            Margin="0,0,2,0" Click="BtnEditar_Click"
                                            Tag="{Binding}" ToolTip="Editar la regla"/>
                                    <Button Content="Eliminar" Style="{DynamicResource BtnLink}"
                                            Foreground="{DynamicResource E3g.Brush.ErrorText}"
                                            Click="BtnEliminar_Click"
                                            Tag="{Binding}" ToolTip="Eliminar la regla"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtBuit"
                       Text="Sin reglas. Pulsa «+ Añadir regla» o usa «Autodetectar»."
                       FontSize="11" Foreground="{DynamicResource E3g.Brush.TextSoft}" Margin="0,2,0,2"/>
        </StackPanel>
    </Border>
</UserControl>