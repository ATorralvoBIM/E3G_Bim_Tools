<Page x:Class="E3G.Saneamiento.SaneamientoWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:E3G.Saneamiento"
      Background="{DynamicResource E3g.Brush.Background}">

    <!-- Saneamiento HS5 — estilo E3G de DiTools (2026-11-07): tarjetas planas con
         borde fino (sin sombras neumorficas), botones de toolbar con glifos Lucide
         y barra de estado con progreso del analisis. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/e3gbimtools.DiTools.UI;component/Themes/E3gTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tarjeta plana E3G -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource E3g.Brush.Card}" />
                <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.BorderSubtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Etiquetas -->
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Text}" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <!-- Texto dentro de un boton: el estilo implicito de TextBlock del tema fija
                 Foreground/FontSize, asi que se re-enlaza al Foreground del boton. -->
            <Style x:Key="BtnText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Style>

            <!-- Glifo Lucide dentro de un boton: hereda el Foreground -->
            <Style x:Key="Glyph" TargetType="Path" BasedOn="{StaticResource E3g.Style.LucideGlyph}">
                <Setter Property="StrokeThickness" Value="2.2" />
            </Style>

            <!-- Pestañas: subrayado de marca -->
            <Style x:Key="TabBtn" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.Primary}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Primary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Selector de tabla: campo con borde (como un ComboBox E3G) -->
            <Style x:Key="SelectorBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource E3g.Brush.SurfaceSubtle}"
                                    BorderBrush="{DynamicResource E3g.Brush.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource E3g.Brush.Accent}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource E3g.Brush.Card}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Barra de progreso E3G (pista sutil + relleno de marca) -->
            <Style x:Key="E3gProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Primary}"/>
                <Setter Property="Background" Value="{DynamicResource E3g.Brush.BorderSubtle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tablas de resultados -->
            <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource E3g.Brush.SurfaceSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,12,12,4">

                <!-- CABECERA -->
                <DockPanel Margin="2,0,2,10">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource E3g.Brush.BrandTint}" CornerRadius="4"
                            Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="CTE DB-HS5" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Primary}"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Saneamiento" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Text}"/>
                        <TextBlock Text="Verificación de diámetros de la red de evacuación" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </DockPanel>

                <!-- PESTAÑAS -->
                <Border BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabVerificacion" Content="Verificación"
                                     Style="{StaticResource TabBtn}" IsChecked="True"
                                     Checked="TabVerificacion_Checked"/>
                        <RadioButton x:Name="TabAjustes" Content="Aparatos y ajustes"
                                     Style="{StaticResource TabBtn}"
                                     Checked="TabAjustes_Checked"/>
                        <RadioButton x:Name="TabEsquema" Content="Esquema de principio (WIP)"
                                     Style="{StaticResource TabBtn}"
                                     Checked="TabEsquema_Checked"/>
                    </StackPanel>
                </Border>

                <!-- SELECTOR TABLA HS5 -->
                <Border x:Name="SelectorNormativa" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Tabla" Style="{StaticResource Label}" Width="66"/>
                            <Button Style="{StaticResource SelectorBtn}" Click="BtnNormativa_Click">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="NormChevron" Text="▼"
                                               FontSize="9" Foreground="{DynamicResource E3g.Brush.TextMuted}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock x:Name="NormTitulo" Text="Tabla 4.5 CTE DB-HS5"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Text}"/>
                                        <TextBlock x:Name="NormSubtitulo" Text="Colectores horizontales"
                                                   FontSize="10" Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DockPanel>

                        <!-- Columna de la tabla: pendiente (del modelo o fija) o nº de plantas -->
                        <DockPanel x:Name="FilaPendiente" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Pendiente" Style="{StaticResource Label}" Width="66"/>
                            <WrapPanel x:Name="OpcionesPendiente"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtPluviometriaVerif" FontSize="10" Foreground="{DynamicResource E3g.Brush.WarningText}"
                                   TextWrapping="Wrap" Margin="66,6,0,0"/>
                        <DockPanel x:Name="FilaAltura" Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Bajantes" Style="{StaticResource Label}" Width="66"/>
                            <WrapPanel x:Name="OpcionesAltura"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- DESPLEGABLE TABLAS (se rellena desde Hs5Tablas.Verificacion) -->
                <Border x:Name="NormDropdown" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <StackPanel x:Name="NormDropdownItems"/>
                </Border>

                <!-- TAB VERIFICACIÓN -->
                <StackPanel x:Name="PanelVerificacion">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Analizadas" Style="{StaticResource KpiLabel}"/>
                                <TextBlock x:Name="CardTotal" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Text}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Correctas" Style="{StaticResource KpiLabel}"/>
                                <TextBlock x:Name="CardOk" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Success}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="A corregir" Style="{StaticResource KpiLabel}"/>
                                <TextBlock x:Name="CardKo" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Error}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="AvisosBox" Background="{DynamicResource E3g.Brush.WarningBg}" CornerRadius="6" Padding="10,7" Margin="0,0,0,10"
                            Visibility="{Binding Visibility, ElementName=TxtAvisos}">
                        <TextBlock x:Name="TxtAvisos" Visibility="Collapsed" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource E3g.Brush.WarningText}"/>
                    </Border>

                    <!-- Leyenda -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="LeyendaTitulo" Text="Leyenda — DN exigido por la tabla"
                                       Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <UniformGrid x:Name="LeyendaGrid" Columns="4"/>
                        </StackPanel>
                    </Border>

                    <!-- Grupo OK -->
                    <Border x:Name="GrupoOkBorder" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" ClipToBounds="True">
                        <StackPanel>
                            <Border Padding="14,10" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="GrupoOk_Click">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="ArrowOk" Text="▶"
                                               FontSize="9" Foreground="{DynamicResource E3g.Brush.TextMuted}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4 12 14.01l-3-3" StrokeThickness="2.2"
                                                      Stroke="{DynamicResource E3g.Brush.Success}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Diámetro correcto" Style="{StaticResource SectionTitle}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="{DynamicResource E3g.Brush.SuccessBg}" CornerRadius="4" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="BadgeOk" Text="0 segmentos" FontSize="10"
                                                       Foreground="{DynamicResource E3g.Brush.SuccessText}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="BodyOk" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                                <DataGrid x:Name="TablaOk" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0"
                                          Background="{DynamicResource E3g.Brush.Card}" RowBackground="{DynamicResource E3g.Brush.Card}"
                                          FontSize="11" MaxHeight="220" ColumnHeaderStyle="{StaticResource GridHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"        Binding="{Binding IdStr}"      Width="70"/>
                                        <DataGridTextColumn Header="Tramo"     Binding="{Binding TramoStr}"    Width="70"/>
                                        <DataGridTextColumn Header="DN"        Binding="{Binding DNActualStr}" Width="50"/>
                                        <DataGridTextColumn Header="UD"        Binding="{Binding UDStr}"       Width="50"/>
                                        <DataGridTextColumn Header="Pend."     Binding="{Binding PendStr}"     Width="50"/>
                                        <DataGridTextColumn Header="DN HS5"    Binding="{Binding DNHs5Str}"    Width="90"/>
                                        <DataGridTemplateColumn Header="Criterio" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="12" Height="12" CornerRadius="2" Background="{Binding ColorHex}" Margin="2,0,5,0"/>
                                                        <TextBlock Text="{Binding Criterio}" TextWrapping="Wrap" ToolTip="{Binding Criterio}" FontSize="11" Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Grupo KO -->
                    <Border x:Name="GrupoKoBorder" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
                        <StackPanel>
                            <Border Padding="14,10" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="GrupoKo_Click">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="ArrowKo" Text="▶"
                                               FontSize="9" Foreground="{DynamicResource E3g.Brush.TextMuted}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M22 12a10 10 0 1 1-20 0 10 10 0 1 1 20 0z M12 8v4 M12 16h.01" StrokeThickness="2.2"
                                                      Stroke="{DynamicResource E3g.Brush.Error}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Necesitan corrección" Style="{StaticResource SectionTitle}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="{DynamicResource E3g.Brush.ErrorBg}" CornerRadius="4" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="BadgeKo" Text="0 segmentos" FontSize="10"
                                                       Foreground="{DynamicResource E3g.Brush.ErrorText}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="BodyKo" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                                <DataGrid x:Name="TablaKo" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0"
                                          Background="{DynamicResource E3g.Brush.Card}" RowBackground="{DynamicResource E3g.Brush.Card}"
                                          FontSize="11" MaxHeight="220" ColumnHeaderStyle="{StaticResource GridHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"        Binding="{Binding IdStr}"      Width="70"/>
                                        <DataGridTextColumn Header="Tramo"     Binding="{Binding TramoStr}"    Width="70"/>
                                        <DataGridTextColumn Header="DN"        Binding="{Binding DNActualStr}" Width="50"/>
                                        <DataGridTextColumn Header="UD"        Binding="{Binding UDStr}"       Width="50"/>
                                        <DataGridTextColumn Header="Pend."     Binding="{Binding PendStr}"     Width="50"/>
                                        <DataGridTextColumn Header="DN HS5"    Binding="{Binding DNHs5Str}"    Width="90"/>
                                        <DataGridTemplateColumn Header="Criterio" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="12" Height="12" CornerRadius="2" Background="{Binding ColorHex}" Margin="2,0,5,0"/>
                                                        <TextBlock Text="{Binding Criterio}" TextWrapping="Wrap" ToolTip="{Binding Criterio}" FontSize="11" Foreground="{DynamicResource E3g.Brush.ErrorText}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Acciones (toolbar E3G) -->
                    <TextBlock Text="Acciones" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{StaticResource E3g.Style.Toolbar.Primary}" Click="BtnAnalizar_Click" Margin="0,0,6,6"
                                ToolTip="Selecciona tuberías en Revit y verifica la red conectada">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="M6 3 20 12 6 21z"/></Canvas></Viewbox>
                                <TextBlock Text="Iniciar análisis" Style="{StaticResource BtnText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource E3g.Style.Toolbar.Tint}" Click="BtnActualizar_Click" Margin="0,0,6,6"
                                ToolTip="Vuelve a analizar la selección del último análisis con los ajustes actuales">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5"/></Canvas></Viewbox>
                                <TextBlock Text="Actualizar" Style="{StaticResource BtnText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource E3g.Style.Toolbar.Tint}" Click="BtnAplicarDN_Click" Margin="0,0,6,6"
                                ToolTip="Redimensiona al DN exigido las tuberías que necesitan corrección">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="M15 3h6v6 M9 21H3v-6 M21 3l-7 7 M3 21l7-7"/></Canvas></Viewbox>
                                <TextBlock Text="Aplicar DN HS5" Style="{StaticResource BtnText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource E3g.Style.Toolbar.Ghost}" Click="BtnTabla_Click" Margin="0,0,6,6"
                                ToolTip="Valores de referencia de las tablas CTE DB-HS5">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M12 3v18 M3 9h18 M3 15h18"/></Canvas></Viewbox>
                                <TextBlock Text="Ver tablas" Style="{StaticResource BtnText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource E3g.Style.Toolbar.Ghost}" Click="BtnRestaurar_Click" Margin="0,0,6,6"
                                ToolTip="Quita la sobrescritura de color de la vista">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="M7 21 2.7 16.7c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21 M22 21H7 M5 11l9 9"/></Canvas></Viewbox>
                                <TextBlock Text="Restaurar colores" Style="{StaticResource BtnText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource E3g.Style.Toolbar.Ghost}" Click="BtnExportar_Click" Margin="0,0,6,6"
                                ToolTip="CSV para Excel con todos los tramos">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Glyph}" Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3"/></Canvas></Viewbox>
                                <TextBlock Text="Exportar informe" Style="{StaticResource BtnText}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- TAB APARATOS Y AJUSTES HS5 -->
                <StackPanel x:Name="PanelAjustes" Visibility="Collapsed">

                    <!-- Aparatos sanitarios: mapeo familia|tipo → tabla 4.1 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Aparatos sanitarios · tabla 4.1" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Cada tipo de aparato del modelo se asigna a una fila de la tabla 4.1 (Ø mínimo de la derivación). La UD la da el parámetro de la familia y de ella se deduce el uso; si no lo tiene, se usa el uso elegido. La propuesta automática se basa en el nombre de familia y tipo; el mapeo se guarda con la app."
                                       Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Uso" Style="{StaticResource Label}" Width="66"/>
                                <WrapPanel x:Name="OpcionesUso"/>
                            </DockPanel>
                            <Button Style="{StaticResource E3g.Style.Toolbar.Primary}" Click="BtnLeerAparatos_Click"
                                    HorizontalAlignment="Left" Margin="0,0,0,8"
                                    ToolTip="Lista los tipos de aparato sanitario del proyecto">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Glyph}" Data="M21 21l-4.34-4.34 M19 11a8 8 0 1 1-16 0 8 8 0 1 1 16 0z"/></Canvas></Viewbox>
                                    <TextBlock Text="Leer aparatos del modelo" Style="{StaticResource BtnText}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtAparatosEstado" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <StackPanel x:Name="ListaAparatos"/>
                        </StackPanel>
                    </Border>

                    <!-- Pluviometria y criterios -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pluviometría del proyecto · Anejo B" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Zona" Style="{StaticResource Label}" Width="66"/>
                                <WrapPanel x:Name="OpcionesZona"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Isoyeta" Style="{StaticResource Label}" Width="66"/>
                                <ComboBox x:Name="CmbIsoyeta" Width="80" HorizontalAlignment="Left" FontSize="11"
                                          SelectionChanged="CmbIsoyeta_SelectionChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtIntensidad" FontSize="11" Foreground="{DynamicResource E3g.Brush.Primary}" Margin="66,0,0,6" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ChkSuperficieEnUD" FontSize="11" Foreground="{DynamicResource E3g.Brush.Text}" Margin="0,0,0,10"
                                      Content="Pluviales: el parámetro de UD contiene la superficie de recogida (m²)"
                                      Checked="ChkSuperficieEnUD_Changed" Unchecked="ChkSuperficieEnUD_Changed"/>

                            <TextBlock Text="Criterios" Style="{StaticResource SectionTitle}" Margin="0,4,0,6"/>
                            <CheckBox x:Name="ChkNoDisminuir" FontSize="11" Foreground="{DynamicResource E3g.Brush.Text}"
                                      Content="El diámetro no disminuye aguas abajo (4.1.1.1-4)"
                                      Checked="ChkNoDisminuir_Changed" Unchecked="ChkNoDisminuir_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Parámetros y sistemas -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Parámetros del modelo" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <Grid x:Name="GridParametros">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock Text="Sistemas · palabras clave en el tipo de sistema, separadas por comas"
                                       Style="{StaticResource SectionTitle}" Margin="0,12,0,8" TextWrapping="Wrap"/>
                            <Grid x:Name="GridSistemas">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Calculadora de cubierta (tablas 4.6 y 4.7) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Cubiertas · sumideros (4.6) y canalones (4.7)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Superficie (m²)" Style="{StaticResource Label}" Width="110"/>
                                <TextBox x:Name="TxtSupCubierta" FontSize="11" Padding="6,3" BorderBrush="{DynamicResource E3g.Brush.Border}"
                                         TextChanged="TxtSupCubierta_TextChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtCubierta" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Los ajustes se guardan por usuario en %APPDATA%\E3G\Saneamiento\hs5.json"
                               FontSize="10" Foreground="{DynamicResource E3g.Brush.TextSoft}" TextWrapping="Wrap" Margin="4,0,4,8"/>
                </StackPanel>

                <StackPanel x:Name="PanelEsquema" Visibility="Collapsed" Margin="0,0,0,10">
                    <local:EsquemaPrincipiControl x:Name="tabEsquema"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- BARRA DE ESTADO (como las apps de DiTools): estado + progreso del análisis -->
        <Border Grid.Row="1" Background="{DynamicResource E3g.Brush.Card}"
                BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Listo · selecciona tuberías en Revit e inicia el análisis"
                           FontSize="11" FontStyle="Italic" Foreground="{DynamicResource E3g.Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel x:Name="ProgressPanel" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" FontSize="11" Foreground="{DynamicResource E3g.Brush.Text}"
                               VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="44" TextAlignment="Right"/>
                    <ProgressBar x:Name="ProgressAnalisis" Style="{StaticResource E3gProgress}" Width="160"
                                 Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
