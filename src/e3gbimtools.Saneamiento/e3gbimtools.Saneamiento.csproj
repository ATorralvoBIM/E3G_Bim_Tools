<Project Sdk="Microsoft.NET.Sdk">

  <!-- =====================================================================
       Saneamiento (HS5 + Fontaneria + Ajustes/Partidas BC3 + Esquema de
       principio).  Codigo migrado desde el monolito de la raiz del repo
       (E3G_Saneamiento.csproj, retirado el 2026-11-07).

       NO es un add-in propio: lo carga e3gbimtools.DiTools por reflexion
       (DiTools/Bootstrap/SaneamientoBridge.cs), que registra sus paneles
       acoplables y crea el panel «Saneamiento» como primera app de la
       pestania «e3gbimtools».

       Version de Revit destino: SanRevitVersion (propiedad PROPIA para no
       propagarse a DiTools.UI/Core, que siguen compilando net8 contra 2025).
         2025 (default) -> net8.0-windows  contra E:\APPS\Autodesk\Revit 2025
         2026           -> net10.0-windows contra E:\Autodesk\Revit 2026
       Revit 2026 (26.5) corre sobre .NET 10; el codigo usa la API de 2026
       (enums Int64), por eso no se compila net8 contra 2025 como DiTools.
       ===================================================================== -->

  <PropertyGroup>
    <AssemblyName>e3gbimtools.Saneamiento</AssemblyName>
    <RootNamespace>E3G.Saneamiento</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Copia QuestPDF / OpenXml (y los nativos de QuestPDF) junto a la DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Codigo legacy: sin nullable ni implicit usings (como el monolito). -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);MSB3277;CS0618;CS8632;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS0067</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <SanRevitVersion Condition="'$(SanRevitVersion)' == ''">2025</SanRevitVersion>
    <SanRevitDir Condition="'$(SanRevitDir)' == '' And '$(SanRevitVersion)' == '2025'">E:\APPS\Autodesk\Revit 2025\</SanRevitDir>
    <SanRevitDir Condition="'$(SanRevitDir)' == '' And '$(SanRevitVersion)' == '2026'">E:\Autodesk\Revit 2026\</SanRevitDir>
    <DefineConstants>$(DefineConstants);REVIT$(SanRevitVersion)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SanRevitVersion)' != '2025'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <BaseOutputPath>bin\R$(SanRevitVersion)\</BaseOutputPath>
    <IntermediateOutputPath>obj\R$(SanRevitVersion)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Seccion de partidas antigua, sustituida (no compilaba en el monolito). -->
    <Page Remove="Partidas\Ui\PartidasSection.xaml" />
    <Compile Remove="Partidas\Ui\PartidasSection.xaml.cs" />
    <Compile Remove="bin\**;obj\**" />
    <Page Remove="bin\**;obj\**" />
    <None Remove="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapeo de aparatos HS5: viaja con la app, junto a la DLL -->
    <None Update="Hs5\Hs5Mapeo.json">
      <Link>Hs5Mapeo.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Informes Fase 5.  OpenXml en la MISMA version que e3gbimtools.Calc /
         ClosedXML (2.20): se despliegan en la misma carpeta y en el mismo
         contexto de carga, asi que no pueden convivir dos versiones. -->
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tema E3G (E3gTheme.xaml, E3gTitleBar, E3gWindowBase). -->
    <ProjectReference Include="..\e3gbimtools.DiTools.UI\e3gbimtools.DiTools.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(SanRevitDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(SanRevitDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(SanRevitDir)AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
