<Page x:Class="E3G.Saneamiento.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource E3g.Brush.Background}">

    <!-- Contenedor del panel acoplable «E3G BIM Tools» (tema E3G, 2026-11-07):
         barra lateral con glifos Lucide (mismos trazos que la cinta) y el area
         de contenido (Saneamiento HS5 / Aislamiento; DIALux abre su ventana). -->
    <Page.Resources>
        <!-- Boton de navegacion: tarjeta redondeada; activo = tinte azul + texto Primary. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" CornerRadius="8" Padding="2,7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource E3g.Brush.GhostHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="NavIcon" TargetType="Viewbox">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="{DynamicResource E3g.Brush.Card}"
                BorderBrush="{DynamicResource E3g.Brush.Border}" BorderThickness="0,0,1,0"
                Padding="8,10">
            <StackPanel>

                <!-- Marca e3g -->
                <Border Padding="0,6,0,10" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}"
                        BorderThickness="0,0,0,1" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8"
                                Background="{DynamicResource E3g.Brush.BrandBand}">
                            <TextBlock Text="e3g" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource E3g.Brush.OnBrand}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="BIM Tools" FontSize="9" Margin="0,4,0,0"
                                   Foreground="{DynamicResource E3g.Brush.TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Saneamiento -->
                <Button x:Name="BtnNavSaneamiento" Click="BtnNavSaneamiento_Click"
                        Style="{StaticResource NavButton}" ToolTip="Saneamiento HS5">
                    <StackPanel>
                        <Viewbox Style="{StaticResource NavIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavGlyph}" Data="m4 4 2.5 2.5 M13.5 6.5a4.95 4.95 0 0 0-7 7 M15 5 5 15 M14 17v.01 M10 16v.01 M13 13v.01 M16 10v.01 M11 20v.01 M17 14v.01 M20 11v.01"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Saneam." Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </Button>

                <!-- Aislamiento de tuberias (seccion de tubo con su funda) -->
                <Button x:Name="BtnNavAislamiento" Click="BtnNavAislamiento_Click"
                        Style="{StaticResource NavButton}" ToolTip="Aislamiento de tuberías">
                    <StackPanel>
                        <Viewbox Style="{StaticResource NavIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavGlyph}" Data="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M7 12a5 5 0 1 0 10 0a5 5 0 1 0 -10 0"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Aislam." Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </Button>

                <!-- Climatizacion (glifo Lucide «air-vent»: rejilla con flujo de aire) -->
                <Button x:Name="BtnNavClimatizacion" Click="BtnNavClimatizacion_Click"
                        Style="{StaticResource NavButton}" ToolTip="Climatización">
                    <StackPanel>
                        <Viewbox Style="{StaticResource NavIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavGlyph}" Data="M6 12H4a2 2 0 0 1 -2 -2V5a2 2 0 0 1 2 -2h16a2 2 0 0 1 2 2v5a2 2 0 0 1 -2 2h-2 M6 8h12 M18.3 17.7a2.5 2.5 0 0 1 -3.16 3.83a2.53 2.53 0 0 1 -1.14 -2V12 M6.6 15.6A2 2 0 1 0 10 17v-5"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Climatiz." Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </Button>

                <!-- DIALux → Revit: pagina de DiTools (DialuxImportView) alojada aqui.
                     Solo visible si DiTools la ha registrado (App.RegistrarPaginaExterna). -->
                <Button x:Name="BtnNavDialux" Click="BtnNavDialux_Click" Visibility="Collapsed"
                        Style="{StaticResource NavButton}"
                        ToolTip="DIALux → Revit: coloca las luminarias de un DWG de DIALux">
                    <StackPanel>
                        <Viewbox Style="{StaticResource NavIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource NavGlyph}" Data="M12 2v5 M6 7h12l4 9H2l4-9Z M9.17 16a3 3 0 1 0 5.66 0"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="DIALux" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- AREA DE CONTENIDO -->
        <Frame x:Name="ContentArea" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
