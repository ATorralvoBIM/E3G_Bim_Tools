<Window x:Class="E3G.Saneamiento.AislamientoTablaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espesores mínimos de aislamiento · RITE IT 1.2.4.2.1"
        Width="860" Height="680" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource E3g.Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ColInterior"/>
                <StackPanel x:Name="ColExterior" Grid.Column="2"/>
            </Grid>
            <StackPanel x:Name="ColAguaFria"/>
            <TextBlock x:Name="TxtNotas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="17"
                       Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
