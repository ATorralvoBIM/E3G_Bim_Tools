<Page x:Class="E3G.Saneamiento.AislamientoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource E3g.Brush.Background}">

    <Page.Resources>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource E3g.Brush.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}" />
        </Style>
        <!-- Misma barra de progreso que la pagina de Saneamiento -->
        <Style x:Key="E3gProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource E3g.Brush.BorderSubtle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Aislamiento" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource E3g.Brush.Text}"/>
                    <TextBlock Text="Espesor del aislamiento de tuberías según el RITE" FontSize="11" Margin="0,2,0,10"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnAnalizar" Content="Analizar selección" Click="BtnAnalizar_Click"
                                Style="{DynamicResource E3g.Style.Button.Primary}"/>
                        <Button Grid.Column="2" Content="Ver tabla RITE" Click="BtnTabla_Click"
                                Style="{DynamicResource E3g.Style.Button.Secondary}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PanelAmbiente" Style="{StaticResource Tarjeta}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Aire alrededor del agua fría (condensación)" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource E3g.Brush.Text}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Temperatura (°C)" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtAireTemperatura" FontSize="11" Padding="4,3"
                                     TextChanged="Ambiente_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Humedad relativa (%)" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtAireHumedad" FontSize="11" Padding="4,3"
                                     TextChanged="Ambiente_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtRocio" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ListaSistemas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource E3g.Brush.BrandTint}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PorRevisar}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource E3g.Brush.WarningBg}"/>
                                                        <Setter Property="ToolTip" Value="No se ha podido saber si es caliente o frío: elige el fluido y la temperatura, y márcalo."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Detectado}" FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Primary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PorRevisar}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.WarningText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <CheckBox IsChecked="{Binding Incluir}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource E3g.Brush.Text}"/>
                                    </CheckBox>
                                </DockPanel>
                                <TextBlock Text="{Binding Conteo}" FontSize="10" Margin="0,2,0,8"
                                           Foreground="{DynamicResource E3g.Brush.TextMuted}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Fluido" Style="{StaticResource Rotulo}"/>
                                        <ComboBox SelectedIndex="{Binding IndiceFluido}" FontSize="11">
                                            <ComboBoxItem Content="Frío (tabla)"/>
                                            <ComboBoxItem Content="Caliente"/>
                                            <ComboBoxItem Content="ACS"/>
                                            <ComboBoxItem Content="Agua fría (9 mm)"/>
                                            <ComboBoxItem Content="Frigorífica (reversible)"
                                                          ToolTip="Línea de refrigerante de split o VRV: la temperatura es la de evaporación y manda la más exigente entre frío y gas caliente (RITE IT 1.2.4.2.1.2 ap. 4)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Temp. (°C)" Style="{StaticResource Rotulo}"/>
                                        <TextBox Text="{Binding TemperaturaTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="4,3"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Ubicación" Style="{StaticResource Rotulo}"/>
                                        <ComboBox SelectedIndex="{Binding IndiceUbicacion}" FontSize="11">
                                            <ComboBoxItem Content="Interior"/>
                                            <ComboBoxItem Content="Exterior"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Resumen}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource E3g.Brush.Text}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="PanelColocar" Style="{StaticResource Tarjeta}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Tipo de aislamiento" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CmbTipo" FontSize="11" Margin="0,0,0,8"/>
                    <Button x:Name="BtnColocar" Content="Colocar aislamiento" Click="BtnColocar_Click"
                            Style="{DynamicResource E3g.Style.Button.Primary}"/>
                    <TextBlock FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource E3g.Brush.TextMuted}"
                               Text="Espesores para λ = 0,040 W/(m·K) a 10 °C. Con un material de otra conductividad hay que corregirlos. En agua fría, el material debe ser de célula cerrada o llevar barrera de vapor de más de 50 MPa·m²·s/g (RITE IT 1.2.4.2.1.1 ap. 5)."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- BARRA DE ESTADO -->
    <Border Grid.Row="1" Background="{DynamicResource E3g.Brush.Card}" Padding="12,6"
            BorderBrush="{DynamicResource E3g.Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                       Foreground="{DynamicResource E3g.Brush.TextMuted}" VerticalAlignment="Center"
                       Text="Listo · selecciona tuberías en Revit y pulsa Analizar selección"/>
            <StackPanel x:Name="ProgressPanel" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" FontSize="11" Foreground="{DynamicResource E3g.Brush.Text}"
                           VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="44" TextAlignment="Right"/>
                <ProgressBar x:Name="ProgressOperacion" Style="{StaticResource E3gProgress}" Width="120"
                             Minimum="0" Maximum="100" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Page>
