<Page x:Class="E3G.Saneamiento.ClimatizacionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource E3g.Brush.Background}">

    <!-- Pagina «Climatizacion» del panel MEP (2026-11-12): cabecera y pestañas
         como Saneamiento.  El contenido de cada pestaña lo pone DiTools
         (paginas externas registradas); sin DiTools solo queda el aviso. -->
    <Page.Resources>
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource E3g.Brush.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource E3g.Brush.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <DockPanel Margin="14,12,14,8">
            <Border DockPanel.Dock="Right" Background="{DynamicResource E3g.Brush.BrandTint}" CornerRadius="4"
                    Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="VRF · LG LATS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Primary}"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Climatización" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource E3g.Brush.Text}"/>
                <TextBlock Text="Refrigerante: trazado desde DXF y esquema de principio" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource E3g.Brush.TextMuted}"/>
            </StackPanel>
        </DockPanel>

        <!-- PESTAÑAS -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource E3g.Brush.BorderSubtle}" BorderThickness="0,0,0,1" Margin="12,0,12,0">
            <WrapPanel>
                <RadioButton x:Name="TabTrazado" Content="Trazado DXF" Style="{StaticResource TabBtn}" IsChecked="True"
                             Checked="OnTabChecked"/>
                <RadioButton x:Name="TabEsquema" Content="Esquema de principio" Style="{StaticResource TabBtn}"
                             Checked="OnTabChecked"/>
                <RadioButton x:Name="TabAjustes" Content="Ajustes" Style="{StaticResource TabBtn}"
                             Checked="OnTabChecked"/>
            </WrapPanel>
        </Border>

        <!-- CONTENIDO -->
        <ContentControl x:Name="Host" Grid.Row="2"/>
        <TextBlock x:Name="SinModulo" Grid.Row="2" Margin="14,10" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource E3g.Brush.TextMuted}"
                   Text="El módulo DiTools no está cargado: esta herramienta no está disponible."/>
    </Grid>
</Page>
