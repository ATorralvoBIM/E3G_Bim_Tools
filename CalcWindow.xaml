<Window x:Class="E3G.Saneamiento.CalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:filter="clr-namespace:E3G.Saneamiento.UI.Filter"
        Title="MEP Calc - E3G BIM Tools"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource ThemeWindowBg}"
        Foreground="{DynamicResource ThemeWindowFg}">
    <Window.Resources>
        <!-- [v7.6] Paleta de tema (claro/oscuro). Se intercambian en
             code-behind via Resources["..."] = new SolidColorBrush(...).
             Todos los controles que cambian con el tema usan DynamicResource. -->
        <SolidColorBrush x:Key="ThemeWindowBg"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ThemeWindowFg"  Color="#222222"/>
        <SolidColorBrush x:Key="ThemeMutedFg"   Color="#555555"/>
        <SolidColorBrush x:Key="ThemeBorder"    Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ThemePanelBg"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeHeaderBg"  Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ThemeAltRowBg"  Color="#FAFAFA"/>
        <SolidColorBrush x:Key="ThemeGridLine"  Color="#EEEEEE"/>
        <SolidColorBrush x:Key="ThemeOkBg"      Color="#E8F5E9"/>
        <SolidColorBrush x:Key="ThemeWarnBg"    Color="#FFF8E1"/>
        <SolidColorBrush x:Key="ThemeErrorBg"   Color="#FFEBEE"/>
        <SolidColorBrush x:Key="ThemeSplitter"  Color="#BDBDBD"/>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
        </Style>
        <!-- (El estilo completo de ComboBox con template propio está más abajo,
             cerca de los demás estilos con template). -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAltRowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeWindowFg}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAltRowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>

        <!-- TabControl: aplica el fondo del panel al chrome del control. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>

        <!-- TabItem con template propio para que las pestañas reaccionen al tema. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="1,1,1,0"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="6,3"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemePanelBg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource ThemeMutedFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBlock por defecto en color del texto principal del tema. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
        </Style>

        <!-- Cabeceras del DataGrid: la plantilla por defecto pinta gris claro
             fijo, así que la sobrescribimos para que respete el tema. -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cabecera (esquina superior izquierda) y filas del DataGrid. -->
        <Style TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>

        <!-- ScrollBar oscuro: thumb del color "muted" sobre track del panel. -->
        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="Bd" CornerRadius="3" Margin="2"
                                Background="{DynamicResource ThemeMutedFg}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeWindowFg}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeWindowFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollRepeatHidden" TargetType="{x:Type RepeatButton}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ScrollBarVerticalTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
                <Track Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollRepeatHidden}"
                                      Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" MinHeight="20"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollRepeatHidden}"
                                      Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ScrollBarHorizontalTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
                <Track Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollRepeatHidden}"
                                      Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}" MinWidth="20"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollRepeatHidden}"
                                      Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedFg}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Item del dropdown del ComboBox: respeta el tema en hover/selección. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeAltRowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeHeaderBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plantilla del ToggleButton que abre el dropdown del ComboBox. -->
        <ControlTemplate x:Key="ThemeComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{DynamicResource ThemeWindowFg}"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- ComboBox: template completo que respeta Background/Foreground. -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAltRowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ThemeComboToggleTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Focusable="False"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Hidden"
                                     Background="Transparent"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource ThemePanelBg}"
                                            BorderBrush="{DynamicResource ThemeBorder}"
                                            BorderThickness="1"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle estilo switch para alternar tema. -->
        <Style x:Key="ThemeSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11"
                                Background="#D8D8D8" BorderBrush="#A8A8A8" BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0"/>
                                <TextBlock x:Name="IconLeft" Text="☀" FontSize="11"
                                           HorizontalAlignment="Left" Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#444"/>
                                <TextBlock x:Name="IconRight" Text="🌙" FontSize="10"
                                           HorizontalAlignment="Right" Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Visibility="Hidden" Foreground="#FFF"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Track" Property="Background" Value="#3B4252"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2B3242"/>
                                <Setter TargetName="IconLeft" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="IconRight" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="TabSystem"
                    Background="{DynamicResource ThemePanelBg}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    Foreground="{DynamicResource ThemeWindowFg}"
                    SelectionChanged="OnTabChanged">

            <TabItem Header="  Tuberías  " x:Name="TabPiping"
                     Background="{DynamicResource ThemePanelBg}"
                     Foreground="{DynamicResource ThemeWindowFg}">
                <Grid Margin="10" Background="{DynamicResource ThemePanelBg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Sistema MEP:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="CboPipeSystems" DisplayMemberPath="Name"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Criterio dimensionado:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="CboPipeCriteria"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Tipo edificio (simult.):"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="CboPipeBuilding"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Temperatura agua [°C]:"/>
                    <Slider Grid.Row="3" Grid.Column="1" x:Name="SldPipeTemp"
                            Minimum="5" Maximum="90" Value="20"
                            TickPlacement="BottomRight" TickFrequency="5"
                            Margin="6,2" VerticalAlignment="Center"
                            ValueChanged="OnPipeTempChanged"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="LblPipeTemp"
                               Text="20" Width="40" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="6,0"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Presión fuente [kPa]:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             x:Name="TxtPipeSourceKpa" Text="300"/>
                </Grid>
            </TabItem>

            <TabItem Header="  Conductos  " x:Name="TabDucts"
                     Background="{DynamicResource ThemePanelBg}"
                     Foreground="{DynamicResource ThemeWindowFg}">
                <Grid Margin="10" Background="{DynamicResource ThemePanelBg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Sistema MEP:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="CboDuctSystems" DisplayMemberPath="Name"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Criterio dimensionado:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              x:Name="CboDuctCriteria"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Temperatura aire [°C]:"/>
                    <Slider Grid.Row="2" Grid.Column="1" x:Name="SldDuctTemp"
                            Minimum="-10" Maximum="50" Value="20"
                            TickPlacement="BottomRight" TickFrequency="5"
                            Margin="6,2" VerticalAlignment="Center"
                            ValueChanged="OnDuctTempChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LblDuctTemp"
                               Text="20" Width="40" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="6,0"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Altitud [m]:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             x:Name="TxtDuctAltitude" Text="0"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Presión ventilador [Pa]:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             x:Name="TxtDuctSourcePa" Text="250"/>
                </Grid>
            </TabItem>

        </TabControl>


        <!-- ════ FASE 4: Barra de búsqueda + filtros rápidos ════ -->
        <filter:FilterBar Grid.Row="1" x:Name="FilterBarControl"/>

        <Grid Grid.Row="2" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="500" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="DgResults"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource ThemeGridLine}"
                      AlternatingRowBackground="{DynamicResource ThemeAltRowBg}"
                      Background="{DynamicResource ThemePanelBg}"
                      Foreground="{DynamicResource ThemeWindowFg}"
                      RowBackground="{DynamicResource ThemePanelBg}"
                      SelectionChanged="OnGridSelectionChanged">
                <!-- [v7.5] Menú contextual: click derecho sobre el grid abre
                     un panel con un checkbox por cada columna. El menú se
                     reconstruye al abrirse para reflejar el estado actual de
                     Visibility de cada DataGridColumn. -->
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="ColumnVisibilityMenu"
                                 Opened="OnColumnVisibilityMenuOpened"/>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"           Binding="{Binding BfsIndexDisplay}" Width="40"/>
                    <DataGridTextColumn Header="Elemento"    Binding="{Binding ElementLabel}"    Width="90"/>
                    <DataGridTextColumn Header="Nodos"       Binding="{Binding NodePath}"        Width="80"/>
                    <DataGridTextColumn Header="Nivel"       Binding="{Binding LevelName}"       Width="100"/>
                    <DataGridTextColumn Header="Element Id"  Binding="{Binding RevitIdDisplay}"  Width="90"/>
                    <DataGridTextColumn Header="Talla"       Binding="{Binding SizeDisplay}"     Width="80"/>
                    <DataGridTextColumn Header="DN rec"      Binding="{Binding RecommendedSizeDisplay}" Width="80"/>
                    <DataGridTextColumn Header="N"           Binding="{Binding FixtureCountDisplay}" Width="40"/>
                    <DataGridTextColumn Header="K"           Binding="{Binding KFactorDisplay}"  Width="50"/>
                    <DataGridTextColumn Header="Q raw [L/s]" Binding="{Binding RawFlowLpsDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Q dis [L/s]" Binding="{Binding FlowLpsDisplay}"   Width="80"/>
                    <DataGridTextColumn Header="v [m/s]"     Binding="{Binding VelocityDisplay}"  Width="70"/>
                    <DataGridTextColumn Header="ΔP/m [Pa/m]" Binding="{Binding FrictionPaPmDisplay}" Width="90"/>
                    <DataGridTextColumn Header="ΔP tot [Pa]" Binding="{Binding TotalLossDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Estado"      Binding="{Binding Status}"       Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="OK">
                                <Setter Property="Background" Value="{DynamicResource ThemeOkBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource ThemeWarnBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource ThemeErrorBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ThemeSplitter}"
                          ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip="Arrastra para ampliar el panel del esquema"
                          Cursor="SizeWE"/>

            <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                    Background="{DynamicResource ThemePanelBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Str.Schema.Title}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" Padding="6,4"
                               Background="{DynamicResource ThemeHeaderBg}"
                               Foreground="{DynamicResource ThemeWindowFg}"/>
                    <!-- Leyenda de glifos -->
                    <WrapPanel Grid.Row="1" Background="{DynamicResource ThemeAltRowBg}" Margin="0"
                               Orientation="Horizontal">
                        <TextBlock Text="▲ Fuente"     Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                        <TextBlock Text="■ Terminal"   Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                        <TextBlock Text="┬ Tee"        Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                        <TextBlock Text="✚ Cross"      Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                        <TextBlock Text="└ Codo"       Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                        <TextBlock Text="◇ Reductor"   Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                        <TextBlock Text="━ Cap"        Foreground="{DynamicResource ThemeMutedFg}" FontSize="10" Margin="6,3"/>
                    </WrapPanel>
                    <!-- [Fase 2] Toolbar de análisis: camino crítico + heatmap -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource ThemeHeaderBg}"
                            BorderBrush="{DynamicResource ThemeBorder}"
                            BorderThickness="0,1,0,1"
                            Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnCriticalPath"
                                          Content="{DynamicResource Str.Btn.CaminoCritico}"
                                          Padding="10,2" MinWidth="120"
                                          ToolTip="Resalta el recorrido fuente → terminal con peor ΔP acumulado"
                                          Checked="OnCriticalPathToggled"
                                          Unchecked="OnCriticalPathToggled"/>
                            <TextBlock Text="Heatmap:" Margin="14,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeWindowFg}"/>
                            <ComboBox x:Name="CboHeatmap" Width="140"
                                      SelectionChanged="OnHeatmapChanged">
                                <ComboBoxItem Content="Ninguno" IsSelected="True"/>
                                <ComboBoxItem Content="Caudal (Q)"/>
                                <ComboBoxItem Content="Velocidad (v)"/>
                                <ComboBoxItem Content="Pérdida (ΔP/m)"/>
                                <ComboBoxItem Content="Holgura"/>
                            </ComboBox>
                            <TextBlock x:Name="LblHeatmapRange" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource ThemeMutedFg}"
                                       Text=""/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="3" x:Name="SchematicScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <Canvas x:Name="SchematicCanvas"
                                Background="{DynamicResource ThemePanelBg}"
                                Width="480" Height="600"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="LblStatus" Text="{DynamicResource Str.Status.Ready}"
                   Margin="2,4" Foreground="{DynamicResource ThemeMutedFg}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ToggleButton x:Name="BtnTheme" Style="{StaticResource ThemeSwitchStyle}"
                          ToolTip="Alternar tema claro / oscuro"
                          Checked="OnToggleTheme" Unchecked="OnToggleTheme"/>
            <Button x:Name="BtnDiag"   Content="{DynamicResource Str.Btn.Diagnostic}" Click="OnShowDiag" IsEnabled="False" MinWidth="120"/>
            <Button x:Name="BtnCalc"   Content="{DynamicResource Str.Btn.Calcular}"   Click="OnCalculate"/>
            <Button x:Name="BtnExport" Content="{DynamicResource Str.Btn.Exportar}"   Click="OnExport"   IsEnabled="False" MinWidth="160"/>
            <Button x:Name="BtnSchema" Content="{DynamicResource Str.Btn.Esquema}"    Click="OnGenerateSchema" IsEnabled="False" MinWidth="160"
                    ToolTip="Abre la ventana de previsualización del esquema de principio"/>
            <Button x:Name="BtnApply"  Content="{DynamicResource Str.Btn.Aplicar}"    Click="OnApply"    IsEnabled="False" MinWidth="140"/>
            <Separator Width="1" Background="{DynamicResource ThemeBorder}" Margin="6,2"/>
            <Button x:Name="BtnAjustes" Content="{DynamicResource Str.Btn.Ajustes}"  Click="OnOpenAjustes" MinWidth="100"
                    ToolTip="Obrir la finestra d'ajustos"/>
            <Button x:Name="BtnClose"  Content="{DynamicResource Str.Btn.Tancar}"    Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
