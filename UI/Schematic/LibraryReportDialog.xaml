<Window x:Class="E3G.Saneamiento.UI.Schematic.LibraryReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informe de carga de biblioteca"
        Height="460" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFFFFF">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitle" Grid.Row="0"
                   FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="LblSummary" Grid.Row="1"
                   Foreground="#555"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"/>

        <DataGrid x:Name="DgItems" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE"
                  AlternatingRowBackground="#FAFAFA"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="220"/>
                <DataGridTemplateColumn Header="Resultado" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBg}"
                                    CornerRadius="3" Padding="6,1" Margin="4,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusFg}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Categoría detectada" Binding="{Binding Category}" Width="160"/>
                <DataGridTextColumn Header="Mensaje" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCopy" Content="Copiar al portapapeles"
                    Padding="12,5" MinWidth="160"
                    Click="OnCopyClick"/>
            <Button Content="Cerrar" IsDefault="True" IsCancel="True"
                    Padding="12,5" MinWidth="100" Margin="8,0,0,0"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
