<UserControl x:Class="E3G.Saneamiento.UI.Schematic.SchematicConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:E3G.Saneamiento.UI.Schematic"
             FontFamily="Segoe UI" FontSize="12"
             d:DataContext="{d:DesignInstance Type=local:SchematicConfigViewModel,
                                              IsDesignTimeCreatable=True}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="380" d:DesignHeight="720"
             Background="{DynamicResource ThemePanelBg}"
             Foreground="{DynamicResource ThemeWindowFg}">

    <UserControl.Resources>
        <!-- Estilos locales mínimos para que el panel se vea bien aunque
             el host no aporte los recursos del tema. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeWindowFg}"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedFg}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SliderRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <!-- Conversor numérico simple para el TextBlock que muestra el valor
             del slider con unidad y dos decimales. -->
        <local:DoubleFormatConverter x:Key="MmFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════ CABECERA ════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeHeaderBg}"
                BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,0,1,1"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="Configuración del esquema"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowFg}"/>
                <TextBlock Text="Ajusta layout, símbolos y filtros antes de generar."
                           Style="{StaticResource HelpText}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════ CONTENIDO ═══════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="12,8,12,8">
            <StackPanel>

                <!-- ── Sección 1 · Mapeo de símbolos 2D ──────────────── -->
                <TextBlock Text="Mapeo de símbolos 2D"
                           Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Asocia cada tipo de elemento de la red con un Componente de Detalle (.rfa) que será insertado en su lugar al generar el esquema. Si una fila queda sin asignar, se dibuja con el símbolo primitivo por defecto."/>

                <!-- Aviso sobre la limitación PIPE/DUCT -->
                <Border BorderBrush="#E0A800" BorderThickness="0,0,0,0"
                        Background="#FFF8E1"
                        Padding="8,5" Margin="0,2,0,6"
                        CornerRadius="3">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7A5C00"
                               ToolTip="Si tu sistema mezcla tramos de tubería y conducto en un mismo esquema, el .rfa asignado a 'TEE' se aplicará a ambos. Recomendado: generar esquemas separados por disciplina.">
                        <Run FontWeight="SemiBold" Text="ⓘ Nota:"/>
                        <Run Text=" los tipos (TEE, ELBOW, REDUCER…) son comunes para tubería y conducto. El mapeo es por topología, no por disciplina."/>
                    </TextBlock>
                </Border>

                <DataGrid x:Name="DgMappings"
                          ItemsSource="{Binding Mappings}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource ThemeGridLine}"
                          AlternatingRowBackground="{DynamicResource ThemeAltRowBg}"
                          Background="{DynamicResource ThemePanelBg}"
                          Foreground="{DynamicResource ThemeWindowFg}"
                          RowBackground="{DynamicResource ThemePanelBg}"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          IsReadOnly="False"
                          MinHeight="200" MaxHeight="320"
                          Margin="0,0,0,6">
                    <DataGrid.Columns>
                        <!-- Tipo (read-only) -->
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Kind}"
                                            Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Descripción (read-only) -->
                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding Description}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeMutedFg}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Símbolo asignado (read-only display) -->
                        <DataGridTextColumn Header="Símbolo 2D"
                                            Binding="{Binding SymbolDisplay}"
                                            Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="4,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Visible -->
                        <DataGridCheckBoxColumn Header="Ver"
                                                Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}"
                                                Width="40"/>
                        <!-- Botón … abre FileDialog -->
                        <DataGridTemplateColumn Header=" " Width="32">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="…" Padding="0" Margin="2"
                                            ToolTip="Asignar familia .rfa"
                                            Command="{Binding DataContext.LoadFamilyForRowCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="📁 Carpeta…"
                            Command="{Binding LoadLibraryFolderCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,0,3,0"
                            ToolTip="Escanea recursivamente una carpeta y auto-asocia los .rfa cuyo nombre contenga el tipo (TEE, ELBOW…). Solo se aceptan Detail Item o Generic Annotation."/>
                    <Button Grid.Column="1"
                            Content="📄 Archivos…"
                            Command="{Binding LoadLibraryFilesCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="3,0,0,0"
                            ToolTip="Selecciona uno o varios .rfa sueltos para cargar a la biblioteca"/>
                </Grid>

                <!-- ── Sección 2 · Layout ────────────────────────────── -->
                <TextBlock Text="Layout (medidas en mm de papel)"
                           Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Las medidas son las del esquema PLOTEADO, no del modelo. La escala de la vista Revit (1:50 / 1:100) las convierte a coordenadas internas automáticamente."/>

                <!-- Separación entre líneas -->
                <Grid Style="{StaticResource SliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Separación entre líneas"/>
                        <Slider Minimum="4" Maximum="20"
                                Value="{Binding PaperMmLineSpacing, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="0.5" LargeChange="2"
                                ToolTip="Distancia mínima entre filas en mm de papel"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PaperMmLineSpacing, Converter={StaticResource MmFormat}, ConverterParameter=mm}"
                               VerticalAlignment="Bottom" TextAlignment="Right"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- Indentación entre columnas -->
                <Grid Style="{StaticResource SliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Indentación entre columnas"/>
                        <Slider Minimum="15" Maximum="60"
                                Value="{Binding PaperMmColumnIndent, Mode=TwoWay}"
                                TickFrequency="5" IsSnapToTickEnabled="False"
                                SmallChange="1" LargeChange="5"
                                ToolTip="Separación horizontal entre niveles de ramificación"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PaperMmColumnIndent, Converter={StaticResource MmFormat}, ConverterParameter=mm}"
                               VerticalAlignment="Bottom" TextAlignment="Right"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- Altura de texto -->
                <Grid Style="{StaticResource SliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Altura de texto"/>
                        <Slider Minimum="1.5" Maximum="5"
                                Value="{Binding PaperMmTextHeight, Mode=TwoWay}"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                SmallChange="0.1" LargeChange="0.5"
                                ToolTip="Altura del texto en mm de papel (Revit lo lee de TextNoteType)"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PaperMmTextHeight, Converter={StaticResource MmFormat}, ConverterParameter=mm}"
                               VerticalAlignment="Bottom" TextAlignment="Right"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- Tamaño de símbolos -->
                <Grid Style="{StaticResource SliderRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tamaño de símbolos"/>
                        <Slider Minimum="2" Maximum="8"
                                Value="{Binding PaperMmSymbolSize, Mode=TwoWay}"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                SmallChange="0.1" LargeChange="0.5"
                                ToolTip="Tamaño de los glifos TEE/ELBOW/TERMINAL en mm de papel"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PaperMmSymbolSize, Converter={StaticResource MmFormat}, ConverterParameter=mm}"
                               VerticalAlignment="Bottom" TextAlignment="Right"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- ── Sección 3 · Filtros de visibilidad ─────────────── -->
                <TextBlock Text="Filtros de visibilidad"
                           Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Marca qué elementos aparecen en el esquema. La red sigue siendo la misma; sólo se oculta su representación gráfica."/>

                <CheckBox Content="Etiquetas de tuberías"
                          IsChecked="{Binding ShowPipeLabels, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Etiquetas de accesorios (TEE @N…)"
                          IsChecked="{Binding ShowFittingLabels, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Válvulas"
                          IsChecked="{Binding ShowValves, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Contadores"
                          IsChecked="{Binding ShowMeters, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Sensores"
                          IsChecked="{Binding ShowSensors, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Leyenda en la esquina"
                          IsChecked="{Binding ShowLegend, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Resaltar camino crítico en rojo"
                          IsChecked="{Binding HighlightCriticalPath, Mode=TwoWay}"
                          Margin="0,2"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════ ACCIONES ════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ThemeHeaderBg}"
                BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,1,1,0"
                Padding="12,8">
            <StackPanel>
                <Button Content="↺ Restablecer valores"
                        Command="{Binding ResetCommand}"
                        Padding="8,4" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"/>
                <Button Content="🗺 Generar en Revit"
                        Command="{Binding GenerateCommand}"
                        Padding="8,6"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        ToolTip="Crear la Drafting View con los parámetros actuales"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
