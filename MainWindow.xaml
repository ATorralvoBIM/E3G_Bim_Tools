<Page x:Class="E3G.Saneamiento.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#E8ECF0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="74"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="white" CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#C8CDD2" BlurRadius="8" ShadowDepth="4" Direction="0" Opacity="0.9"/>
            </Border.Effect>
            <StackPanel>

                <!-- Logo E3G -->
                <Border Padding="0,14,0,10" BorderBrush="#C8CDD2" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="E3G" FontSize="20" FontWeight="Medium"
                           Foreground="#4a7a96" HorizontalAlignment="Center"/>
                        <TextBlock Text="BIM" FontSize="10" Foreground="#94A3B8"
                           HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Saneamiento — funcional -->
                <Button x:Name="BtnNavSaneamiento" Click="BtnNavSaneamiento_Click"
                Cursor="Hand" Background="Transparent" BorderThickness="0"
                Margin="0,3" ToolTip="Saneamiento HS5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder" CornerRadius="14"
                            Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PillShadow" Color="#C8CDD2"
                                              BlurRadius="6" ShadowDepth="3"
                                              Direction="315" Opacity="0.9"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#DDE1E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💧" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Saneam." FontSize="10" Foreground="#475569"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Fontanería — funcional -->
                <Button x:Name="BtnNavFontaneria" Click="BtnNavFontaneria_Click"
                Cursor="Hand" Background="Transparent" BorderThickness="0"
                Margin="0,3" ToolTip="Fontanería">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder" CornerRadius="14"
                            Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PillShadow" Color="#C8CDD2"
                                              BlurRadius="6" ShadowDepth="3"
                                              Direction="315" Opacity="0.9"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#DDE1E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔧" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Fontaner." FontSize="10" Foreground="#475569"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Separador -->
                <Rectangle Height="1" Fill="#C8CDD2" Margin="8,8"/>

                <!-- Climatización — pròximament -->
                <Button Cursor="Arrow" Background="Transparent" BorderThickness="0"
                Margin="0,3" Opacity="0.45" ToolTip="Climatización — pròximament"
                Click="BtnNavProximament_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C8CDD2" BlurRadius="4"
                                              ShadowDepth="2" Direction="315" Opacity="0.6"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="❄️" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Climat." FontSize="10" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Ventilación — pròximament -->
                <Button Cursor="Arrow" Background="Transparent" BorderThickness="0"
                Margin="0,3" Opacity="0.45" ToolTip="Ventilación — pròximament"
                Click="BtnNavProximament_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C8CDD2" BlurRadius="4"
                                              ShadowDepth="2" Direction="315" Opacity="0.6"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💨" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ventilac." FontSize="10" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Electricidad — pròximament -->
                <Button Cursor="Arrow" Background="Transparent" BorderThickness="0"
                Margin="0,3" Opacity="0.45" ToolTip="Electricidad — pròximament"
                Click="BtnNavProximament_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C8CDD2" BlurRadius="4"
                                              ShadowDepth="2" Direction="315" Opacity="0.6"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Electric." FontSize="10" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- CI — pròximament -->
                <Button Cursor="Arrow" Background="Transparent" BorderThickness="0"
                Margin="0,3" Opacity="0.45" ToolTip="CI — pròximament"
                Click="BtnNavProximament_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C8CDD2" BlurRadius="4"
                                              ShadowDepth="2" Direction="315" Opacity="0.6"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔌" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="CI" FontSize="10" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Separador Ajustos -->
                <Rectangle Height="1" Fill="#C8CDD2" Margin="8,8"/>

                <!-- Ajustos — funcional -->
                <Button x:Name="BtnNavAjustes" Click="BtnNavAjustes_Click"
        Cursor="Hand" Background="Transparent" BorderThickness="0"
        Margin="0,3" ToolTip="Ajustos">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder" CornerRadius="14"
                    Background="White" Padding="4,8">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PillShadow" Color="#C8CDD2"
                                      BlurRadius="6" ShadowDepth="3"
                                      Direction="315" Opacity="0.9"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#DDE1E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ajustos" FontSize="10" Foreground="#475569"
                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ÀREA DE CONTINGUT -->
        <Frame x:Name="ContentArea" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>