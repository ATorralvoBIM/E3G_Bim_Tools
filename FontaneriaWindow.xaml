<Page x:Class="E3G.Saneamiento.FontaneriaWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#E8ECF0">

    <Page.Resources>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#065F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="6" ShadowDepth="3" Direction="315" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#178a64"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#116e50"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C8CDD2" BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#5bbfa0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="6" ShadowDepth="3" Direction="315" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4aaa8e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3a957c"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C8CDD2" BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FiltroBtn" TargetType="Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C8CDD2" BlurRadius="2" ShadowDepth="1" Direction="315" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- TOPBAR -->
            <Border Background="White" CornerRadius="18" Padding="16,12" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="8" ShadowDepth="4" Direction="315" Opacity="0.9"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="E3G" FontSize="20" FontWeight="Medium" Foreground="#4a7a96"/>
                        <TextBlock Text="ENGINYERIA I ENERGIA" FontSize="7" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Rectangle DockPanel.Dock="Left" Width="1" Fill="#C8CDD2" Margin="0,4,12,4"/>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Fontanería" FontSize="28" FontWeight="Medium" Foreground="#4a7a96"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border Background="#D1FAE5" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                            <TextBlock Text="AFS" FontSize="9" FontWeight="Bold" Foreground="#065F46"/>
                        </Border>
                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                            <TextBlock Text="ACS" FontSize="9" FontWeight="Bold" Foreground="#991B1B"/>
                        </Border>
                        <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                            <TextBlock Text="AR" FontSize="9" FontWeight="Bold" Foreground="#4C1D95"/>
                        </Border>
                        <Border Background="White" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="v1.0.0" FontSize="9" Foreground="#64748B"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- FILTROS -->
            <Border Background="white" CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="6" ShadowDepth="3" Direction="315" Opacity="0.7"/>
                </Border.Effect>
                <DockPanel>
                    <Button x:Name="BtnExpandir" DockPanel.Dock="Right"
                            Background="#E8ECF0" Foreground="#475569"
                            BorderThickness="0" FontSize="10" Padding="10,4" Cursor="Hand"
                            Click="BtnExpandir_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#C8CDD2" BlurRadius="5" ShadowDepth="2" Direction="315" Opacity="0.7"/>
                        </Button.Effect>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="TxtExpandir" Text="Expandir todo" FontSize="10" Foreground="#475569"/>
                    </Button>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FiltroTodos" Style="{StaticResource FiltroBtn}" Background="#DDE1E5" Foreground="#475569" Margin="0,0,4,0" Click="FiltroTodos_Click">
                            <TextBlock Text="Todos" FontSize="10"/>
                        </Button>
                        <Button x:Name="FiltroP14" Style="{StaticResource FiltroBtn}" Background="#EDE9FE" Foreground="#5B21B6" Margin="0,0,4,0" Click="FiltroP14_Click">
                            <TextBlock Text="P01–P04" FontSize="10"/>
                        </Button>
                        <Button x:Name="FiltroP56" Style="{StaticResource FiltroBtn}" Background="#DBEAFE" Foreground="#1E40AF" Margin="0,0,4,0" Click="FiltroP56_Click">
                            <TextBlock Text="P05–P06" FontSize="10"/>
                        </Button>
                        <Button x:Name="FiltroP7" Style="{StaticResource FiltroBtn}" Background="#D1FAE5" Foreground="#065F46" Margin="0,0,8,0" Click="FiltroP7_Click">
                            <TextBlock Text="P07" FontSize="10"/>
                        </Button>
                        <Rectangle Width="1" Height="14" Fill="#C8CDD2" Margin="0,0,8,0"/>
                        <Button x:Name="Filtro1D" Style="{StaticResource FiltroBtn}" Background="#FEF3C7" Foreground="#92400E" Margin="0,0,4,0" Click="Filtro1D_Click">
                            <TextBlock Text="1 dorm." FontSize="10"/>
                        </Button>
                        <Button x:Name="Filtro2D" Style="{StaticResource FiltroBtn}" Background="#DBEAFE" Foreground="#1E40AF" Margin="0,0,4,0" Click="Filtro2D_Click">
                            <TextBlock Text="2 dorm." FontSize="10"/>
                        </Button>
                        <Button x:Name="Filtro3D" Style="{StaticResource FiltroBtn}" Background="#D1FAE5" Foreground="#065F46" Margin="0,0,4,0" Click="Filtro3D_Click">
                            <TextBlock Text="3 dorm." FontSize="10"/>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- CONTINGUT GRUPS -->
            <StackPanel x:Name="PanelGrupos" Margin="0,0,0,10"/>

            <!-- TOTALS -->
            <Border x:Name="PanelTotales" Visibility="Collapsed"
                    Background="#E8ECF0" CornerRadius="14" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="6" ShadowDepth="3" Direction="315" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <Border Background="#DDE1E5" CornerRadius="14,14,0,0" Padding="14,10">
                        <TextBlock Text="Total tubería interior viviendas" FontSize="11" FontWeight="Medium" Foreground="#1E293B"/>
                    </Border>
                    <StackPanel x:Name="PanelTotalesBody" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- BOTONS -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource BtnPrimary}" Click="BtnMedir_Click">
                    <StackPanel>
                        <TextBlock Text="Medir" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Escanea grupos del modelo" FontSize="10" Foreground="White" Opacity="0.85"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Click="BtnExportar_Click">
                    <StackPanel>
                        <TextBlock Text="Exportar CSV" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Guardar mediciones" FontSize="10" Foreground="White" Opacity="0.85"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="E3G BIM Tools · Enginyeria i Energia" FontSize="10" Foreground="#B0B8C4"
                       HorizontalAlignment="Right" Margin="0,10,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>