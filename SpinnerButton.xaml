<UserControl x:Class="E3G.Saneamiento.SpinnerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="56" Height="56">

    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="SpinnerArcRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:1.1"/>
        </Storyboard>

        <Storyboard x:Key="CheckStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CheckPath"
                Storyboard.TargetProperty="StrokeDashOffset"
                From="24" To="0"
                Duration="0:0:0.4"
                BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Botó base neumòrfic -->
        <Border x:Name="BtnBorder"
                Width="56" Height="56"
                CornerRadius="28"
                Background="#E8ECF0"
                Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect x:Name="ShadowDark"
                                  Color="#C8CDD2"
                                  Direction="315"
                                  ShadowDepth="5"
                                  BlurRadius="10"
                                  Opacity="1"/>
            </Border.Effect>
        </Border>

        <!-- Llum superior-esquerra (sombra clara simulada amb segon border) -->
        <Border Width="56" Height="56"
                CornerRadius="28"
                Background="Transparent">
            <Border.Effect>
                <DropShadowEffect Color="#FFFFFF"
                                  Direction="135"
                                  ShadowDepth="5"
                                  BlurRadius="10"
                                  Opacity="1"/>
            </Border.Effect>
        </Border>

        <!-- Canvas SVG equivalent: arc track + arc animat -->
        <Canvas Width="56" Height="56">
            <!-- Track fosc (cercle base) -->
            <Ellipse Canvas.Left="4" Canvas.Top="4"
                     Width="48" Height="48"
                     Stroke="#D0D5DA" StrokeThickness="2.5"
                     Fill="Transparent"/>

            <!-- Arc giratori (loading) -->
            <Path x:Name="SpinnerArc"
                  Stroke="#4a7a96"
                  StrokeThickness="2.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent"
                  Visibility="Collapsed"
                  RenderTransformOrigin="0.5,0.5">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="28,4" IsClosed="false">
                            <ArcSegment Point="52,28"
                                        Size="24,24"
                                        SweepDirection="Clockwise"
                                        IsLargeArc="False"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerArcRotate"
                                     CenterX="28" CenterY="28"/>
                </Path.RenderTransform>
				<Path.StrokeDashArray>
					<sys:Double>5</sys:Double>
					<sys:Double>100</sys:Double>
				</Path.StrokeDashArray>
            </Path>

            <!-- Cercle complet verd (done) -->
            <Ellipse x:Name="DoneRing"
                     Canvas.Left="4" Canvas.Top="4"
                     Width="48" Height="48"
                     Stroke="#1D9E75" StrokeThickness="2.5"
                     Fill="Transparent"
                     Visibility="Collapsed"/>

            <!-- Checkmark (done) -->
            <Path x:Name="CheckPath"
                  Stroke="#1D9E75"
                  StrokeThickness="2.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  StrokeDashOffset="24"
                  Visibility="Collapsed">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="16,28" IsClosed="false">
                            <LineSegment Point="23,35"/>
                            <LineSegment Point="40,18"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
				<Path.StrokeDashArray>
					<sys:Double>24</sys:Double>
				</Path.StrokeDashArray>
            </Path>

            <!-- Icona PLAY (idle) -->
            <Path x:Name="IconPlay"
                  Fill="#4a7a96"
                  Canvas.Left="21" Canvas.Top="18">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0,0" IsClosed="true">
                            <LineSegment Point="14,10"/>
                            <LineSegment Point="0,20"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- Icona PAUSE (loading) -->
            <Canvas x:Name="IconPause" Visibility="Collapsed">
                <Rectangle Canvas.Left="18" Canvas.Top="18"
                            Width="5" Height="14"
                            RadiusX="2" RadiusY="2"
                            Fill="#4a7a96"/>
                <Rectangle Canvas.Left="27" Canvas.Top="18"
                            Width="5" Height="14"
                            RadiusX="2" RadiusY="2"
                            Fill="#4a7a96"/>
            </Canvas>
        </Canvas>

        <!-- Zona clicable transparent -->
        <Border x:Name="ClickArea"
                Width="56" Height="56"
                CornerRadius="28"
                Background="Transparent"
                Cursor="Hand"
                MouseLeftButtonDown="OnMouseDown"
                MouseLeftButtonUp="OnMouseUp"
                MouseLeave="OnMouseLeave"/>
    </Grid>
</UserControl>