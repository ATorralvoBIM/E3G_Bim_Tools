<Window x:Class="E3G.Saneamiento.ProtocolReglaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar regla" Height="560" Width="580" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#E8ECF0">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Nom -->
		<StackPanel Grid.Row="0" Margin="0,0,0,14">
			<TextBlock Text="Nom de la regla" FontSize="11" FontWeight="SemiBold"
                       Foreground="#1E293B" Margin="0,0,0,4"/>
			<TextBox x:Name="TxtNom" FontSize="13" Padding="8,6"
                     Background="#F8FAFC" BorderBrush="#C8CDD2" BorderThickness="1"/>
		</StackPanel>

		<!-- S'aplica a + Lògica -->
		<Grid Grid.Row="1" Margin="0,0,0,14">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Margin="0,0,8,0">
				<TextBlock Text="S'aplica a:" FontSize="11" FontWeight="SemiBold"
						   Foreground="#1E293B" Margin="0,0,0,4"/>
				<ComboBox x:Name="CmbAplicaA" FontSize="11" Padding="6,4"/>
			</StackPanel>
			<StackPanel Grid.Column="1">
				<TextBlock Text="Combinar condicions:" FontSize="11" FontWeight="SemiBold"
						   Foreground="#1E293B" Margin="0,0,0,4"/>
				<ComboBox x:Name="CmbLogica" FontSize="11" Padding="6,4">
					<ComboBoxItem Content="TOTES (AND)" IsSelected="True" Tag="0"/>
					<ComboBoxItem Content="QUALSEVOL (OR)" Tag="1"/>
				</ComboBox>
			</StackPanel>
		</Grid>

		<!-- Condicions -->
		<Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8"
                BorderBrush="#E8ECF0" BorderThickness="1" Padding="12">
			<StackPanel>
				<TextBlock Text="Condicions:" FontWeight="SemiBold" FontSize="12"
                           Foreground="#1E293B" Margin="0,0,0,8"/>

				<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
					<ItemsControl x:Name="LstCondicions">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,0,0,6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="140"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="28"/>
									</Grid.ColumnDefinitions>

									<!-- Paràmetre (editable amb suggeriments del projecte) -->
									<ComboBox Grid.Column="0" IsEditable="True"
											  ItemsSource="{Binding ParamsDisponibles}"
											  Text="{Binding Param, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											  FontSize="11" Margin="0,0,4,0" Padding="4,3"/>

									<!-- Operador -->
									<ComboBox Grid.Column="1"
											  ItemsSource="{Binding Operadors}"
											  DisplayMemberPath="Display"
											  SelectedValuePath="Op"
											  SelectedValue="{Binding Operador, Mode=TwoWay}"
											  FontSize="11" Margin="0,0,4,0" Padding="4,3"/>

									<!-- Valor (editable amb suggeriments contextuals) -->
									<ComboBox Grid.Column="2" IsEditable="True"
											  ItemsSource="{Binding ValorsSuggerits}"
											  Text="{Binding Valor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											  FontSize="11" Margin="0,0,4,0" Padding="4,3"
											  Background="#FFFFFF"/>

									<!-- Eliminar condició -->
									<Button Grid.Column="3" Content="✕" Width="24" Height="24"
                                            Foreground="#B91C1C" Background="Transparent"
                                            BorderThickness="0" FontSize="12"
                                            Click="BtnEliminarCondicio_Click"
                                            Tag="{Binding}"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<Button Content="+ Afegir condició" Padding="10,5" FontSize="11"
                        HorizontalAlignment="Left" Margin="0,8,0,0"
                        Background="#E8ECF0" BorderThickness="0"
                        Click="BtnAfegirCondicio_Click"/>
			</StackPanel>
		</Border>

		<!-- Botons finals -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
			<Button Content="Cancel·lar" Padding="14,7" Margin="0,0,8,0"
                    Background="#E8ECF0" BorderThickness="0"
                    Click="BtnCancelar_Click"/>
			<Button Content="Desar regla" Padding="14,7"
                    Background="#4a7a96" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnDesar_Click"/>
		</StackPanel>
	</Grid>
</Window>