<Window x:Class="E3G.Saneamiento.Presupuesto.Ui.PreviewExportacionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Previsualització de l'exportació BC3"
        Height="720" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="700"
        Background="#ECF0F3"
        FontFamily="Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Capçalera -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Previsualització de l'exportació BC3"
                           FontSize="16" FontWeight="SemiBold" Foreground="#1F2A37"/>
                <TextBlock Text="Revisa el contingut del BC3 abans de generar l'arxiu. Pots cancel·lar i tornar a Ajustes si alguna cosa no quadra."
                           FontSize="11" Foreground="#475569" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Resum -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PARTIDES" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="LblPartidas" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4A7A96"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="LÍNIES" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="LblLineas" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4A7A96"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ELEMENTS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="LblElementos" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4A7A96"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="IMPORT TOTAL" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock x:Name="LblImporte" Text="0,00 €" FontSize="22" FontWeight="Bold" Foreground="#1D9E75"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid de partides + lineas -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" x:Name="DgPartidas"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      RowHeight="32" ColumnHeaderHeight="28"
                      FontSize="12"
                      Background="#FFFFFF"
                      AlternatingRowBackground="#F8FAFC"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8ECF0"
                      SelectionChanged="DgPartidas_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Capítol" Binding="{Binding CapituloDestino}" Width="80"/>
                    <DataGridTextColumn Header="Codi" Binding="{Binding Partida.Codigo}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4A7A96"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Descripció" Binding="{Binding Partida.Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="Cantitat" Binding="{Binding CantidadParaExportar, StringFormat={}{0:0.###}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Unitat" Binding="{Binding Partida.Unidad}" Width="60"/>
                    <DataGridTextColumn Header="P.Unit." Binding="{Binding Partida.Precio, StringFormat={}{0:0.00} €}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Import" Binding="{Binding Importe, StringFormat={}{0:0.00} €}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1D9E75"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" x:Name="LblTituloLineas"
                       Text="Selecciona una partida per veure les seves línies de mesurament"
                       FontSize="11" FontWeight="SemiBold" Foreground="#475569"
                       Margin="0,8,0,4"/>

            <DataGrid Grid.Row="2" x:Name="DgLineas"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      RowHeight="26" ColumnHeaderHeight="26"
                      FontSize="11"
                      Background="#F8FAFC"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8ECF0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Comentari (origen)" Binding="{Binding Comentario}" Width="*"/>
                    <DataGridTextColumn Header="Uds" Binding="{Binding Unidades, StringFormat={}{0:0.##}}" Width="60"/>
                    <DataGridTextColumn Header="Long." Binding="{Binding Longitud, StringFormat={}{0:0.###}}" Width="80"/>
                    <DataGridTextColumn Header="Lat." Binding="{Binding Latitud, StringFormat={}{0:0.###}}" Width="60"/>
                    <DataGridTextColumn Header="Alt." Binding="{Binding Altura, StringFormat={}{0:0.###}}" Width="60"/>
                    <DataGridTextColumn Header="Cantitat" Binding="{Binding Cantidad, StringFormat={}{0:0.###}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#4A7A96"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Avis quan no hi ha mediciones -->
        <Border Grid.Row="3" x:Name="PnlSinMediciones"
                Background="#FEF3C7" CornerRadius="8" Padding="14,10" Margin="0,8,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚠ El motor no ha generat cap mesura"
                           FontWeight="SemiBold" Foreground="#92400E" FontSize="12"/>
                <TextBlock x:Name="LblSinMedicionesDetalle"
                           Text="Revisa els avisos de sota per veure el motiu concret de cada regla."
                           FontSize="11" Foreground="#92400E" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Diagnòstic / warnings collapsible -->
        <Expander Grid.Row="4" x:Name="ExpWarnings"
                  Header="Diagnòstic detallat (per regla)" Margin="0,8,0,0"
                  IsExpanded="False">
            <Border Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" MaxHeight="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LstWarnings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#475569"
                                           Margin="0,1" FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Botons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel·lar" Width="120" Height="34" Margin="0,0,8,0"
                    Click="BtnCancelar_Click"/>
            <Button x:Name="BtnExportar"
                    Content="📄 Generar BC3..." Width="160" Height="34"
                    Background="#4A7A96" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnExportar_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
