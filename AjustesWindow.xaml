<Page x:Class="E3G.Saneamiento.AjustesWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:E3G.Saneamiento"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="860"
      Background="#E8ECF0">

    <Page.Resources>

        <!-- Converters estàndard de WPF -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ══════════════════════════════════════════════
             TOKENS NEUMÒRFICS — coherents amb el projecte
        ══════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BgBase"         Color="#E8ECF0"/>
        <SolidColorBrush x:Key="BgCard"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ShadowDark"     Color="#C8CDD2"/>
        <SolidColorBrush x:Key="ShadowLight"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentSan"      Color="#4a7a96"/>
        <SolidColorBrush x:Key="AccentFont"     Color="#1D9E75"/>
        <SolidColorBrush x:Key="AccentGris"     Color="#6B7280"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8"/>
        <SolidColorBrush x:Key="Divider"        Color="#C8CDD2"/>

        <!-- ══════════════════════════════════════════════
             CARD NEUMÒRFIC (contenidor de secció)
        ══════════════════════════════════════════════ -->
        <Style x:Key="NeuCard" TargetType="Border">
            <Setter Property="Background"    Value="#FFFFFF"/>
            <Setter Property="CornerRadius"  Value="14"/>
            <Setter Property="Padding"       Value="20,16"/>
            <Setter Property="Margin"        Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#C8CDD2" BlurRadius="8"
                                      ShadowDepth="4" Direction="315" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             BOTÓ NAV ESQUERRE (settings sidebar intern)
        ══════════════════════════════════════════════ -->
        <Style x:Key="SettingsNavBtn" TargetType="Button">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="Padding"                 Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="Foreground"              Value="#475569"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#DDE1E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             TOGGLE (CheckBox estilitzat)
        ══════════════════════════════════════════════ -->
        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track" CornerRadius="10" Background="#C8CDD2"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#C8CDD2" BlurRadius="3"
                                                      ShadowDepth="1" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track"  Property="Background" Value="#4a7a96"/>
                                <Setter TargetName="Thumb"  Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb"  Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             TEXTBOX NEUMÒRFIC
        ══════════════════════════════════════════════ -->
        <Style x:Key="NeuTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#E8ECF0"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Foreground"       Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="#E8ECF0" Padding="8,5">
                            <Border.Effect>
                                <DropShadowEffect Color="#C8CDD2" BlurRadius="4"
                                                  ShadowDepth="2" Direction="270" Opacity="0.7"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════
             COMBOBOX NEUMÒRFIC
        ══════════════════════════════════════════════ -->
        <Style x:Key="NeuComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="#E8ECF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#1E293B"/>
            <Setter Property="MinWidth"        Value="140"/>
        </Style>

        <!-- ══════════════════════════════════════════════
             BADGE
        ══════════════════════════════════════════════ -->
        <Style x:Key="BadgeWarn" TargetType="Border">
            <Setter Property="Background"    Value="#FEF9C3"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="Padding"       Value="6,2"/>
            <Setter Property="Margin"        Value="0,3,0,0"/>
        </Style>
        <Style x:Key="BadgeOk" TargetType="Border">
            <Setter Property="Background"    Value="#DCFCE7"/>
            <Setter Property="CornerRadius"  Value="4"/>
            <Setter Property="Padding"       Value="6,2"/>
            <Setter Property="Margin"        Value="0,3,0,0"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             NAV ESQUERRE (seccions d'ajustos)
        ══════════════════════════════════════════════ -->
        <Border Style="{StaticResource NeuCard}" Margin="12,12,6,12" Padding="8,12">
            <StackPanel>
                <TextBlock Text="AJUSTOS" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Margin="12,0,0,10"/>

                <!-- General -->
                <TextBlock Text="GENERAL" FontSize="8" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Margin="12,6,0,4"/>
                <Button x:Name="BtnNavIdioma"        Click="BtnNavIdioma_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="🌐  Idioma"/>
                <Button x:Name="BtnNavUnidades"      Click="BtnNavUnidades_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="📐  Unitats"/>
                <Button x:Name="BtnNavConfirmaciones" Click="BtnNavConfirmaciones_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="✅  Confirmacions"/>
                <Button x:Name="BtnNavNomenclatura"  Click="BtnNavNomenclatura_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="🏷️  Nomenclatura"/>
				<Button x:Name="BtnNavClassificacio" Click="BtnNavClassificacio_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="🗂️  Classificació sistemes"/>
				<Button x:Name="BtnNavPartides"
                        Style="{StaticResource SettingsNavBtn}"
                        Content="🧾  Partides BC3"
                        Click="BtnNavPartides_Click"/>
                <Button x:Name="BtnNavProtocol"
                        Content="Protocol de classificació"
                        Style="{StaticResource SettingsNavBtn}"
                        Click="BtnNavProtocol_Click"/>

                <Rectangle Height="1" Fill="#C8CDD2" Margin="8,10"/>

                <!-- Per instal·lació -->
                <TextBlock Text="PER INSTAL·LACIÓ" FontSize="8" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Margin="12,0,0,4"/>
                <Button x:Name="BtnNavSaneamiento"   Click="BtnNavSaneamiento_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="💧  Saneament"/>
                <Button x:Name="BtnNavFontaneria"    Click="BtnNavFontaneria_Click"
                        Style="{StaticResource SettingsNavBtn}" Content="🔧  Fontaneria"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             ÀREA DE CONTINGUT
        ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Margin="6,12,12,12">
            <StackPanel>

                <!-- ─── IDIOMA ─── -->
                <Border x:Name="SecIdioma" Style="{StaticResource NeuCard}">
                    <StackPanel>
                        <TextBlock Text="Idioma" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                        <!-- Idioma interfície -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Idioma de la interfície" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Llengua dels botons, etiquetes i missatges del plugin"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CbxIdiomaPlugin" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Català" IsSelected="True"/>
                                <ComboBoxItem Content="Español"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <!-- Idioma reportes -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Idioma dels reportes exportats" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Capçaleres i etiquetes als fitxers CSV exportats"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CbxIdiomaReporte" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Igual que interfície" IsSelected="True"/>
                                <ComboBoxItem Content="Català"/>
                                <ComboBoxItem Content="Español"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <!-- Noms tècnics -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mantenir noms tècnics de Revit sense traduir" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Ex: OST_PipeCurves en comptes de 'Canonades'"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkNombresTecnicos" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── UNITATS ─── -->
                <Border x:Name="SecUnidades" Style="{StaticResource NeuCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Unitats i format de sortida" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Longitud" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxUnidadLongitud" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Metres (m)" IsSelected="True"/>
                                <ComboBoxItem Content="Centímetres (cm)"/>
                                <ComboBoxItem Content="Mil·límetres (mm)"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Decimals als resultats" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDecimales" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="2" Width="60"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diàmetre" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxUnidadDiametro" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Mil·límetres (mm)" IsSelected="True"/>
                                <ComboBoxItem Content="Polzades (&quot;&quot;)"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Format de pendent" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxFormatoPendiente" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Percentatge (%)" IsSelected="True"/>
                                <ComboBoxItem Content="Per mil (‰)"/>
                                <ComboBoxItem Content="Decimal (0.02)"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Capçalera als CSV exportats" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Inclou nom de projecte, data i versió del plugin"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCabeceraExportacion" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── CONFIRMACIONS ─── -->
                <Border x:Name="SecConfirmaciones" Style="{StaticResource NeuCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Confirmacions" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Confirmar abans d'eliminar elements" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Demana confirmació abans de qualsevol operació d'eliminació"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkConfirmarEliminar" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Confirmar còpies massives de vistes" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Demana confirmació quan la còpia afecta més vistes que el llindar"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkConfirmarVistas" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Confirmar còpies entre plantes" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Demana confirmació abans d'operacions de còpia multi-planta"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkConfirmarCopia" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Llindar d'elements per demanar confirmació" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Nombre d'elements a partir del qual es demana confirmació"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtUmbralConfirmacion" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="200" Width="70"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mode verbose" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Mostra missatges detallats de cada operació executada"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkVerbose" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="False"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── NOMENCLATURA ─── -->
                <Border x:Name="SecNomenclatura" Style="{StaticResource NeuCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Nomenclatura del model" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource BadgeWarn}" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <TextBlock Text="⚠️  La nomenclatura incorrecta pot fer fallar operacions de còpia i esquema"
                                       FontSize="11" Foreground="#92400E"/>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Format de planta" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Patró obligatori per al nom dels nivells de Revit"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                <Border Style="{StaticResource BadgeOk}" HorizontalAlignment="Left">
                                    <TextBlock Text="Correcte: P01.A · P02.B1 · P03.B2"
                                               FontSize="10" Foreground="#166534"/>
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="CbxFormatoPlanta" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="P##.EDIF" IsSelected="True"/>
                                <ComboBoxItem Content="P##"/>
                                <ComboBoxItem Content="Planta ##"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Format de soterrani" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxFormatoSotano" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="S##.EDIF" IsSelected="True"/>
                                <ComboBoxItem Content="S##"/>
                                <ComboBoxItem Content="Soterrani ##"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Separador d'edifici" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxSeparadorEdificio" Grid.Column="1"
                                      Style="{StaticResource NeuComboBox}" VerticalAlignment="Center">
                                <ComboBoxItem Content="Punt ( . )" IsSelected="True"/>
                                <ComboBoxItem Content="Guió baix ( _ )"/>
                                <ComboBoxItem Content="Guió ( - )"/>
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Identificadors d'edifici" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Separats per coma. Ex: A, B1, B2"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtIdsEdificio" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="A, B1, B2" Width="120"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Prefix de famílies E3G" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="El nom de família ha de coincidir exactament (majúscules incloses)"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtPrefijoE3G" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="MC_E3G_" Width="120"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Avisar si la família no segueix el prefix E3G" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Mostra un avís quan es detecten famílies fora de la convenció"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAvisarFamilias" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
				<!-- ─── CLASSIFICACIÓ DE SISTEMES ─── -->
				<Border x:Name="SecClassificacio" Style="{StaticResource NeuCard}" Visibility="Collapsed">
					<StackPanel>

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="Classificació de sistemes de canonada"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
								<TextBlock Text="Indica a quina categoria funcional pertany cada PipingSystemType del projecte."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
							</StackPanel>
							<Border Grid.Column="1"
                                    Background="#F1F5F9"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    VerticalAlignment="Top">
								<TextBlock x:Name="LblContadorClassificacio"
                                           Text="0 de 0 classificats"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"/>
							</Border>
						</Grid>

						<Rectangle Height="1" Fill="#E8ECF0" Margin="0,12,0,12"/>

						<Border x:Name="PnlClassifAviso"
                                Background="#FEF3C7"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="⚠"
                                           FontSize="14"
                                           Foreground="#92400E"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
								<TextBlock x:Name="LblClassifAviso"
                                           FontSize="12"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Text="Obre un projecte de Revit per editar la classificació de sistemes."/>
							</StackPanel>
						</Border>

						<DataGrid x:Name="DgClassificacioSistemes"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8ECF0"
                                  Background="{StaticResource BgCard}"
                                  RowBackground="{StaticResource BgCard}"
                                  AlternatingRowBackground="#FAFBFD"
                                  BorderThickness="1"
                                  BorderBrush="#E8ECF0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeight="36"
                                  ColumnHeaderHeight="32"
                                  FontSize="12"
                                  Foreground="{StaticResource TextPrimary}"
                                  MinHeight="200"
                                  MaxHeight="500">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Sistema (PipingSystemType)"
                                                    Binding="{Binding NombreTipo}"
                                                    Width="*"
                                                    IsReadOnly="True"/>
								<DataGridTextColumn Header="Classificació Revit"
                                                    Binding="{Binding NombreClasificacionRevit}"
                                                    Width="160"
                                                    IsReadOnly="True"/>
								<DataGridComboBoxColumn Header="Categoria E3G"
                                                        SelectedValueBinding="{Binding CategoriaActual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="240"/>
							</DataGrid.Columns>
						</DataGrid>

						<Grid Margin="0,12,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
                                       Text="Els canvis es desen en aquest projecte (.rvt)."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
							<Button Grid.Column="1"
                                    x:Name="BtnRecalcularSugerencias"
                                    Content="Recalcular suggeriments"
                                    Style="{StaticResource SettingsNavBtn}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Click="BtnRecalcularSugerencias_Click"/>
						</Grid>

					</StackPanel>
				</Border>
				
				<!-- ─── PARTIDES BC3 ─── -->
				<Border x:Name="SecPartides" Style="{StaticResource NeuCard}" Visibility="Collapsed">
					<StackPanel>
						<TextBlock Text="Partides i exportació BC3"
								   FontSize="15" FontWeight="SemiBold"
								   Foreground="{StaticResource TextPrimary}"/>
						<TextBlock Text="Defineix N regles per categoria. Cada regla enllaça un grup d'elements amb una partida del catàleg i un criteri de mesurament."
								   FontSize="11"
								   Foreground="{StaticResource TextSecondary}"
								   TextWrapping="Wrap"
								   Margin="0,2,0,0"/>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,12,0,12"/>

                        <!-- ─── CARD 1 — Catàlegs (multi-catàleg) ─────────────────── -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Catàlegs carregats"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Importa BC3 (BEDEC, Precio Centro, plantilla del estudi…). Pots tenir varis alhora — el primari (★) surt primer en les cerques."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                    x:Name="BtnImportarBc3"
                    Content="+ Importar BC3…"
                    Padding="10,5" FontSize="11"
                    VerticalAlignment="Top"
                    Click="BtnImportarBc3_Click"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding CatalogosUi}"
                      Margin="0,8,0,0"
                      Visibility="{Binding HayCatalogos, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="#E8ECF0" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="·"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EsPrimario}" Value="True">
                                                                        <Setter Property="Text" Value="★"/>
                                                                        <Setter Property="Foreground" Value="#1D9E75"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Detalle}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Marcar primari" Padding="8,4" FontSize="10" Margin="0,0,4,0"
                                        Click="BtnMarcarPrimario_Click" Tag="{Binding Id}"/>
                                                        <Button Content="✕" Padding="6,4" FontSize="11" Foreground="#B91C1C"
                                        Background="Transparent" BorderThickness="0"
                                        Click="BtnEliminarCatalogo_Click" Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ─── CARD 2 — Regles de mesurament ─────────────────────── -->
                        <TextBlock Text="Regles de mesurament" FontSize="13" FontWeight="SemiBold"
           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding GruposReglas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="True" Margin="0,0,0,6" Header="{Binding NombreCategoria}">
                                        <StackPanel>
                                            <DataGrid ItemsSource="{Binding Reglas}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" RowHeight="32" FontSize="11" Margin="0,4,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nom" Binding="{Binding Nombre}" Width="200"/>
                                                    <DataGridTextColumn Header="Sub-filtre" Binding="{Binding SubFiltro.Descripcion}" Width="140"/>
                                                    <DataGridTextColumn Header="Criteri" Binding="{Binding Criterio.Descripcion}" Width="110"/>
                                                    <DataGridTextColumn Header="Partida" Binding="{Binding PartidaCodigo}" Width="*"/>
                                                    <DataGridTemplateColumn Header="" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="✎" Width="22" Height="22" Margin="2,0"
                                                    Click="BtnEditarRegla_Click" Tag="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"/>
                                                                    <Button Content="✕" Width="22" Height="22" Margin="2,0"
                                                    Foreground="#B91C1C"
                                                    Click="BtnEliminarRegla_Click" Tag="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="+ Afegir regla a aquesta categoria"
                            Margin="0,8,0,0" Padding="0,6" FontSize="11"
                            Click="BtnAnadirRegla_Click" Tag="{Binding Categoria}"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ─── CARD 3 — Pie ───────────────────────────────────────── -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                            <Button Content="Aplicar regles suggerides per Sanejament"
            Padding="12,6" FontSize="11" HorizontalAlignment="Right"
            Click="BtnAplicarSugeridas_Click"/>
                        </Border>
                    </StackPanel>
				</Border>
				
                <!-- ─── SANEAMENT ─── -->
                <Border x:Name="SecSaneamiento" Style="{StaticResource NeuCard}" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Capçalera amb accent de color -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" CornerRadius="2" Background="#4a7a96" Margin="0,0,10,0"/>
                            <TextBlock Text="Saneament HS5" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Bajants -->
                        <TextBlock Text="BAJANTS" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mesurar bajants residuals" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBox x:Name="TxtSistemaBr" Style="{StaticResource NeuTextBox}"
                                         Text="Bajante residual" Width="160" HorizontalAlignment="Left"
                                         Margin="0,4,0,0" ToolTip="Nom exacte del sistema MEP a Revit"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMedirBr" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mesurar bajants pluvials" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBox x:Name="TxtSistemaBp" Style="{StaticResource NeuTextBox}"
                                         Text="Bajante pluvial" Width="160" HorizontalAlignment="Left"
                                         Margin="0,4,0,0" ToolTip="Nom exacte del sistema MEP a Revit"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMedirBp" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Agrupar bajants per planta" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkSanAgruparNivel" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Col·lectors -->
                        <TextBlock Text="COL·LECTORS" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>


                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mesurar col·lectors residuals" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBox x:Name="TxtSistemaColRes" Style="{StaticResource NeuTextBox}"
                                         Text="Colector residual" Width="160" HorizontalAlignment="Left"
                                         Margin="0,4,0,0" ToolTip="Nom exacte del sistema MEP a Revit"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMedirColRes" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mesurar col·lectors pluvials" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBox x:Name="TxtSistemaColPlu" Style="{StaticResource NeuTextBox}"
                                         Text="Colector pluvial" Width="160" HorizontalAlignment="Left"
                                         Margin="0,4,0,0" ToolTip="Nom exacte del sistema MEP a Revit"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkMedirColPlu" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Pendent mínima de col·lectors (%)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Valor CTE HS5 per defecte: 2%"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtPendienteMinima" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="2.0" Width="70"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Validar pendent al escanejar" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkSanValidarPendiente" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Agrupar col·lectors per diàmetre" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkSanAgruparDiametro" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Categories -->
                        <TextBlock Text="CATEGORIES ANALITZADES" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Canonades de sanejament" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="OST_PipeCurves" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSanCatTuberias" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Unions de sanejament" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="OST_PipeFitting" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSanCatUniones" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Arquetes i registres" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="OST_PlumbingFixtures" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSanCatArquetas" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── FONTANERIA ─── -->
                <Border x:Name="SecFontaneria" Style="{StaticResource NeuCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" CornerRadius="2" Background="#1D9E75" Margin="0,0,10,0"/>
                            <TextBlock Text="Fontaneria" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sistemes -->
                        <TextBlock Text="SISTEMES A MESURAR" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"  Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Aigua Freda Sanitària (AFS)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkMedirAfs" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Aigua Calenta Sanitària (ACS)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkMedirAcs" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Aigüa de Retorn (AR)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkMedirAr" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Paràmetres Revit -->
                        <TextBlock Text="PARÀMETRES REVIT" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"  Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Paràmetre de longitud" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Nom exacte del paràmetre a Revit"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtParamLongitudFont" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="Longitud" Width="140"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Paràmetre de sistema" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Identifica AFS / ACS / AR per a cada tram"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtParamSistemaFont" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="Nombre del sistema" Width="140"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Paràmetre de diàmetre" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtParamDiametroFont" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="Diámetro" Width="140"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Paràmetre de material" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtParamMaterial" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="Material" Width="140"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Famílies -->
                        <TextBlock Text="FAMÍLIES E3G" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"  Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Família AFS" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Nom exacte (majúscules incloses)"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtFamiliaAfs" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="MC_E3G_PEX" Width="160"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Família ACS" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Nom exacte (majúscules incloses)"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtFamiliaAcs" Grid.Column="1"
                                     Style="{StaticResource NeuTextBox}" Text="MC_E3G_PPR_FIBER BLUE" Width="160"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Opcions -->
                        <TextBlock Text="OPCIONS DE MESURA" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"  Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Agrupar per diàmetre" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkFontAgruparDiametro" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Incloure muntants" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkFontMontantes" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Incloure accessoris" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkFontAccesorios" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Agrupar per planta" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkFontAgruparNivel" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="False"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filtrar a vista activa" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkFontFiltrarVista" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="False"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#E8ECF0" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Avisar si la categoria no és OST_PipeCurves" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Detecta elements de fontaneria fora de la categoria estàndard"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkFontAvisarCategoria" Grid.Column="1"
                                      Style="{StaticResource ToggleStyle}" IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="SecProtocol" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Protocol de classificació — Sanejament"
                   FontWeight="SemiBold" FontSize="14"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,4"/>
                        <TextBlock Text="Defineix regles per identificar automàticament el tipus de cada element del model. Les regles funcionen com els filtres natius de Revit."
                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Diagnòstic live -->
                        <Border x:Name="PnlDiagnostic" Background="#F0FDF4" BorderBrush="#86EFAC"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtDiagnostic" FontSize="11"
                       Foreground="#166534" TextWrapping="Wrap"
                       Text="Obre un projecte de Revit per veure el diagnòstic."/>
                        </Border>

                        <!-- Botons acció -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="↺ Auto-detectar" Padding="10,6" FontSize="11"
                    Margin="0,0,8,0" Click="BtnAutoDetectar_Click"/>
                            <Button Content="💾 Desar protocol" Padding="10,6" FontSize="11"
                    Margin="0,0,8,0" Click="BtnDesarProtocol_Click"/>
                            <Button Content="📤 Exportar .e3gprot" Padding="10,6" FontSize="11"
                    Margin="0,0,8,0" Click="BtnExportarProtocol_Click"/>
                            <Button Content="📥 Importar .e3gprot" Padding="10,6" FontSize="11"
                    Click="BtnImportarProtocol_Click"/>
                        </StackPanel>

                        <!-- Les 5 seccions de regles -->
                        <local:ProtocolSeccioControl x:Name="CtrlVivendes"   Titol="Interior vivendes" />
                        <local:ProtocolSeccioControl x:Name="CtrlAparcament" Titol="Aparcament" />
                        <local:ProtocolSeccioControl x:Name="CtrlBajants"    Titol="Bajants" />
                        <local:ProtocolSeccioControl x:Name="CtrlColectors"  Titol="Col·lectors P00-P01" />
                        <local:ProtocolSeccioControl x:Name="CtrlEdificis"   Titol="Edificis" />

                        <!-- Paràmetres geomètrics globals -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Criteris geomètrics globals"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Longitud mínima bajant (m)"
                                   FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtBajantLongMin" Text="1.0" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tolerància elevació (m)"
                                   FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtToleranciaElev" Text="0.5" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>