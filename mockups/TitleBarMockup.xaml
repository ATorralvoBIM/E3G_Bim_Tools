<!--
    ============================================================
    MOCKUP v3 — Barra de titulo personalizada (Fluent Light)
    Todas las mejoras de diseno aplicadas.
    ============================================================
    AUTOCONTENIDO: sin x:Class, sin code-behind, todo inline.
    Render: powershell.exe -File .\mockups\Show-TitleBarMockup.ps1

    Mejoras v3:
      (1) Estado de conexion Revit (dot + texto) en la barra.
      (2) Separador vertical fino antes de los botones caption.
      (3) Esquinas de ventana redondeadas (AllowsTransparency).
      (4) Chip de modulo movido a breadcrumb en el cuerpo.
      (5) Sombra sutil bajo la barra de titulo.
      (6) Badge de marca -> "MEP".
      + Linea de acento de marca 1px que se desvanece.

    NOTA produccion: (3) esquinas + transparencia y (5) sombra hay
    que verificarlos con la ventana abierta como Revit-owned (hWnd
    de Revit) antes de darlos por buenos.
    ============================================================
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="e3gbimtools - Revit BC3 (mockup)"
    Width="980" Height="620"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="CanResize"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    FontFamily="file:///C:/Dev/E3GBIMTools/assets/ui-kit/fonts/Inter/extras/ttf/#Inter">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="8"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ===== Paleta Fluent Light (inline) ===== -->
        <SolidColorBrush x:Key="Bg.Body"      Color="#EFEDEA" />
        <SolidColorBrush x:Key="Bg.TitleBar"  Color="#DFDCD7" />
        <SolidColorBrush x:Key="Bg.Surface"   Color="#E6E3DF" />
        <SolidColorBrush x:Key="Border"       Color="#CDC9C4" />
        <SolidColorBrush x:Key="Text"         Color="#201F1E" />
        <SolidColorBrush x:Key="TextMuted"    Color="#605E5C" />
        <SolidColorBrush x:Key="TextSoft"     Color="#A19F9D" />
        <SolidColorBrush x:Key="Primary"      Color="#0F6CBD" />
        <SolidColorBrush x:Key="Accent"       Color="#2B88D8" />
        <SolidColorBrush x:Key="Secondary"    Color="#107C41" />
        <SolidColorBrush x:Key="Brand.Tint"   Color="#E6F1FB" />
        <SolidColorBrush x:Key="Close.Hover"  Color="#D13438" />
        <SolidColorBrush x:Key="Module.Chip"  Color="#0F6CBD" />
        <SolidColorBrush x:Key="Module.ChipBg" Color="#E6F1FB" />
        <SolidColorBrush x:Key="Bg.Card"      Color="#F6F4F1" />
        <SolidColorBrush x:Key="Bg.Header"    Color="#E6E3DF" />

        <!-- Tonos de estado (hover / pressed) dentro de la gama -->
        <SolidColorBrush x:Key="Primary.Hover"   Color="#0E5FA6" />
        <SolidColorBrush x:Key="Primary.Pressed" Color="#0B5394" />
        <SolidColorBrush x:Key="Tint.Hover"      Color="#D2E4F7" />
        <SolidColorBrush x:Key="Tint.Pressed"    Color="#BFD8F2" />
        <SolidColorBrush x:Key="Ghost.Hover"     Color="#E0DCD6" />
        <SolidColorBrush x:Key="Ghost.Pressed"   Color="#D2CDC6" />

        <!-- Acento sutil: 1px que se desvanece en los bordes -->
        <LinearGradientBrush x:Key="Brand.Band" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#000F6CBD" Offset="0" />
            <GradientStop Color="#3D0F6CBD" Offset="0.5" />
            <GradientStop Color="#002B88D8" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.Tint}" />
                                <Setter Property="Foreground" Value="{StaticResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Close.Hover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LucideGlyph" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- (6) Anillo de foco azul sutil -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                CornerRadius="7" Margin="-2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Botones de toolbar planos con estados (hover / pressed)
             ============================================================ -->
        <!-- Primario relleno azul -->
        <Style x:Key="TbPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="13,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tinte azul (accion secundaria destacada, no compite con el primario) -->
        <Style x:Key="TbTint" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brand.Tint}" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="13,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tint.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tint.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost gris (acciones neutras) -->
        <Style x:Key="TbGhost" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="13,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ghost.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ghost.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Margen exterior para que se vea la sombra; esquinas redondeadas -->
    <Border CornerRadius="10" Background="{StaticResource Bg.Body}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.20" />
        </Border.Effect>

        <DockPanel LastChildFill="True">

            <!-- ===================== BARRA DE TITULO ===================== -->
            <Border DockPanel.Dock="Top"
                    Height="44"
                    CornerRadius="9,9,0,0"
                    Background="{StaticResource Bg.TitleBar}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1.5" Opacity="0.06" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo MEP + titulo + estado de conexion -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="30" Height="28" CornerRadius="8"
                                Background="{StaticResource Primary}"
                                VerticalAlignment="Center">
                            <TextBlock Text="MEP" Foreground="White"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"
                                   Text="e3gbimtools" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSoft}"
                                   Text="&#8212;  Revit &#8594; BC3" />

                        <!-- (1) Estado de conexion -->
                        <Border Width="1" Height="18" Background="{StaticResource Border}" Margin="14,0" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Primary}" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="Revit conectado" />
                    </StackPanel>

                    <!-- ===== Separador (2) + botones min / restaurar / cerrar ===== -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">

                        <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="4,0,8,0" />

                        <Button Style="{StaticResource CaptionButton}" ToolTip="Minimizar">
                            <Viewbox Width="15" Height="15">
                                <Path Style="{StaticResource LucideGlyph}" Data="M5,12 H19" />
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource CaptionButton}" ToolTip="Restaurar / Maximizar">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource LucideGlyph}"
                                          Data="M8,8 H18 A2,2 0 0 1 20,10 V20 A2,2 0 0 1 18,22 H8 A2,2 0 0 1 6,20 V10 A2,2 0 0 1 8,8 Z" />
                                    <Path Style="{StaticResource LucideGlyph}"
                                          Data="M4,16 A2,2 0 0 1 2,14 V4 A2,2 0 0 1 4,2 H14 A2,2 0 0 1 16,4" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource CaptionButton.Close}" ToolTip="Cerrar">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource LucideGlyph}" Data="M18,6 L6,18" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M6,6 L18,18" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Linea de acento de marca 1px (sutil) -->
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brand.Band}" />

            <!-- (4) Breadcrumb de modulo en el cuerpo -->
            <Border DockPanel.Dock="Top" Padding="16,10"
                    Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Inicio" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    <TextBlock Text="&#8250;" FontSize="13" Margin="8,0" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    <Border CornerRadius="6" Padding="9,3"
                            Background="{StaticResource Module.ChipBg}"
                            VerticalAlignment="Center">
                        <TextBlock Text="Mediciones BC3"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Module.Chip}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===================== CUERPO representativo (tono completo) ===================== -->
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource Bg.Header}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,1"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <!-- Grupo entrada -->
                    <Button Style="{StaticResource TbPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource LucideGlyph}" Data="M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M14,2 V8 H20" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M12,18 V12" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M9,15 H15" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Importar BC3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TbGhost}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource LucideGlyph}" Data="M6,2 H18 A2,2 0 0 1 20,4 V20 A2,2 0 0 1 18,22 H6 A2,2 0 0 1 4,20 V4 A2,2 0 0 1 6,2 Z" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M8,6 H16" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M8,14 H10 M14,14 H16 M8,18 H10" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Calcular" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TbGhost}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource LucideGlyph}" Data="M19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H16 L21,8 V19 A2,2 0 0 1 19,21 Z" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M17,21 V13 H7 V21" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M7,3 V8 H15" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Guardar mapeo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- (4) Separador de grupo -->
                    <Border Width="1" Height="22" Background="{StaticResource Border}" Margin="6,0,12,0" VerticalAlignment="Center" />

                    <!-- Grupo salida -->
                    <Button Style="{StaticResource TbTint}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource LucideGlyph}" Data="M21,15 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V15" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M17,8 L12,3 L7,8" />
                                    <Path Style="{StaticResource LucideGlyph}" Data="M12,3 V15" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Exportar BC3" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource Bg.Header}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0"
                    Height="26">
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Primary}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,16,0" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Text="Revit API conectado" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Text="Sin BC3 cargado" />
                </StackPanel>
            </Border>

            <!-- Workspace: panel lateral + area central -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Panel lateral -->
                <Border Grid.Column="0"
                        Background="{StaticResource Bg.Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Header}"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                            <TextBlock Text="BC3 importado" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        </Border>
                        <StackPanel Margin="14,12">
                            <TextBlock Text="Capitulo 01 - Movimiento de tierras" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <TextBlock Text="Capitulo 02 - Cimentaciones" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <TextBlock Text="Capitulo 03 - Estructura" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <TextBlock Text="Capitulo 04 - Instalaciones" FontSize="12" Foreground="{StaticResource Text}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Area central: card con cabecera de tabla -->
                <Grid Grid.Column="1" Background="{StaticResource Bg.Body}">
                    <Border Margin="16"
                            Background="{StaticResource Bg.Card}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Header}"
                                    CornerRadius="7,7,0,0"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CODIGO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" />
                                    <TextBlock Grid.Column="1" Text="DESCRIPCION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" />
                                    <TextBlock Grid.Column="2" Text="TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <StackPanel>
                                <Border Padding="14,9" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="E04.01" FontSize="12" Foreground="{StaticResource Primary}" />
                                        <TextBlock Grid.Column="1" Text="Tuberia PVC DN110" FontSize="12" Foreground="{StaticResource Text}" />
                                        <TextBlock Grid.Column="2" Text="1.240,00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Padding="14,9" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="E04.02" FontSize="12" Foreground="{StaticResource Primary}" />
                                        <TextBlock Grid.Column="1" Text="Conducto climatizacion" FontSize="12" Foreground="{StaticResource Text}" />
                                        <TextBlock Grid.Column="2" Text="3.580,00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="E04.03" FontSize="12" Foreground="{StaticResource Primary}" />
                                        <TextBlock Grid.Column="1" Text="Bandeja portacables" FontSize="12" Foreground="{StaticResource Text}" />
                                        <TextBlock Grid.Column="2" Text="920,00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

        </DockPanel>
    </Border>
</Window>
