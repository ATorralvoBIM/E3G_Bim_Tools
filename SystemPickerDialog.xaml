<Window x:Class="E3G.Saneamiento.SystemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar sistema MEP"
        Height="500" Width="560"
        MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblHeader"
                   Text="Selecciona un sistema MEP"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="LblSubheader"
                   Text="" Foreground="Gray" Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" x:Name="TxtFilter"
                 Padding="6,4" Margin="0,0,0,8"
                 TextChanged="TxtFilter_TextChanged"
                 ToolTip="Filtrar por nombre o tipo de sistema"/>

        <ListBox Grid.Row="3" x:Name="LstSystems"
                 SelectionMode="Single"
                 MouseDoubleClick="LstSystems_MouseDoubleClick"
                 KeyDown="LstSystems_KeyDown"
                 BorderBrush="#CCCCCC">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="4,3">
                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding Sublabel}" Foreground="#555555" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" x:Name="LblCount"
                   Text="" Foreground="Gray" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="Aceptar"
                    Width="100" Height="28"
                    IsDefault="True" Click="BtnOk_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Content="Cancelar"
                    Width="100" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
